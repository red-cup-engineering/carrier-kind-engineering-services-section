{
  "name": "@red-cup-engineering/carrier-kind-engineering-services-section",
  "version": "0.1.4-dev.0",
  "description": "Admits a content carrier's frontmatter by the schema its artifact-role directory's kind names: the knowledge-organization science section's carrier-kind schemas, projected here and compiled with the term schema and the relation vocabulary.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/carrier-kind-engineering-services-section.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/carrier-kinds.mjs",
    "./carrier-path": "./src/carrier-path.mjs",
    "./carrier-kind-schemas": "./src/carrier-kind-schemas.mjs",
    "./note-repair": "./src/note-repair.mjs",
    "./note-masthead-date": "./src/note-masthead-date.mjs",
    "./note-frontmatter-preview": "./src/note-frontmatter-preview.mjs",
    "./carriers/note.schema.json": "./schemas/carriers/note.schema.json",
    "./carriers/research.schema.json": "./schemas/carriers/research.schema.json",
    "./carriers/research-article.schema.json": "./schemas/carriers/research-article.schema.json",
    "./carriers/research-paper.schema.json": "./schemas/carriers/research-paper.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "project-carrier-kind-schemas": "scripts/project-carrier-kind-schemas.mjs"
  },
  "files": [
    "src/",
    "scripts/",
    "schemas/"
  ],
  "scripts": {
    "check": "node --check src/*.mjs && node --check scripts/*.mjs",
    "project-science-schemas": "node scripts/project-carrier-kind-schemas.mjs ../../../../../../../../../../../science-services-section/services/information-science-services-section/services/knowledge-science-services-section/services/knowledge-organization-services-section/data/records/schema/carriers schemas/carriers",
    "generate-ontology": "project-json-schema-as-ontology ../../../../../../../../../science-services-section/services/information-science-services-section/services/knowledge-services-section/services/knowledge-organization-services-section/schemas/carriers https://561.group/ns/schema/ --out-dir ../../../../../../../../../science-services-section/services/information-science-services-section/services/knowledge-services-section/services/knowledge-organization-services-section/data/ontology/carriers --reference ../../../../../../../../../science-services-section/services/information-science-services-section/services/communication-science-services-section/services/glossary-science-services-section/services/term-science-services-section/schemas/glossary/terms/term.schema.json",
    "test:note-repair": "node --test test/note-repair-preservation.test.mjs test/note-frontmatter-preview.test.mjs test/note-masthead-date.test.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/computer-file-engineering-services-section": "^0.8.8",
    "@red-cup-engineering/json-schema-engineering-services-section": "^0.5.8",
    "@red-cup-engineering/markdown-engineering-services-section": "^0.5.9",
    "@red-cup-engineering/term-engineering-services-section": "^0.3.4"
  },
  "devDependencies": {
    "@red-cup-engineering/json-schema-to-owl-shacl-service": "^0.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "private": false,
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
}
