{
  "name": "@emsenn/meme-editor-environment-topology",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The meme-topology of the MTEE editor environment: buffers, commands, and keybindings as utterances.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node ../../scripts/package-boundary/copy-dmts-to-dts.mjs dist",
    "test": "pnpm run build",
    "audit:boundary": "node ../../scripts/package-boundary/audit-package-boundary.mjs .",
    "prepack": "pnpm run build"
  },
  "main": "./dist/src/index.mjs",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/meme-topology": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false
}
