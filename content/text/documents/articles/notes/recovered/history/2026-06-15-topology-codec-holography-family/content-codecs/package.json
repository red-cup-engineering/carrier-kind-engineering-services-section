{
  "name": "@561-group/content-codecs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Content demand codecs: geometric morphisms between external demand representations (Google Search Console) and this workspace's demand records.",
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node ../../scripts/package-boundary/copy-dmts-to-dts.mjs dist",
    "test": "pnpm run build && tsc -p tsconfig.test.json && node --test \".tmp/test-dist/**/*.test.mjs\"",
    "audit:boundary": "node ../../scripts/package-boundary/audit-package-boundary.mjs .",
    "verify": "pnpm run check && pnpm run test && pnpm run audit:boundary",
    "prepack": "pnpm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./search-console": {
      "types": "./dist/search-console.d.ts",
      "import": "./dist/search-console.mjs"
    },
    "./frontmatter": {
      "types": "./dist/frontmatter.d.ts",
      "import": "./dist/frontmatter.mjs"
    },
    "./ninjs": {
      "types": "./dist/ninjs.d.ts",
      "import": "./dist/ninjs.mjs"
    },
    "./vault": {
      "types": "./dist/vault.d.ts",
      "import": "./dist/vault.mjs"
    },
    "./references": {
      "types": "./dist/references.d.ts",
      "import": "./dist/references.mjs"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false
}
