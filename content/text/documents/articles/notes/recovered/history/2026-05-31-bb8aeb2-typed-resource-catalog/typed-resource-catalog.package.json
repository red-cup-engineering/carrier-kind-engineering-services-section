{
  "name": "@561/development.active.typed-resource-catalog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The codomain of voidmath: an on-disk Typed Resource Catalog. The directory tree IS the type language — a path is a typing judgment (library/X = object, bare X = morphism, hacking/X = a derivation gap admitted without proof). Every node derives from voidmath over the POSIX `path` carrier; descent down the taxonomy is restriction (narrow membership by a MUST predicate) and a node's affixed structure is extension (a markdown-document is a markdown file extended by frontmatter), with RFC-2119 modalities (MUST/SHOULD/MAY) realized as voidmath's necessitating/possibilising charges. Routing is conformance: a type's defining restrictions are its conformance contract.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emsenn/561-group.git",
    "directory": "development/active/typed-resource-catalog"
  },
  "scripts": {
    "scaffold": "node scripts/scaffolding.mjs",
    "claim": "node scripts/claiming.mjs",
    "project": "node scripts/projecting.mjs",
    "create": "node scripts/realizing.mjs",
    "audit": "node scripts/auditing.mjs",
    "test": "node tests/run-kernel-tests.mjs"
  },
  "exports": {
    "./scaffolding": "./scripts/scaffolding.mjs",
    "./claiming": "./scripts/claiming.mjs",
    "./projecting": "./scripts/projecting.mjs",
    "./realizing": "./scripts/realizing.mjs",
    "./auditing": "./scripts/auditing.mjs",
    "./*": "./*"
  },
  "imports": {
    "#_eavt": "@561/development.active.posix-holography/scripts/eavt.mjs",
    "#_statting": "@561/development.active.posix-holography/library/file/reading/statting/scripts/stat.mjs",
    "#_sniffing": "@561/development.active.posix-holography/library/file/restricting/library/regular-file/reading/sniffing/scripts/sniff.mjs",
    "#_reading": "@561/development.active.posix-holography/scripts/read-text.mjs",
    "#_writing": "@561/development.active.posix-holography/library/file/restricting/library/regular-file/restricting/library/flatfile/writing/scripts/write.mjs",
    "#articulate": "@561/development.active.math-kernel/scripts/articulate.mjs",
    "#predicate": "@561/development.active.math-kernel/scripts/predicate.mjs",
    "#posit": "@561/development.active.math-kernel/scripts/posit.mjs",
    "#settle": "@561/development.active.math-kernel/scripts/settle.mjs",
    "#_joining": "@561/development.active.math-kernel/scripts/join-knowledge.mjs",
    "#trace": "./scripts/trace.mjs",
    "#locating": "./scripts/locating.mjs",
    "#unfold": "./library/path/library/object/library/attribute/library/file/restricting/library/regular-file/restricting/library/flatfile/restricting/library/json/restricting/library/schema/reading/scripts/unfold.mjs",
    "#cohering": "./scripts/cohering.mjs",
    "#realizing": "./scripts/realizing.mjs",
    "#auditing": "./scripts/auditing.mjs",
    "#claiming": "./scripts/claiming.mjs",
    "#projecting": "./scripts/projecting.mjs",
    "#scaffolding": "./scripts/scaffolding.mjs",
    "#*": "./*"
  },
  "dependencies": {
    "@561/development.active.math-kernel": "workspace:*",
    "@561/development.active.posix-holography": "workspace:*",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1"
  }
}
