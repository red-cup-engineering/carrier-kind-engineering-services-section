{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typed-resource-catalog.active.development.561.group/library/path/library/object/library/attribute/library/file/restricting/library/regular-file/restricting/library/flatfile/restricting/library/markdown/extending/library/markdown-document/restricting/library/development-journal-entry/development-journal-entry.schema.json",
  "x-trc-placement": "{thing}/docs/dev/journal/",
  "x-trc-filename-template": "{date}[-{slug}].md",
  "title": "Development Journal Entry",
  "additionalProperties": true,
  "x-trc-body-skeleton": "# {title}\n",
  "description": "A date-stamped markdown-document at {thing}/docs/dev/journal/<YYYY-MM-DD>[-slug].md carrying historical narrative about the parent thing on the named date.",
  "required": [
    "name",
    "description"
  ],
  "type": "object",
  "x-trc-type": "development-journal-entry",
  "x-trc-filename": "^\\d{4}-\\d{2}-\\d{2}(-[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)?\\.md$",
  "properties": {
    "superseded-by": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "session-of": {
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "maxLength": 300,
      "type": "string"
    },
    "entry-date": {
      "type": "string",
      "format": "date"
    }
  }
}
