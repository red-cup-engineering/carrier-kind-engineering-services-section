{
  "name": "@red-cup-engineering/signstuff-evm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SignStuff carried by the EVM: FOUR, evidence with witness commitments, cells addressed byte-for-byte like SignCell, and a settlement ledger that holds contradictions.",
  "files": [
    "src",
    "scripts",
    "foundry.toml",
    "DESIGN.md",
    "ROADMAP.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./cell-address": "./scripts/lib/cell-address.mjs",
    "./witness-set": "./scripts/lib/witness-set.mjs"
  },
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "vectors": "node scripts/emit-golden-vectors.mjs",
    "vectors:check": "node scripts/emit-golden-vectors.mjs --check",
    "vectors:lean": "node scripts/sync-lean-vectors.mjs",
    "vectors:lean:check": "node scripts/sync-lean-vectors.mjs --check"
  },
  "dependencies": {
    "@red-cup-engineering/signcell": "workspace:*",
    "@red-cup-engineering/signchain": "workspace:*",
    "@red-cup-engineering/computer-data-engineering-services-section": "workspace:*",
    "@red-cup-engineering/computer-content-address-engineering-services-section": "workspace:*"
  },
  "devDependencies": {
    "@foundry-rs/forge": "1.7.1",
    "@openzeppelin/contracts": "5.6.1",
    "forge-std": "github:foundry-rs/forge-std#v1.10.0"
  },
  "license": "UNLICENSED"
}
