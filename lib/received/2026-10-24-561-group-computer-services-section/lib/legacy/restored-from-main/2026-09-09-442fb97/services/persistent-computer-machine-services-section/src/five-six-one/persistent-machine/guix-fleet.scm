(define-module (five-six-one persistent-machine guix-fleet)
  #:use-module (srfi srfi-1) #:use-module (srfi srfi-9)
  #:use-module (five-six-one guix channel)
  #:export (component-reference? make-component-reference component-reference-kind component-reference-version component-reference-source
            capacity-observation? make-capacity-observation capacity-observation-host capacity-observation-observed-at capacity-observation-free-bytes
            closure-observation? make-closure-observation closure-observation-identity closure-observation-bytes
            host-declaration? make-host-declaration host-declaration-name host-declaration-realization host-declaration-system host-declaration-component host-declaration-state-root host-declaration-secret-reference host-declaration-capacity-reserve-bytes host-declaration-rollback-closure
            bare-cedar-fog-declaration cold-red-gate-declaration compile-host-declaration compile-fleet))
(define-record-type <component-reference> (make-component-reference kind version source) component-reference? (kind component-reference-kind) (version component-reference-version) (source component-reference-source))
(define-record-type <capacity-observation> (make-capacity-observation host observed-at free-bytes) capacity-observation? (host capacity-observation-host) (observed-at capacity-observation-observed-at) (free-bytes capacity-observation-free-bytes))
(define-record-type <closure-observation> (make-closure-observation identity bytes) closure-observation? (identity closure-observation-identity) (bytes closure-observation-bytes))
(define-record-type <host-declaration> (make-host-declaration name realization system component state-root secret-reference capacity-reserve-bytes rollback-closure) host-declaration? (name host-declaration-name) (realization host-declaration-realization) (system host-declaration-system) (component host-declaration-component) (state-root host-declaration-state-root) (secret-reference host-declaration-secret-reference) (capacity-reserve-bytes host-declaration-capacity-reserve-bytes) (rollback-closure host-declaration-rollback-closure))
(define %metroplat-component (make-component-reference 'metroplat.node-spec 1 "apps/metroplat/guix/metroplat.scm"))
(define bare-cedar-fog-declaration (make-host-declaration "bare-cedar-fog" 'foreign-distro-pack "x86_64-linux" %metroplat-component "/var/lib/561-group/metroplat" "bare-cedar-fog/metroplat-env" 0 #f))
(define cold-red-gate-declaration (make-host-declaration "cold-red-gate" 'foreign-distro-pack "x86_64-linux" %metroplat-component "/var/lib/561-group/metroplat" "cold-red-gate/metroplat-env" 1073741824 #f))
(define (non-empty-string? x) (and (string? x) (not (string-null? x))))
(define (valid-declaration? d) (and (host-declaration? d) (non-empty-string? (host-declaration-name d)) (memq (host-declaration-realization d) '(foreign-distro-pack guix-system)) (non-empty-string? (host-declaration-system d)) (component-reference? (host-declaration-component d)) (eq? (component-reference-kind (host-declaration-component d)) 'metroplat.node-spec) (= (component-reference-version (host-declaration-component d)) 1) (non-empty-string? (component-reference-source (host-declaration-component d))) (non-empty-string? (host-declaration-state-root d)) (non-empty-string? (host-declaration-secret-reference d)) (integer? (host-declaration-capacity-reserve-bytes d)) (>= (host-declaration-capacity-reserve-bytes d) 0)))
(define (valid-capacity? x d) (and (capacity-observation? x) (string=? (capacity-observation-host x) (host-declaration-name d)) (non-empty-string? (capacity-observation-observed-at x)) (integer? (capacity-observation-free-bytes x)) (>= (capacity-observation-free-bytes x) 0)))
(define (valid-closure? x) (and (closure-observation? x) (non-empty-string? (closure-observation-identity x)) (integer? (closure-observation-bytes x)) (>= (closure-observation-bytes x) 0)))
(define (compile-host-declaration d capacity closure)
  (unless (valid-declaration? d) (error "invalid host declaration" d))
  (when (and capacity (not (valid-capacity? capacity d))) (error "invalid capacity observation" capacity))
  (when (and closure (not (valid-closure? closure))) (error "invalid closure observation" closure))
  (let ((admission (cond ((not closure) 'awaiting-closure-measurement) ((not capacity) 'awaiting-capacity-observation) ((< (capacity-observation-free-bytes capacity) (+ (closure-observation-bytes closure) (host-declaration-capacity-reserve-bytes d))) 'refused-capacity) (else 'accepted))))
    `((kind . guix-closure-plan) (version . 1) (name . ,(host-declaration-name d)) (realization . ,(host-declaration-realization d)) (system . ,(host-declaration-system d)) (channel-file . ,pinned-guix-channel-file) (channel-commit . ,pinned-guix-channel-commit) (component . ((kind . ,(component-reference-kind (host-declaration-component d))) (version . ,(component-reference-version (host-declaration-component d))) (source . ,(component-reference-source (host-declaration-component d))))) (closure . ((builder . guix-pack) (format . tarball) (identity . ,(and closure (closure-observation-identity closure))) (closure-bytes . ,(and closure (closure-observation-bytes closure)))) (state-root . ,(host-declaration-state-root d)) (secret-reference . ,(host-declaration-secret-reference d)) (capacity-reserve-bytes . ,(host-declaration-capacity-reserve-bytes d)) (capacity-observation . ,(and capacity `((observed-at . ,(capacity-observation-observed-at capacity)) (free-bytes . ,(capacity-observation-free-bytes capacity))))) (admission . ,admission) (rollback-closure . ,(host-declaration-rollback-closure d)))))
(define (compile-fleet declarations capacities closures)
  (unless (and (list? declarations) (every host-declaration? declarations)) (error "fleet must be host declarations" declarations))
  (let ((names (map host-declaration-name declarations))) (unless (= (length names) (length (delete-duplicates names))) (error "fleet has ambiguous host names" names)))
  (map (lambda (d) (compile-host-declaration d (find (lambda (x) (and (capacity-observation? x) (string=? (capacity-observation-host x) (host-declaration-name d)))) capacities) (assoc-ref closures (host-declaration-name d)))) declarations))
