{
  "name": "@red-cup-engineering/bare-cedar-fog-561-group",
  "version": "0.1.1",
  "type": "module",
  "description": "Google OAuth-gated host status dashboard, plus an ActivityPub and x402 reverse proxy, for the bare-cedar-fog host.",
  "scripts": {
    "build-dependencies": "pnpm --filter '@red-cup-engineering/bare-cedar-fog-561-group^...' --if-present build",
    "preserve": "npm run build-dependencies",
    "serve": "node src/server.mts",
    "precheck": "npm run build-dependencies",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mts"
  },
  "dependencies": {
    "@red-cup-engineering/claude-session-activity-provider": "0.1.4",
    "@red-cup-engineering/codex-session-activity-provider": "0.1.3",
    "@red-cup-engineering/fare": "0.1.0",
    "@red-cup-engineering/http-server": "0.0.4",
    "@red-cup-engineering/judge-request-mutability-service": "0.1.0",
    "@red-cup-engineering/serve-google-oauth-service": "0.1.1",
    "@red-cup-engineering/systemd-unit-inventory-observation-service": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "exports": {
    "./src/collect-colony-activity.mjs": "./src/collect-colony-activity.mjs",
    "./collect-colony-activity": "./src/collect-colony-activity.mjs"
  }
}
