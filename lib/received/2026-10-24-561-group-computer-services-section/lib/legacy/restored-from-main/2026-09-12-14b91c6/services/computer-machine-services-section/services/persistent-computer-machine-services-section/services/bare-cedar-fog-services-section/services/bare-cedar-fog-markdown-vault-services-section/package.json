{
  "name": "@red-cup-engineering/bare-cedar-fog-markdown-vault-services-section",
  "version": "0.1.0",
  "type": "module",
  "description": "Proof-path and semantic-edge projection services for observing and searching the repository's Markdown vault regions without a persisted note index.",
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./src/index.mjs"
    }
  },
  "bin": {
    "observe-bare-cedar-fog-markdown-vaults": "./scripts/observe-bare-cedar-fog-markdown-vaults.mjs",
    "serve-bare-cedar-fog-markdown-vault-mcp": "./src/mcp-server.mjs",
    "search-bare-cedar-fog-markdown-vaults": "./scripts/search-bare-cedar-fog-markdown-vaults.mjs",
    "search-bare-cedar-fog-markdown-language-lightcone": "./scripts/search-bare-cedar-fog-markdown-language-lightcone.mjs"
  },
  "files": ["content", "scripts", "services", "src", "types", "README.md"],
  "scripts": {
    "check": "node --check src/*.mjs scripts/*.mjs services/*/src/*.mjs",
    "test": "node --test test/*.test.mjs services/*/test/*.test.mjs",
    "smoke:mcp": "node scripts/smoke-markdown-vault-mcp.mjs"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@red-cup-engineering/filepath-services-section": "0.1.0",
    "@red-cup-engineering/javascript-file-main-guard-service": "0.1.3",
    "@red-cup-engineering/read-markdown-file-service": "0.2.0",
    "@red-cup-engineering/read-markdown-frontmatter-service": "0.1.4",
    "@red-cup-engineering/read-markdown-structure-service": "0.1.0",
    "zod": "4.3.6"
  }
}
