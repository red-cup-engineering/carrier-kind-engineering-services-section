{
  "name": "@red-cup-engineering/topical-knowledge-cell-report-service",
  "version": "0.1.0",
  "description": "Sells idempotent source-grounded topical reports through A2A or direct ActivityPub/x402 while hiring NotebookLM separately.",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "bin",
    "content",
    "lib",
    "ops",
    "src"
  ],
  "exports": {
    ".": "./lib/report.mjs",
    "./law": "./lib/law.mjs",
    "./protocol": "./src/protocol.mjs"
  },
  "bin": {
    "serve-topical-knowledge-cell-report-a2a": "./bin/server.mjs"
  },
  "scripts": {
    "check": "node --check lib/law.mjs && node --check lib/report.mjs && node --check src/protocol.mjs && node --check src/runtime.mjs && node --check bin/execute-a2a-task.mjs && node --check bin/server.mjs && node --check test/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.4",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.0",
    "@red-cup-engineering/a2a-sovereign-operation-boundary-service": "1.0.0",
    "@red-cup-engineering/rmn-semantic-conformance": "6.0.0"
  },
  "x-agentic-metro-enterprise": {
    "node-id": "topical-knowledge-cell-report-service",
    "actor": "urn:ame:topical-knowledge-cell-report-service",
    "organizational-kind": "sovereign-source-grounded-report-micro-enterprise",
    "owners": [
      "software-development-services-section"
    ],
    "membrane": {
      "law": "lib/",
      "lasting-instances": "content/",
      "append-only-instances": "data/"
    },
    "admission": "one fresh signed cell manifest, exact report terms, one-use request-body-bound authority, and either internal A2A terms or an exact x402 quote with direct ActivityPub recipient",
    "refusal": "stale or authoritative manifest, changed discovery binding, widened authority, payment mismatch, ungrounded provider artifact, public delivery, replay collision, or unavailable contracted provider",
    "operation-catalog": {
      "generate-report-internal": {
        "contract": "ni:///sha-256;4cCS92-nkXaSUW80gI30WnXohq8YEZBAnMq00JH29us",
        "lawSource": "content/contracts/generate-topical-knowledge-cell-report.rml",
        "offer": "content/offers/source-grounded-report-wholesale.json",
        "protocol": "A2A 1.0 via hired provider",
        "input": "application/rmn+cbor",
        "output": "application/rmn+cbor"
      },
      "purchase-report-external": {
        "contract": "ni:///sha-256;4cCS92-nkXaSUW80gI30WnXohq8YEZBAnMq00JH29us",
        "lawSource": "content/contracts/generate-topical-knowledge-cell-report.rml",
        "offer": "content/offers/source-grounded-report-wholesale.json",
        "protocol": "x402 priced HTTP plus direct ActivityPub via hired providers",
        "input": "application/rmn+cbor",
        "output": "application/rmn+cbor"
      }
    }
  },
  "x-semiotic-voxel": {
    "profile": "org.harmonious-union.semiotic-voxel.v1",
    "owner": "red-cup-engineering",
    "kind": "actor",
    "actor": "urn:ame:topical-knowledge-cell-report-service",
    "operations": [
      "generate-report-internal",
      "purchase-report-external"
    ],
    "capabilities": [
      {
        "capability": "topical-knowledge-cell-report-service",
        "faces": [
          "generate-report-internal",
          "purchase-report-external"
        ]
      }
    ],
    "package": "@red-cup-engineering/topical-knowledge-cell-report-service"
  }
}
