{
  "name": "@red-cup-engineering/topical-knowledge-cell-corpus-service",
  "version": "0.1.0",
  "description": "Forms deterministic, disclosure-safe reconciliation intents for sovereign topical knowledge-cell corpora.",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "bin",
    "content",
    "lib",
    "ops",
    "src"
  ],
  "exports": {
    ".": "./lib/corpus.mjs",
    "./law": "./lib/law.mjs",
    "./protocol": "./src/protocol.mjs"
  },
  "bin": {
    "serve-topical-knowledge-cell-corpus-a2a": "./bin/server.mjs"
  },
  "scripts": {
    "check": "node --check lib/law.mjs && node --check lib/corpus.mjs && node --check src/protocol.mjs && node --check src/runtime.mjs && node --check src/owned-runtime.mjs && node --check bin/execute-a2a-task.mjs && node --check bin/server.mjs && node --check test/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@red-cup-engineering/a2a-agent-card-discovery-service": "1.0.0",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.4",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.0",
    "@red-cup-engineering/a2a-sovereign-operation-boundary-service": "1.0.0",
    "@red-cup-engineering/rmn-semantic-conformance": "6.0.0",
    "@lenticule-science/rwil-rdf-projection-service": "1.0.2"
  },
  "x-agentic-metro-enterprise": {
    "node-id": "topical-knowledge-cell-corpus-service",
    "actor": "urn:ame:topical-knowledge-cell-corpus-service",
    "organizational-kind": "sovereign-corpus-reconciliation-micro-enterprise",
    "owners": [
      "software-development-services-section"
    ],
    "membrane": {
      "law": "lib/",
      "lasting-instances": "content/",
      "append-only-instances": "data/"
    },
    "admission": "one exact customer-authored reconciliation request and one-use nondelegable capability bound to the cell and request identity",
    "refusal": "authority mismatch, central-view claim, disclosure violation, ambiguous source identity, unbound notebook observation, replay collision, or requested notebook effect",
    "operation-catalog": {
      "form-corpus-reconciliation-intent": {
        "contract": "ni:///sha-256;wLaU8RtzGHnz24QBFiVNUpEyp-3oqnzQ0c6KfJVJt6E",
        "lawSource": "content/contracts/form-corpus-reconciliation-intent.rml",
        "protocol": "A2A 1.0 through a separately hired protocol provider",
        "input": "application/rmn+cbor",
        "output": "application/rmn+cbor",
        "effects": [
          "append-provider-rwil-receipt"
        ]
      }
    }
  },
  "x-semiotic-voxel": {
    "profile": "org.harmonious-union.semiotic-voxel.v1",
    "owner": "red-cup-engineering",
    "kind": "actor",
    "actor": "urn:ame:topical-knowledge-cell-corpus-service",
    "operations": [
      "form-corpus-reconciliation-intent"
    ],
    "capabilities": [
      {
        "capability": "topical-knowledge-cell-corpus-service",
        "faces": [
          "form-corpus-reconciliation-intent"
        ]
      }
    ],
    "package": "@red-cup-engineering/topical-knowledge-cell-corpus-service"
  }
}
