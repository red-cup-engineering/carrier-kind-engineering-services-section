#lang rmn/v2
(map
  ("type" "CapabilityCellProfile")
  ("version" 1)
  ("cell"
    (map
      ("identity" "One sovereign settlement, actor, and chain-qualified smart account.")
      ("capability" "Exactly one effectful operation with one RMN law, input, output, refusal, and owned kernel.")
      ("body" "The cell's script, law and schemas, package, repository, wallet, web identity, public offer, and append-only receipts are facets of this same actor.")
      ("market" "The cell and every effectful provider it uses publish independently discoverable offers in the same capability market.")))
  ("composition"
    (map
      ("provider" "Every effectful dependency is another CapCell named by actor, account, operation, law, offer, Agent Card, and exact contract.")
      ("material" "An in-process dependency is admissible only as content-addressed inert material declaring no authority, effects, transport, custody, settlement, publication, or observation.")
      ("closure" "Every required capability has exactly one market-addressed provider binding; every provider binding answers exactly one declared requirement.")
      ("recursion" "A provider is not exempt: it must satisfy this same profile and be independently available in the same market.")))
  ("forbidden"
    (list
      "embedded public-protocol provider"
      "ambient service or registry"
      "unbound effectful package dependency"
      "one actor offering multiple effectful operations as one cell"
      "projection checklist treated as capability closure"
      "self-attestation treated as conformance"))
  ("completion" "Independent conformance must rederive body completeness, dependency closure, market availability, customer invocation, and receipt identities."))
