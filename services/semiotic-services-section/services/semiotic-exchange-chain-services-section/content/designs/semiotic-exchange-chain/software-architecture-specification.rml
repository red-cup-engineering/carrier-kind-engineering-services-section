#lang rmn/v2
(map
  ("type" "SemioticExchangeChainSoftwareArchitectureSpecification")
  ("version" 2)
  ("precondition" "The Change Control Board's approved protocol allocation (lib/emsenn/services/561-group/services/board-of-directors/services/executive-office/data/records/decision-records/protocol-allocation-for-the-orchestration-platform.json) stands: EAVT/Datom is the one source symbol and every other public standard is a channel code of it, never a second ontology. The settlement trace chain profile at ../../../../../../blockchain-services-section/content/profiles/eip155-5615610-settlement-trace-chain.rml is admitted at integration status. The Recursive FOUR/RMN Circuit Fabric architecture (../../../../../../software-development-services-section/content/designs/recursive-four-circuit-fabric/software-architecture-specification.rml) is the sibling architecture this one extends at the chain boundary and does not restate.")
  ("operation" "Extend the approved protocol allocation across the boundaries it left unallocated -- EVM settlement, capability delegation, metered payment, and agent-to-agent coordination -- so that the chain becomes the only durable home, every actuator becomes ephemeral, and the Semiotic Voxel is realizable only as an active arena that is never stored.")
  ("postcondition" "A module lead can design one boundary of the exchange chain against exactly one named public standard, with its durability, identity, authority, and payment laws already fixed, without inventing a second semantic center, without provisioning a permanent host, and without persisting a voxel.")
  ("refusal" "Refuse a durable local store presented as a home, a persisted or replayable Semiotic Voxel, a permanent actuator machine, an identifier law competing with the chain's own receipt identity, a boundary allocated two standards, a standard adopted as an ontology rather than a channel code, a production claim on an integration-only chain, and any operation of the chain by this specifying section.")
  ("identification" (map ("system" "Semiotic Exchange Chain") ("revision" "2") ("date" "2026-07-28") ("issuer" "Semiotic Exchange Chain Services Section") ("requirements" "content/designs/semiotic-exchange-chain/requirements-baseline.rml")))
  ("stakeholders"
    ((map ("class" "Leader and acquirer") ("concerns" ("agent drift stopped by a fixed spec" "on-chain data rather than local data" "ephemeral runners rather than permanent machines" "cost collapse")))
     (map ("class" "Sovereign settlements") ("concerns" ("own chain" "own proper-time clock" "interior sovereignty" "refusal" "custody")))
     (map ("class" "Ephemeral actuators and autonomous agents") ("concerns" ("no key custody" "bounded delegated authority" "cold start with no local state" "observable failure")))
     (map ("class" "Federation peers in the semioverse") ("concerns" ("resolvable actor identity" "standard ActivityStreams shapes" "no privileged writer into a peer's pools")))
     (map ("class" "Protocol and chain providers") ("concerns" ("standard conformance" "finality" "replay protection" "version pinning")))
     (map ("class" "Players in an arena") ("concerns" ("the voxel is live while played" "position is causally closed" "the path walked is rigid")))))
  ("viewpoints"
    ((map ("name" "source-symbol") ("concerns" ("meaning" "identity" "provenance" "supersession")) ("models" ("EAVT row" "Datom retract/assert journal" "RMN content address" "channel-code projection")))
     (map ("name" "durability-and-residence") ("concerns" ("what is a home" "what is a cache" "what may be lost")) ("models" ("chain-resident state" "RWIL witness anchor" "evictable local projection")))
     (map ("name" "voxel-liveness") ("concerns" ("active-only existence" "arena closure" "structural rigidity")) ("models" ("polarized prime event structure" "Lorentzian cone to the semantics/syntax cocone" "pebble game")))
     (map ("name" "membrane-and-authority") ("concerns" ("who may act" "at whose cost" "across which boundary")) ("models" ("UCAN delegation chain" "x402 price gradient" "ERC-4337 smart account and paymaster" "redox tally")))
     (map ("name" "federation-and-coordination") ("concerns" ("inter-enterprise messaging" "intra-enterprise dispatch" "agency face")) ("models" ("ActivityPub S2S" "WMAP C2S agency" "A2A agent card")))
     (map ("name" "verification") ("concerns" ("lawfulness" "conformance" "adversarial survival")) ("models" ("white gate" "black gate" "red gate" "blue gate")))))
  ("modules"
    ((map ("id" "SXC-M1") ("name" "Source symbol kernel") ("owner" "Model Services Section / RMN Semantic Conformance") ("responsibility" "Own the one source symbol: the EAVT row, its Datom journal form, and its RMN content address. Project every other named standard as a channel code of that source and refuse any standard offered as a competing ontology. Do not own residence, authority, or payment.") ("requirements" ("SXC-R001" "SXC-R002" "SXC-R003")))
     (map ("id" "SXC-M2") ("name" "Settlement chain seam") ("owner" "Blockchain Services Section") ("responsibility" "Provide the exchange chain's ordering, finality, replay protection, smart accounts, bundling, and paymaster policy against the admitted chain profile; carry the integration-to-production cutover from eip155:5615610 to the reserved eip155:561561 without either being presented as the other. Do not own meaning.") ("requirements" ("SXC-R004" "SXC-R005" "SXC-R006")))
     (map ("id" "SXC-M3") ("name" "RWIL chain anchoring") ("owner" "Knowledge Services Section with Blockchain Services Section") ("responsibility" "Make the Relation-Witness Information Log write through to the settlement chain, so that a witness is settled on-chain and every data/rwil directory becomes an evictable projection of chain state rather than the residence of that state. Own the fold/unfold between chain-anchored journal and local projection.") ("requirements" ("SXC-R007" "SXC-R008")))
     (map ("id" "SXC-M4") ("name" "Semiotic Voxel arena") ("owner" "Capability Services Section") ("responsibility" "Realize the arena as an active-only structure: the player-opponent board whose position is causally closed under each move, whose rigidity is discharged by the pebble game, and which exists only while played. Emit boundary transactions; never emit a stored voxel. Own no durable state of its own.") ("requirements" ("SXC-R009" "SXC-R010" "SXC-R011")))
     (map ("id" "SXC-M5") ("name" "WMAP agency face") ("owner" "Web Services Section / ActivityPub Services Section") ("responsibility" "Provide the Web Modeled Agency Protocol face -- ActivityPub S2S between sovereign enterprises and the WMAP client-to-server social API for agency -- carrying settlement-triggered publication out of the chain and admitting inbound activity only through the receiving enterprise's own admission. A sender never writes a peer's pools.") ("requirements" ("SXC-R012" "SXC-R013" "SXC-R014")))
     (map ("id" "SXC-M6") ("name" "Capability and payment membrane") ("owner" "Cryptographic Services Section with Resource Brokerage Service Section") ("responsibility" "Own the redox boundary: UCAN delegation chains as the mask an actuator wears, x402 as the price gradient on boundary crossing, and the pairing rule by which unmatched commitments become one settled tally. Refuse ambient authority and refuse custody held by an actuator.") ("requirements" ("SXC-R015" "SXC-R016" "SXC-R017")))
     (map ("id" "SXC-M7") ("name" "Ephemeral actuator fabric") ("owner" "GCloud Services Section") ("responsibility" "Run every actuator as a cold-start, stateless, disposable runner that holds no keys, no funds, and no local durable state, whose sole purpose is to agitate the chain and whose loss costs nothing but the in-flight call. Own the elimination of permanent hosts, pidfiles, local databases, and host-resident cron.") ("requirements" ("SXC-R018" "SXC-R019")))
     (map ("id" "SXC-M8") ("name" "A2A coordination face") ("owner" "Web Services Section / A2A Services Section") ("responsibility" "Provide the intra-enterprise agent-to-agent coordination face and its agent cards, pinned to a production-supported profile. Do not carry inter-enterprise messaging, which is SXC-M5's boundary.") ("requirements" ("SXC-R020")))))
  ("budgets"
    ((map ("name" "residence") ("allocation" "Chain-resident state is the only home; every local store is an evictable projection. Zero tolerated durable local state whose loss is unrecoverable from the chain."))
     (map ("name" "voxel-liveness") ("allocation" "Zero persisted voxels. An arena that can be restored from storage rather than replayed from its boundary transactions is a defect, not an optimization."))
     (map ("name" "actuator-custody") ("allocation" "Zero keys and zero funds held by any actuator; all authority is delegated per-invocation and all cost is borne by a paymaster under policy."))
     (map ("name" "identifier") ("allocation" "Exactly two identifier axes, never three: did:pkh for controllers and RMN content-addressing for content. One did:pkh address serves chain settlement, x402 payment, UCAN issuance, and federation actor simultaneously. Zero tolerated third shape -- a bare CAIP-10 string, a bespoke slug, or a content address used as a controller."))
     (map ("name" "boundary-allocation") ("allocation" "Exactly one public standard per boundary. Zero boundaries carrying two competing standards, and zero standards adopted as ontologies."))
     (map ("name" "verification") ("allocation" "Every module spends one independent result at each white, black, red, and blue gate; zero self-attestation."))))
  ("decisions"
    ((map ("decision" "Extend the approved protocol allocation rather than open a second one.") ("alternatives" ("a fresh allocation for the chain" "per-module boundary choices" "no allocation")) ("rationale" "The Change Control Board already ruled one standard per boundary over an EAVT source symbol; the chain, capability, and payment boundaries were simply never allocated. Opening a second allocation would create the competing center the first one forbids."))
     (map ("decision" "The chain is the only durable home; local data is cache.") ("alternatives" ("local-first with chain as backup" "dual-write" "chain as index over local files")) ("rationale" "Local residence is what lets an actuator become a machine, and a machine is what makes the actuator permanent. Demoting local stores to evictable projections removes the lattice site an ephemeral runner has not earned."))
     (map ("decision" "The Semiotic Voxel exists only actively and is never persisted.") ("alternatives" ("snapshot the arena" "event-source the arena into a store" "cache positions for resume")) ("rationale" "The voxel is the cone over the semantics/syntax cocone -- it is constituted by being played, not by being recorded. A stored voxel is a photograph of an arena presented as the arena, and admitting one would make every downstream liveness property unprovable."))
     (map ("decision" "Identity is two orthogonal laws on two axes: root identity is did:pkh:eip155:<chainId>:<address>, a DID wrapping a CAIP-10 account; cell identity is the RMN content address CellId(s, l, k) := H(sku, capability-law, controller).") ("alternatives" ("did:web anchored at emsenn.net" "bare CAIP-10 strings with no DID wrapper" "a registry service" "content address alone as controller identity" "per-settlement bespoke identifiers")) ("rationale" "did:web requires a permanently hosted .well-known/did.json, which reintroduces exactly the permanent machine this architecture exists to remove, and its resolver has stood unbuilt since it was ruled. did:pkh resolves by RPC against the chain itself, so a cold ephemeral runner can resolve an identity with no resident host and no side-channel -- the identity law and the residence budget are satisfied by the same act. It composes natively across three boundaries that would otherwise each mint their own: the x402 payment key, the UCAN issuer and audience, and the chain settlement account are one address, not three. The two axes do not compete: did:pkh identifies a controller, RMN content-addressing identifies content, and they already compose correctly inside seated capcell identity.json records where CellId is computed over the controller. Reserve did:key for short-lived per-invocation runner and session keys held underneath a did:pkh-controlled capability, never as a root. Source: the lenticule-science design note of 2026-07-25 (lib/emsenn/services/561-group/services/lenticule-science/content/documents/articles/notes/2026/07/25/2026-07-25-capcell-the-ap-evm-standard-for-agentic-orchestration.md), and the practice already seated in capcell identity records across the fabrication services."))
     (map ("decision" "Actuators hold neither keys nor funds; authority is delegated per invocation and cost is borne by a paymaster.") ("alternatives" ("actuator-held EOA" "shared hot wallet" "ambient service credentials")) ("rationale" "ERC-4337 smart accounts with an ERC-7677 paymaster and a UCAN delegation chain make a runner disposable: losing it leaks no authority and strands no funds, so runners can be killed freely, which is the property that makes them ephemeral in fact rather than in name."))
     (map ("decision" "Each sovereign settlement may name its own chain and its own proper-time clock.") ("alternatives" ("one Union chain" "a global clock" "a central registry of settlements")) ("rationale" "Settlements with no cross-settlement transaction are spacelike-separated and have no forced order; imposing one chain would manufacture a largest interior and the central third hand the constitution forbids. Chains form a forest, not a trunk."))
     (map ("decision" "Structural rigidity of a traversal is discharged by the pebble game, not by trust.") ("alternatives" ("assume the path holds" "post-hoc failure detection" "a static dependency graph")) ("rationale" "Pebbles track which constraints are placed and which remain mobile, making the difference between a load-bearing route and a floppy one decidable before the traversal rather than after it fails."))
     (map ("decision" "This section specifies and does not operate.") ("alternatives" ("build the chain here" "host the actuators here" "own the federation endpoint here")) ("rationale" "A specifying arena that also operates its own subject cannot render an independent verdict on it, and would become the eighteenth concurrent implementation rather than the one that retires the others."))))
  ("known-inconsistencies"
    ((map ("id" "INC-001") ("statement" "The admitted chain profile carries productionEligible false and status integration; eip155:5615610 orders integration-only commitments while eip155:561561 stands reserved and unstood. No module may present current chain settlement as production authority until that cutover is admitted."))
     (map ("id" "INC-002") ("statement" "Development accounts remain seated at eip155:31337 in at least the metered-inference-tollbooth and the RMN conformance service (content/evm/accounts/eip155-31337.json in each), contradicting the admitted trace chain profile. The sibling fabric architecture already carries this as its own INC-002; it is now resolvable against a live chain and is the first cut wave below."))
     (map ("id" "INC-003") ("statement" "The identifier law this architecture adopts is not yet ratified. The only seated ruling remains the-firms-did-method (did:web at emsenn.net, decided 2026-07-16, never amended), whose .well-known/did.json resolver was never built and which contradicts the residence budget on its face. did:pkh is meanwhile the de facto controller identity already seated in capcell identity.json records across at least five fabrication services. The gap is procedural, not technical: did:pkh must be brought to the change control board to amend the-firms-did-method before the protocol-allocation record's ActivityPub gate can open. Until that amendment is seated, this architecture's identity decision states the law the firm is already running, not the law the firm has ruled."))
     (map ("id" "INC-007") ("statement" "A third identifier shape is live in the finance path: rwil-store.mjs hardcodes FINANCE_SETTLEMENT as a bare CAIP-10 string with no did:pkh wrapper, pinned to eip155:31337. It is neither of the two admitted axes and is pinned to the wrong chain."))
     (map ("id" "INC-008") ("statement" "ActivityPub federation still requires something to answer an HTTPS GET for an actor document with inbox and outbox. Adopting did:pkh removes the DNS dependency for identity but does not remove that surface. Whether the actor document can be re-derived per request by an ephemeral runner reading chain state -- satisfying the residence budget for federation too -- is a design proposal in the 2026-07-25 note with no projector realized on disk. SXC-M5 owns closing this and must not assume it is closed."))
     (map ("id" "INC-004") ("statement" "RWIL presently writes to local data/rwil directories across dozens of nodes with no chain anchor, so local state is today the residence rather than the projection. SXC-M3 is unrealized and the residence budget is therefore unmet everywhere until it lands."))
     (map ("id" "INC-005") ("statement" "WMAP exists as research notes and a C2S social API plan only, never realized as code. The settlement-triggered-activity-publication-cell exists as the chain-to-ActivityPub direction; the agency face and the inbound admission path do not."))
     (map ("id" "INC-006") ("statement" "Existing A2A dependencies include prerelease SDK use; SXC-M8 must pin a production-supported profile before any boundary depends on it."))))
  ("cut-graph"
    ("did:pkh amendment to the-firms-did-method seated at the change control board"
     "eip155:31337 accounts and the finance settlement binding cut to the admitted trace chain profile"
     "RWIL chain anchoring, local rwil demoted to projection"
     "capability and payment membrane, actuators stripped of keys and funds"
     "ephemeral actuator fabric, permanent hosts deleted wave by wave"
     "WMAP agency face and inbound admission"
     "Semiotic Voxel arena realized active-only"
     "integration-to-production chain cutover")))
