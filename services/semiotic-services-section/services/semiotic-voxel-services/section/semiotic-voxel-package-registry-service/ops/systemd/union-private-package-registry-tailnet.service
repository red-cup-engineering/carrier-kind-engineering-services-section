[Unit]
Description=Union private npm-compatible package registry (Tailnet face)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/emsenn/info
ExecStart=/home/emsenn/.config/nvm/versions/node/v24.13.1/bin/node /home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/semiotic-services-section/services/semiotic-voxel-services/section/semiotic-voxel-package-registry-service/bin/serve-registry.mjs --registry /home/emsenn/info/data/package-registry-v2 --host 100.125.205.105 --port 4874
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/home/emsenn/info/data/package-registry-v2 /home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/semiotic-services-section/services/semiotic-voxel-services/section/semiotic-voxel-package-registry-service

[Install]
WantedBy=default.target
