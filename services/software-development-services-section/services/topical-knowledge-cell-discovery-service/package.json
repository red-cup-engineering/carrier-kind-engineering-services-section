{
  "name": "@red-cup-engineering/topical-knowledge-cell-discovery-service",
  "version": "0.1.0",
  "description": "Forms denominator-bounded freshness snapshots over signed topical knowledge-cell manifests without a central registry.",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "bin",
    "content",
    "lib",
    "ops",
    "src"
  ],
  "exports": {
    ".": "./lib/discovery.mjs",
    "./law": "./lib/law.mjs",
    "./protocol": "./src/protocol.mjs"
  },
  "bin": {
    "serve-topical-knowledge-cell-discovery-a2a": "./bin/server.mjs"
  },
  "scripts": {
    "check": "node --check lib/law.mjs && node --check lib/discovery.mjs && node --check src/protocol.mjs && node --check src/runtime.mjs && node --check bin/execute-a2a-task.mjs && node --check bin/server.mjs && node --check test/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.4",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.0",
    "@red-cup-engineering/a2a-sovereign-operation-boundary-service": "1.0.0",
    "@red-cup-engineering/rmn-semantic-conformance": "6.0.0"
  },
  "x-agentic-metro-enterprise": {
    "node-id": "topical-knowledge-cell-discovery-service",
    "actor": "urn:ame:topical-knowledge-cell-discovery-service",
    "organizational-kind": "sovereign-federated-discovery-micro-enterprise",
    "owners": [
      "software-development-services-section"
    ],
    "membrane": {
      "law": "lib/",
      "lasting-instances": "content/",
      "append-only-instances": "data/"
    },
    "admission": "one exact finite customer-authored endpoint denominator and one-use request-body-bound discovery capability",
    "refusal": "ambient discovery, unsigned issuer, changed manifest identity, replay collision, expired authority, unbounded age, or central completeness claim",
    "operation-catalog": {
      "discover-topical-knowledge-cells": {
        "contract": "ni:///sha-256;-SkcMUUlBJlhechOyro-I5sfLO1ODblKY8w2NNCZHvo",
        "lawSource": "content/contracts/discover-topical-knowledge-cells.rml",
        "protocol": "A2A 1.0 through a separately hired protocol provider",
        "input": "application/rmn+cbor",
        "output": "application/rmn+cbor",
        "effects": [
          "read-explicit-signed-endpoints",
          "append-provider-rwil-receipt"
        ]
      }
    }
  },
  "x-semiotic-voxel": {
    "profile": "org.harmonious-union.semiotic-voxel.v1",
    "owner": "red-cup-engineering",
    "kind": "actor",
    "actor": "urn:ame:topical-knowledge-cell-discovery-service",
    "operations": [
      "discover-topical-knowledge-cells"
    ],
    "capabilities": [
      {
        "capability": "topical-knowledge-cell-discovery-service",
        "faces": [
          "discover-topical-knowledge-cells"
        ]
      }
    ],
    "package": "@red-cup-engineering/topical-knowledge-cell-discovery-service"
  }
}
