      "render-deterministic-report-graphic": {
        "contract": "ni:///sha-256;ITq5Cj56QcUA3JDqhWhf7K_eRfFNfksTwSKwNksn9b8",
        "protocols": [
          "RMN",
          "A2A 1.0",
          "RWIL/RDF",
          "SVG Tiny 1.2",
          "PNG"
        ],
        "accepts": "DeterministicReportGraphicOperation",
        "returns": "DeterministicReportGraphicOperationResult|Reject",
        "legacyCompatibility": false
      }
    }
  },
  "version": "0.1.0",
  "x-semiotic-voxel": {
    "profile": "org.harmonious-union.semiotic-voxel.v1",
    "owner": "red-cup-engineering",
