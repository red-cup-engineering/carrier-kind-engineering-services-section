  "exports": {
    ".": "./src/client.mjs",
    "./client": "./src/client.mjs",
    "./executor": "./src/a2a-executor.mjs",
    "./renderer": "./src/deterministic-report-graphic.mjs",
    "./src/client.mjs": "./src/client.mjs",
    "./src/deterministic-report-graphic.mjs": "./src/deterministic-report-graphic.mjs"
  },
  "bin": {
