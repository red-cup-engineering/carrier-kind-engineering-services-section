  "scripts": {
    "check": "node --check src/law.mjs && node --check src/deterministic-report-graphic.mjs && node --check src/client.mjs && node --check src/a2a-executor.mjs && node --check bin/execute-a2a-message.mjs && node --check bin/serve-a2a.mjs && node --check src/verify-deterministic-report-graphic.mjs",
    "test": "node --test test/deterministic-report-graphic.test.mjs",
    "verify": "npm run check && npm test && node src/verify-deterministic-report-graphic.mjs --self-test"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
