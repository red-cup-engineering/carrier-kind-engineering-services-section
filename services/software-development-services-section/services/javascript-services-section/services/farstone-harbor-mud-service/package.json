{
  "name": "@red-cup-engineering/farstone-561-group",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "keywords": [
    "decommissioned",
    "triage"
  ],
  "description": "farstone.561.group — a playable harbor MUD, served by transporting what pipes out of our package scripts.",
  "scripts": {
    "serve": "node src/server.ts",
    "check": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./transport": "./src/transport.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/fizzos": "0.0.1",
    "@red-cup-engineering/http-server": "0.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false
}
