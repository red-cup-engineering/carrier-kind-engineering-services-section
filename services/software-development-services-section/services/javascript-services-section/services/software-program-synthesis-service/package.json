{
  "name": "@red-cup-engineering/software-program-synthesis-service",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "One-effect A2A cell that executes a contracted bounded software mission circuit; the inherited runProgram aggregate remains a separate recovery defect.",
  "exports": {
    ".": "./src/client.mjs",
    "./client": "./src/client.mjs",
    "./protocol": "./src/protocol.mjs",
    "./executor": "./src/a2a-executor.mjs",
    "./program-runtime": "./src/program-runtime.mjs",
    "./execution-circuit": "./src/execution-manifold-circuit.mjs"
  },
  "bin": {
    "execute-software-program-a2a-message": "./bin/execute-a2a-message.mjs",
    "serve-software-program-a2a": "./bin/serve-a2a.mjs"
  },
  "scripts": {
    "check": "node --check src/protocol.mjs && node --check src/client.mjs && node --check src/a2a-executor.mjs && node --check src/program-runtime.mjs && node --check src/execution-manifold-circuit.mjs && node --check bin/execute-a2a-message.mjs && node --check bin/serve-a2a.mjs",
    "test": "node --test",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@union-officer-academy/officer-context-compilation-service": "0.1.0",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.4",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.0",
    "@red-cup-engineering/a2a-rmn-task-client-service": "1.1.0",
    "@red-cup-engineering/coding-context-projection-service": "1.0.0",
    "@lenticule-science/hierarchical-circuit-equivalence-assay": "1.0.0",
    "@harmonious-union/inference-work-lot-service": "4.0.0",
    "@red-cup-engineering/rmn-semantic-conformance": "6.0.0",
    "@lenticule-science/rwil-rdf-projection-service": "1.0.2",
    "@red-cup-engineering/sandbox-command-execution-service": "1.0.0",
    "@red-cup-engineering/software-mission-execution-service": "1.0.0",
    "@red-cup-engineering/planned-transition-admission-service": "0.1.1"
  },
  "engines": {
    "node": ">=22"
  },
  "x-agentic-metro-enterprise": {
    "node-id": "software-program-synthesis-service",
    "actor": "urn:ame:software-program-synthesis-service",
    "organizational-kind": "software-program-circuit-provider",
    "owners": [
      "javascript-services-section"
    ],
    "admission": "one canonical RMN/CBOR SoftwareProgramSynthesisRequest received through the hired A2A 1.0 provider",
    "refusal": "unbounded territory, unknown acceptance gates, cyclic or spatially unsound layout, noncanonical identity, customer-package import, or direct JSON/local-process customer invocation",
    "operation-catalog": {
      "invoke-software-program-synthesis": {
        "contract": "content/contracts/software-program-synthesis.rml",
        "protocols": [
          "RMN",
          "A2A 1.0",
          "RWIL/RDF"
        ],
        "returns": "SoftwareProgramSynthesisContractResult|refusal",
        "legacyCompatibility": false
      }
    }
  },
  "x-semiotic-voxel": {
    "profile": "org.harmonious-union.semiotic-voxel.v1",
    "owner": "javascript-services-section",
    "kind": "capability-cell",
    "actor": "urn:ame:software-program-synthesis-service",
    "operations": ["invoke-software-program-synthesis"],
    "capabilities": [
      {
        "capability": "software-program-synthesis-service",
        "faces": ["invoke-software-program-synthesis"]
      }
    ],
    "package": "@red-cup-engineering/software-program-synthesis-service"
  }
}
