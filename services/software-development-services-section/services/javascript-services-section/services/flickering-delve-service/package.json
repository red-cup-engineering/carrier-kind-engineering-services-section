{
  "name": "@red-cup-engineering/flickering-561-group",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "keywords": [
    "decommissioned",
    "triage"
  ],
  "description": "flickering.561.group — a next-generation idle-roguelike on the FizzOS kernel: descend a procedurally generated cave whose play becomes programmable strategy, with an append-only auditable world-trace under traditional and decentralized micropayments.",
  "scripts": {
    "serve": "node src/server.mts",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'src/**/*.test.mts'"
  },
  "exports": {
    ".": "./src/server.mts",
    "./scene": "./src/scene.mts",
    "./economy": "./src/economy.mts",
    "./dungeon": "./src/dungeon.mts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/fizzos": "0.0.2",
    "@red-cup-engineering/http-server": "0.0.2",
    "@red-cup-engineering/organizing-with-the-web": "0.0.3",
    "@red-cup-engineering/organizing": "0.0.1",
    "@emsenn/computing-with-ledgers": "workspace:*",
    "@emsenn/computing-with-hive": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false
}
