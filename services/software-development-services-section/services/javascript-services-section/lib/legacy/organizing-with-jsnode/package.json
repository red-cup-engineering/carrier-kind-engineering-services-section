{
  "name": "@red-cup-engineering/organizing-with-jsnode",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Organizing over the JS/Node ecosystem: Node.js packages, package binaries, workspaces, analysis, and codecs as relational fact carriers over the relating-through-organizing package spine.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/scripts/workspace.mjs",
    "read": "node scripts/read.mjs",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "bin": {
    "jsnode-workspace": "./dist/scripts/workspace.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./organize": {
      "types": "./dist/organizing/index.d.mts",
      "import": "./dist/organizing/index.mjs"
    },
    "./actions": {
      "types": "./dist/actions.d.mts",
      "import": "./dist/actions.mjs"
    },
    "./typing": {
      "types": "./dist/organizing/typing/index.d.mts",
      "import": "./dist/organizing/typing/index.mjs"
    },
    "./functions": {
      "types": "./dist/organizing/functions/index.d.mts",
      "import": "./dist/organizing/functions/index.mjs"
    },
    "./modules": {
      "types": "./dist/organizing/modules/index.d.mts",
      "import": "./dist/organizing/modules/index.mjs"
    },
    "./packages": {
      "types": "./dist/organizing/packages/index.d.mts",
      "import": "./dist/organizing/packages/index.mjs"
    },
    "./workspaces": {
      "types": "./dist/organizing/workspaces/index.d.mts",
      "import": "./dist/organizing/workspaces/index.mjs"
    },
    "./codecs": {
      "types": "./dist/codecs/index.d.mts",
      "import": "./dist/codecs/index.mjs"
    },
    "./holography": {
      "types": "./dist/holography/index.d.mts",
      "import": "./dist/holography/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/561-group-conformance-algebra": "workspace:*",
    "@red-cup-engineering/animating": "0.0.2",
    "@emsenn/communicating": "workspace:*",
    "@red-cup-engineering/computing": "0.0.0",
    "@red-cup-engineering/content": "0.0.1",
    "@red-cup-engineering/gaming": "0.0.2",
    "@red-cup-engineering/knowing": "0.0.0",
    "@red-cup-engineering/organizing": "0.0.0",
    "@red-cup-engineering/playing": "0.0.1",
    "@emsenn/relating": "workspace:*",
    "@red-cup-engineering/socializing": "0.0.0",
    "typescript": "^5.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "sideEffects": false,
  "keywords": [
    "decommissioned"
  ]
}
