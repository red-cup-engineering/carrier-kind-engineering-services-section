{
  "name": "@emsenn/llm-claude-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "decommissioned",
    "triage",
    "claude"
  ],
  "description": "LLM-Claude harness server — the 561 Group Operations Manifold MCP hub that Claude Code CLI wires into. Listens on :18805/hub/mcp (default), providing a loopback-trusted MCP endpoint that Claude Code can discover via .mcp.json. Hooks, tools, and skills rigged into this hub are available to any Claude Code CLI process pointed at it.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.mjs",
    "prepack": "pnpm run rebuild",
    "rebuild": "pnpm run clean && pnpm run build"
  },
  "bin": {
    "llm-claude-harness-server": "./dist/cli.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./service": {
      "types": "./dist/service.d.mts",
      "import": "./dist/service.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/organizing-with-claude": "workspace:*",
    "@emsenn/http-server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false
}
