{
  "name": "@emsenn/llm-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "decommissioned",
    "triage"
  ],
  "description": "LLM server — apps/llm-computer bound to transports. Exposes an OpenAI-compatible chat-completions HTTP surface over @emsenn/web-server, driving the agentic loop with live inference via @emsenn/organizing-with-llm-agents/holography (the only place keys and sockets enter). Re-exports the computer and holography computing as a library. The service→app edge is the lawful spine.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emsenn/llm-server.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.mjs",
    "prepack": "pnpm run rebuild",
    "rebuild": "pnpm run clean && pnpm run build"
  },
  "bin": {
    "llm-server": "./dist/cli.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./service": {
      "types": "./dist/service.d.mts",
      "import": "./dist/service.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/organizing-with-llm-agents": "workspace:*",
    "@emsenn/llm-computer": "workspace:*",
    "@emsenn/http-server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false
}
