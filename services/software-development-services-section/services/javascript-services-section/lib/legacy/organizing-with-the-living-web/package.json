{
  "name": "@emsenn/organizing-with-the-living-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The living web: composite site and app surfaces that fuse the web tier with the semantic-web tier — content API, professional blog, digital garden, federated microblog, operation surface, and swarm console.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run rebuild",
    "rebuild": "pnpm run clean && pnpm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./content-api": {
      "types": "./dist/content-api/index.d.mts",
      "import": "./dist/content-api/index.mjs"
    },
    "./professional-blog": {
      "types": "./dist/professional-blog/index.d.mts",
      "import": "./dist/professional-blog/index.mjs"
    },
    "./digital-garden": {
      "types": "./dist/digital-garden/index.d.mts",
      "import": "./dist/digital-garden/index.mjs"
    },
    "./activitypub-microblog": {
      "types": "./dist/activitypub-microblog/index.d.mts",
      "import": "./dist/activitypub-microblog/index.mjs"
    },
    "./operation-surface": {
      "types": "./dist/operation-surface/index.d.mts",
      "import": "./dist/operation-surface/index.mjs"
    },
    "./swarm-console": {
      "types": "./dist/swarm-console/index.d.mts",
      "import": "./dist/swarm-console/index.mjs"
    },
    "./swarm-gui": {
      "types": "./dist/swarm-gui/index.d.mts",
      "import": "./dist/swarm-gui/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/animating": "workspace:*",
    "@emsenn/organizing-with-the-web": "workspace:*",
    "@emsenn/organizing-with-the-semantic-web": "workspace:*",
    "@emsenn/relating": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.61.0"
  },
  "sideEffects": false,
  "keywords": [
    "decommissioned"
  ]
}
