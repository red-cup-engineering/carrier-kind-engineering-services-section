{
  "name": "@emsenn/claude-infotics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Red Cup Engineering's Claude capability as an application ON the MetroPlat platform: claude-binary/messages/transcript/harness/capsule operations, from which the platform derives the CLI, HTTP, and MCP faces.",
  "keywords": [
    "claude",
    "anthropic",
    "claude-code",
    "metroplat",
    "metroplat-application"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "node ../../../../../../../../node_modules/.pnpm/typescript@5.9.3/node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=1 test/*.test.mts"
  },
  "bin": {
    "claude-infotics": "./src/scripts/claude-infotics.mts",
    "claude-infotics-mcp": "./src/scripts/claude-infotics-mcp.mts"
  },
  "exports": {
    ".": "./src/index.mts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/metroplat": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false
}
