{
  "name": "@red-cup-engineering/organizing-with-openai-codex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Organizing with OpenAI Codex: the Codex/VS Code organizing fiber over the 561 Group workspace, including Codex topology, CLI harness configuration, repo-root session memory, execution traces, and coding-agent work surfaces downstream of the relating-through-organizing core.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/scripts/harness.mjs dist/scripts/session.mjs",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "bin": {
    "organizing-with-openai-codex-harness": "./dist/scripts/harness.mjs",
    "codex-session": "./dist/scripts/session.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./openai": {
      "types": "./dist/openai/index.d.mts",
      "import": "./dist/openai/index.mjs"
    },
    "./openai/codex": {
      "types": "./dist/openai/codex/index.d.mts",
      "import": "./dist/openai/codex/index.mjs"
    },
    "./openai/codex/cli-harness": {
      "types": "./dist/openai/codex/cli-harness/index.d.mts",
      "import": "./dist/openai/codex/cli-harness/index.mjs"
    },
    "./harness": {
      "types": "./dist/harness.d.mts",
      "import": "./dist/harness.mjs"
    },
    "./inference": {
      "types": "./dist/inference.d.mts",
      "import": "./dist/inference.mjs"
    },
    "./session": {
      "types": "./dist/session/index.d.mts",
      "import": "./dist/session/index.mjs"
    },
    "./session/events": {
      "types": "./dist/session/events.d.mts",
      "import": "./dist/session/events.mjs"
    },
    "./scripts/harness": {
      "types": "./dist/scripts/harness.d.mts",
      "import": "./dist/scripts/harness.mjs"
    },
    "./scripts/session": {
      "types": "./dist/scripts/session.d.mts",
      "import": "./dist/scripts/session.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/animating": "0.0.2",
    "@red-cup-engineering/computing": "0.0.0",
    "@emsenn/organizing-with-openai-agents": "workspace:*",
    "@emsenn/relating": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false,
  "keywords": [
    "decommissioned"
  ]
}
