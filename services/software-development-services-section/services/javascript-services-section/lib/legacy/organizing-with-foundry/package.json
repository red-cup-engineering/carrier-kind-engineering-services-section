{
  "name": "@red-cup-engineering/organizing-with-foundry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Organizing with Microsoft Foundry: cloud Foundry project carriers plus Foundry Local small-model defaults for constrained laptops.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@azure/ai-projects": "^2.2.0",
    "@azure/identity": "^4.13.1",
    "@emsenn/organizing-with-agents": "workspace:*",
    "@emsenn/organizing-with-llm-agents": "workspace:*",
    "@emsenn/relating": "workspace:*",
    "foundry-local-sdk": "^1.2.3"
  },
  "optionalDependencies": {
    "foundry-local-sdk-winml": "^1.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false,
  "keywords": [
    "decommissioned"
  ]
}
