{
  "name": "@emsenn/llm-openai-codex-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "decommissioned",
    "triage"
  ],
  "description": "LLM-OpenAI-Codex harness server — the 561 Group Operations Manifold MCP hub for the Codex CLI. Can run standalone on :18806/hub/mcp, while canonical Codex config points at 561 Group Operations Manifold's mounted /codex/hub/mcp endpoint for config wiring, process supervision, and package-bin transport tools.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.mjs",
    "prepack": "pnpm run rebuild",
    "rebuild": "pnpm run clean && pnpm run build"
  },
  "bin": {
    "llm-openai-codex-harness-server": "./dist/cli.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./service": {
      "types": "./dist/service.d.mts",
      "import": "./dist/service.mjs"
    },
    "./process": {
      "types": "./dist/process.d.mts",
      "import": "./dist/process.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/organizing-with-openai-codex": "workspace:*",
    "@emsenn/http-server": "workspace:*",
    "@emsenn/relating": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false
}
