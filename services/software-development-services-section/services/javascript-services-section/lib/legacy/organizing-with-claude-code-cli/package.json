{
  "name": "@red-cup-engineering/organizing-with-claude-code-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Organizing with the Claude Code CLI: driving the `claude` binary itself (interactive sessions and `claude -p`/--print), NOT the Anthropic API. Pure argv builder + spawn driver over `claude`, a projection of `claude --output-format json|stream-json` events into the relational trace vocabulary, persisted ~/.claude/projects transcript reading, harness composition that makes a session powerful, and the coding-agent session computer over @emsenn/organizing-with-claude/session. Hub-agnostic and strictly upstream of the 561 Group Operations Manifold.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/scripts/run.mjs dist/scripts/session.mjs",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "bin": {
    "claude-run": "./dist/scripts/run.mjs",
    "claude-session": "./dist/scripts/session.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./exec": {
      "types": "./dist/exec.d.mts",
      "import": "./dist/exec.mjs"
    },
    "./events": {
      "types": "./dist/events.d.mts",
      "import": "./dist/events.mjs"
    },
    "./transcripts": {
      "types": "./dist/transcripts.d.mts",
      "import": "./dist/transcripts.mjs"
    },
    "./harness": {
      "types": "./dist/harness.d.mts",
      "import": "./dist/harness.mjs"
    },
    "./session": {
      "types": "./dist/session/index.d.mts",
      "import": "./dist/session/index.mjs"
    },
    "./scripts/run": {
      "types": "./dist/scripts/run.d.mts",
      "import": "./dist/scripts/run.mjs"
    },
    "./scripts/session": {
      "types": "./dist/scripts/session.d.mts",
      "import": "./dist/scripts/session.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/organizing-with-claude": "0.0.0",
    "@red-cup-engineering/computing": "0.0.0",
    "@emsenn/relating": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false,
  "keywords": [
    "decommissioned",
    "claude"
  ]
}
