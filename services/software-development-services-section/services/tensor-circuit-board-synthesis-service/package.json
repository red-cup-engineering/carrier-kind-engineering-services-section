  },
  "x-semiotic-voxel": {
    "profile": "org.harmonious-union.semiotic-voxel.v1",
    "owner": "red-cup-engineering",
    "kind": "actor",
    "actor": "urn:ame:tensor-circuit-board-synthesis-service",
    "operations": [
      "synthesize-tensor-circuit-board"
    ],
    "capabilities": [
      {
        "capability": "tensor-circuit-board-synthesis-service",
        "faces": [
          "synthesize-tensor-circuit-board"
        ]
      }
    ],
    "package": "@red-cup-engineering/tensor-circuit-board-synthesis-service"
  }
