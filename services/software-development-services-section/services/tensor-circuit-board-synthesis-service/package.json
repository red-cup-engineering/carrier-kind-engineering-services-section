{
  "name": "@red-cup-engineering/tensor-circuit-board-synthesis-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pure EDA die that fabricates one sovereign tensor board from independently owned black-box circuit faces.",
  "exports": {
    ".": "./src/synthesis.mjs",
    "./client": "./src/client.mjs"
  },
  "scripts": {
    "check": "node --check src/synthesis.mjs && node --check src/client.mjs && node --check src/law.mjs && node --check bin/execute-a2a-task.mjs && node --check bin/server.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
