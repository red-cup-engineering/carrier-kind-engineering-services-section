#lang rmn/v2
(map
  ("type" "AcceptanceCapsuleProcurementLaw")
  ("version" 2)
  ("precondition" "One canonical RMN request names bounded context, exact behavioral vectors, artifact lanes, a price bound, and no customer-selected supplier.")
  ("operation" "Declare the complete finite supplier competition before dispatch; open all typed inference lots concurrently through the contracted market; retain every refusal and settlement residue without replacement or retry; and submit each already-contracted complete oracle proposal to the distinct protected-acceptance assay until one seals or the declared frontier is exhausted. Every result binds exact inputs, provider attribution, output, and replay material; producer identity neither proves nor disproves correctness.")
  ("postcondition" "Return one canonical RMN settlement binding the selected supplier, refused candidates, resource account, and protected capsule to the exact request; append it through the hired RWIL/RDF provider.")
  ("refusal" "Refuse pinned suppliers, escaping or excessive context, missing shards, exhausted candidates, noncanonical bytes, implementation work, unbound or review evidence, or a protected assay substituted for the distinct customer-usefulness judgment."))
