(map
  ("type" "MaterializeNodeRuntimeReleaseLaw")
  ("version" 3)
  ("precondition" "Receive one independently owned exact-version entry package, one proof-carried package-source catalog or explicit provider map, and one output territory.")
  ("operation" "Bind every runtime edge to the one provider version selected by the catalog, rewrite only the fabricated manifests to those exact versions, materialize the complete runtime carrier without a package manager, and identify the closed release by the SHA-256 digest of its bytes.")
  ("postcondition" "Return one immutable release receipt naming the entry carrier, every included provider identity and version, the artifact digest, byte count, file count, and release directory.")
  ("refusal" "Refuse an untyped catalog, entry mismatch, missing providers, identity mismatch, non-exact selected versions, unresolved runtime imports, path escape, or source mutation."))
