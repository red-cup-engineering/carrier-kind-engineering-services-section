#!/bin/sh
# User-scoped Git admission gate for the /home/emsenn/info Codex offices.
# The coordinator deliberately calls /usr/bin/git, so it cannot recurse here.
set -eu
entry=/home/emsenn/info/lib/emsenn/services/board-of-directors/services/executive-office/services/change-services-section/services/git-ant-colony/src/request-git-operation.js
case "$PWD/" in
  /home/emsenn/info/*) ;;
  *) exec /usr/bin/git "$@" ;;
esac
if [ ! -r "$entry" ]; then
  echo "git admission unavailable: Git ANT Colony entrypoint is absent" >&2
  exit 126
fi
# `gh` probes with `git -C . rev-parse --git-dir` before every operation. `-C .`
# is a no-op (PWD is already `.`), so strip it rather than block it; `-C`
# pointing anywhere else still falls through to the refusal below.
while [ "${1-}" = "-C" ] && [ "${2-}" = "." ]; do
  shift 2
done
# `gh` pushes as `-c credential.helper= -c credential.helper=!gh auth ...
# <command>` — it never sets any other key. That pair only ever names gh's
# own credential program, so strip it rather than block it; `-c` naming any
# other key still falls through to the refusal below.
while [ "${1-}" = "-c" ]; do
  case "${2-}" in
    credential.helper=*) shift 2 ;;
    *) break ;;
  esac
done
case "${1-}" in
  -C|--git-dir|--work-tree|--exec-path|--config-env|-c|--bare|--namespace|--super-prefix)
    echo "direct Git repository/executable override refused; use the Git ANT Colony contract" >&2
    exit 126 ;;
esac
exec /usr/bin/node "$entry" --repo "$PWD" --wait-ms "${GIT_ANT_WAIT_MS:-300000}" -- "$@"
