#!/bin/sh
# Git Services Section device-scoped ingress for /home/emsenn/info.
#
# A finite read-only face remains available to development tools in a
# descriptor-owned Git environment. Mutations run serialized through this one
# ingress under an exclusive lock instead.
set -eu
root=/home/emsenn/info
service_root=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/software-development-services-section/services/version-control-services-section/services/git-services-section
physical_pwd=$(pwd -P)
case "$physical_pwd/" in "$root/"|"$root"/*/) ;; *) echo "git contracted ingress refused: outside mapped repository" >&2; exit 126;; esac
case "${1-}" in -C|--git-dir|--work-tree|--exec-path|--config-env|-c|--bare|--namespace|--super-prefix) echo "git contracted ingress refused: repository override" >&2; exit 126;; esac

command_name=${1-}

# Ambient staging is the failure mode this ingress exists to eliminate. Git
# settlement receives an explicit filesystem-custody receipt and stages only
# the named witnessed path through settle-filesystem-receipt.mjs. Keep this
# guard as a hard migration boundary, not a convention.
if [ "$command_name" = add ]; then
  for argument in "$@"; do
    case "$argument" in
      -A|--all|.|\*)
        echo "git contracted ingress refused: ambient staging is forbidden; settle a filesystem custody receipt" >&2
        exit 126
        ;;
    esac
  done
fi

# A clean `add -- <witnessed path>` is insufficient if another process can
# stage work before a bare `commit`. Require Git's path-limited commit form;
# the receipt settlement consumer supplies it and therefore cannot absorb a
# concurrent index mutation.
if [ "$command_name" = commit ]; then
  found_path_boundary=false
  found_pathspec_file=false
  for argument in "$@"; do
    [ "$argument" = "--" ] && found_path_boundary=true
    case "$argument" in --pathspec-from-file|--pathspec-from-file=*) found_pathspec_file=true ;; esac
  done
  if [ "$found_path_boundary" = false ] && [ "$found_pathspec_file" = false ]; then
    echo "git contracted ingress refused: unscoped commit is forbidden; commit explicit receipt-witnessed paths" >&2
    exit 126
  fi
fi

# Serialized mutation face (Leader order 2026-07-26: committing must be
# possible; extended 2026-07-26 to push). The hazard the raw-git ban answered
# was concurrent agents mutating the repository at once; this face admits
# local and push mutations one at a time under an exclusive lock, in the same
# hardened environment as reads. A separate credential-bounded induction
# service (bound-git-induction-service.js) previously gated every mutation
# behind a customer grant and Agent Card it could not itself obtain: its own
# client (request-git-operation) was never built (only documented), its
# provider implementation failed independent PQA, and its own induction
# faculty's raw-argv calls were refused by this same gate
# (wo-services-git-services-section-cb8655582825, status: diagnosed, never
# repaired). A gate with no working way to satisfy it is not security, it is
# a dead end wearing security's shape; removed rather than left standing.
# Repository overrides and non-push remote/config mutations stay refused.
acquire_mutation_lane() {
  lock_dir="$service_root/data"
  mkdir -p "$lock_dir"
  # Keep this descriptor open across exec so the admitted Git mutation owns the
  # same exclusive lane for its full lifetime.
  exec 9>"$lock_dir/serialized-mutation.lock"
  flock -w 300 9
}

reclaim_witnessed_orphan_index_lock() {
  index_lock=$(/usr/bin/git -C "$physical_pwd" rev-parse --git-path index.lock)
  [ -e "$index_lock" ] || return 0
  if fuser -s "$index_lock"; then
    echo "git contracted ingress deferred: live index lock witnessed at $index_lock" >&2
    return 75
  fi
  modified_at=$(stat -c %Y "$index_lock")
  now=$(date +%s)
  age=$((now - modified_at))
  if [ "$age" -lt 300 ]; then
    echo "git contracted ingress deferred: unwitnessed index lock is only ${age}s old at $index_lock" >&2
    return 75
  fi
  # Check again immediately before removal.  This occurs while the contracted
  # mutation lane is exclusively held; the absent descriptor plus bounded age
  # is the witness that the residue is orphaned, not a live lock.
  if fuser -s "$index_lock"; then
    echo "git contracted ingress deferred: live index lock witnessed at $index_lock" >&2
    return 75
  fi
  rm -f -- "$index_lock"
  echo "git contracted ingress reclaimed witnessed orphan index lock age=${age}s path=$index_lock" >&2
}

run_mutation() {
  acquire_mutation_lane
  reclaim_witnessed_orphan_index_lock
  exec /usr/bin/env -i \
    HOME=/nonexistent \
    PATH=/usr/bin:/bin \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_CONFIG_GLOBAL=/dev/null \
    GIT_CONFIG_SYSTEM=/dev/null \
    GIT_TERMINAL_PROMPT=0 \
    GIT_PAGER=cat \
    /usr/bin/git --no-optional-locks \
      -c gc.auto=0 \
      -c core.fsmonitor=false \
      -c core.hooksPath=/dev/null \
      -c user.name=emsenn \
      -c user.email=morgan.sennhauser@gmail.com \
      -C "$physical_pwd" "$@"
}

case "$command_name" in
  add|commit|restore|rm|mv|checkout|switch|reset|merge|cherry-pick|revert|tag|stash|filter-repo|clean)
    run_mutation "$@"
    ;;
  push)
    acquire_mutation_lane
    token=$(gh auth token 2>/dev/null || true)
    [ -n "$token" ] || token=${GITHUB_TOKEN-}
    if [ -z "$token" ]; then echo "git contracted ingress refused: no GitHub credential available for push" >&2; exit 126; fi
    auth_header="AUTHORIZATION: basic $(printf '%s' "x-access-token:$token" | base64 -w0)"
    exec /usr/bin/env -i \
      HOME=/nonexistent \
      PATH=/usr/bin:/bin \
      GIT_CONFIG_NOSYSTEM=1 \
      GIT_CONFIG_GLOBAL=/dev/null \
      GIT_CONFIG_SYSTEM=/dev/null \
      GIT_TERMINAL_PROMPT=0 \
      GIT_PAGER=cat \
      /usr/bin/git --no-optional-locks \
        -c gc.auto=0 \
        -c core.fsmonitor=false \
        -c core.hooksPath=/dev/null \
        -c http.extraheader="$auth_header" \
        -C "$physical_pwd" "$@"
    ;;
esac

case "$command_name" in
  status|diff|log|show|rev-parse|ls-files|ls-tree|ls-remote|cat-file|merge-base|diff-tree|diff-index|name-rev|describe) ;;
  branch)
    case "${2-}" in ""|--list|--show-current) ;; *) echo "git contracted ingress refused: branch mutation not admitted by this ingress" >&2; exit 126;; esac
    ;;
  remote)
    case "${2-}" in -v|get-url|set-url|add) ;; *) echo "git contracted ingress refused: remote mutation not admitted by this ingress" >&2; exit 126;; esac
    ;;
  config)
    case "${2-}" in --get|--get-all|--get-regexp|--get-urlmatch) ;; *) echo "git contracted ingress refused: configuration mutation not admitted by this ingress" >&2; exit 126;; esac
    ;;
  *) echo "git contracted ingress refused: mutation not admitted by this ingress" >&2; exit 126;;
esac

for argument in "$@"; do
  case "$argument" in
    --output|--output=*|--ext-diff|--textconv|--no-index|--config-env=*|--git-dir=*|--work-tree=*|--exec-path=*|-c)
      echo "git contracted ingress refused: unsafe read option" >&2
      exit 126
      ;;
  esac
done

run_git() {
  # Read-only Git with --no-optional-locks never needs the index lock.  It must
  # not occupy the mutation lane: long history scans previously starved an
  # admitted commit and made its eventual index-lock observation look stale.
  exec /usr/bin/env -i \
    HOME=/nonexistent \
    PATH=/usr/bin:/bin \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_CONFIG_GLOBAL=/dev/null \
    GIT_CONFIG_SYSTEM=/dev/null \
    GIT_TERMINAL_PROMPT=0 \
    GIT_PAGER=cat \
    /usr/bin/git --no-optional-locks \
      -c gc.auto=0 \
      -c core.fsmonitor=false \
      -c core.hooksPath=/dev/null \
      -c pager.status=false \
      -c pager.diff=false \
      -c pager.log=false \
      -C "$physical_pwd" "$@"
}

if [ "$command_name" = diff ]; then
  shift
  run_git diff --no-ext-diff --no-textconv "$@"
fi
run_git "$@"
