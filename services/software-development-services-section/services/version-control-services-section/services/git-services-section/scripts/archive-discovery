#!/usr/bin/env node
import { discoverArchives, archiveDiscoveryNdjson } from "../src/discover-archives.mjs";

const usage = `Usage: archive-discovery --root PATH [--format json|ndjson]

Inventories directories named exactly archive or _archive below PATH.
JSON is a single report; NDJSON emits one discovery entry per line followed by
the root record. Git metadata is included and labelled git-metadata.`;

function fail(message) {
  process.stderr.write(`archive-discovery: ${message}\n`);
  process.exitCode = 2;
}

const arguments_ = process.argv.slice(2);
let root;
let format = "json";
for (let index = 0; index < arguments_.length; index += 1) {
  const argument = arguments_[index];
  if (argument === "--help" || argument === "-h") {
    process.stdout.write(`${usage}\n`);
    process.exit(0);
  }
  if (argument === "--root") {
    root = arguments_[index + 1];
    index += 1;
  } else if (argument === "--format") {
    format = arguments_[index + 1];
    index += 1;
  } else {
    fail(`unknown argument ${argument}; use --help`);
    break;
  }
}

if (!process.exitCode && !root) fail("--root PATH is required");
if (!process.exitCode && !["json", "ndjson"].includes(format)) fail("--format must be json or ndjson");
if (!process.exitCode) {
  try {
    const report = await discoverArchives(root);
    process.stdout.write(format === "ndjson"
      ? archiveDiscoveryNdjson(report)
      : `${JSON.stringify(report)}\n`);
  } catch (error) {
    fail(error.message);
  }
}
