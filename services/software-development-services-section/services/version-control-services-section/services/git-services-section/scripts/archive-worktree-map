#!/usr/bin/env node
import { archiveWorktreeMapNdjson, mapArchiveWorktrees } from "../src/map-archive-worktrees.mjs";

const usage = "Usage: archive-worktree-map --root PATH [--format json|ndjson]";
const args = process.argv.slice(2);
let root; let format = "json";
for (let index = 0; index < args.length; index += 1) {
  if (args[index] === "--help" || args[index] === "-h") { console.log(usage); process.exit(0); }
  if (args[index] === "--root") root = args[++index];
  else if (args[index] === "--format") format = args[++index];
  else fail(`unknown argument ${args[index]}`);
}
if (!root) fail("--root PATH is required");
if (!['json', 'ndjson'].includes(format)) fail("--format must be json or ndjson");
try {
  const report = await mapArchiveWorktrees(root);
  process.stdout.write(format === "ndjson" ? archiveWorktreeMapNdjson(report) : `${JSON.stringify(report)}\n`);
} catch (error) { fail(error.message); }

function fail(message) { process.stderr.write(`archive-worktree-map: ${message}\n`); process.exit(2); }
