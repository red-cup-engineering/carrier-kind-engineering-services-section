{
  "name": "@red-cup-engineering/infomaterial-layout-service",
  "version": "5.0.1",
  "private": true,
  "type": "module",
  "description": "Exact carrier-layout assay joining reusable M1 circuit definitions and one sovereign assembly to one recursive infomaterial cover.",
  "exports": {
    ".": "./src/layout-assay.mjs",
    "./client": "./src/client.mjs"
  },
  "bin": {
    "serve-infomaterial-layout-a2a": "./scripts/server.mjs"
  },
  "scripts": {
    "check": "node --check src/layout-assay.mjs && node --check src/client.mjs && node --check src/law.mjs && node --check scripts/execute-a2a-task.mjs && node --check scripts/server.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@red-cup-engineering/a2a-agent-card-discovery-service": "1.0.1",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.5",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.1",
    "@red-cup-engineering/a2a-rmn-task-client-service": "1.1.1",
    "@lenticule-science/hierarchical-circuit-equivalence-assay": "1.0.1",
    "@lenticule-science/infomaterial-observation": "2.0.1",
    "@lenticule-science/infomaterial-patch-cover": "3.0.1",
    "@lenticule-science/rmn-circuit-board-carrier-refinement": "2.0.1",
    "@red-cup-engineering/rmn-semantic-conformance": "6.0.2",
    "@lenticule-science/witness-journal-rdf-projection-service": "1.0.3",
    "@lenticule-science/wasm-four-carrier-refinement": "1.0.1"
  }
}
