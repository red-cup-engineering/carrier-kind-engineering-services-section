{
  "name": "@red-cup-engineering/topical-knowledge-cell-brokerage-service",
  "version": "0.1.0",
  "description": "Qualifies and componentwise-compares finite topical knowledge-cell product listings without central ranking or publication.",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "bin",
    "content",
    "lib",
    "ops",
    "src"
  ],
  "exports": {
    ".": "./lib/brokerage.mjs",
    "./law": "./lib/law.mjs",
    "./protocol": "./src/protocol.mjs"
  },
  "bin": {
    "serve-topical-knowledge-cell-brokerage-a2a": "./bin/server.mjs"
  },
  "scripts": {
    "check": "node --check lib/law.mjs && node --check lib/brokerage.mjs && node --check src/protocol.mjs && node --check src/runtime.mjs && node --check bin/execute-a2a-task.mjs && node --check bin/server.mjs && node --check test/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.4",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.0",
    "@red-cup-engineering/a2a-sovereign-operation-boundary-service": "1.0.0",
    "@red-cup-engineering/rmn-semantic-conformance": "6.0.0"
  },
  "x-agentic-metro-enterprise": {
    "node-id": "topical-knowledge-cell-brokerage-service",
    "actor": "urn:ame:topical-knowledge-cell-brokerage-service",
    "organizational-kind": "sovereign-market-qualification-micro-enterprise",
    "owners": [
      "software-development-services-section"
    ],
    "membrane": {
      "law": "lib/",
      "lasting-instances": "content/",
      "append-only-instances": "data/"
    },
    "admission": "one finite customer-authored listing denominator, exact qualification policy, and nondelegable single-use request-body-bound capability",
    "refusal": "ambient discovery, malformed listing, identity drift, forged package or Agent Card evidence, price conversion, central ranking, publication request, or replay collision",
    "operation-catalog": {
      "qualify-topical-knowledge-cell-products": {
        "contract": "ni:///sha-256;7F8u-HFW38ouTgI1eUDxbMSBV8DAZLXSIku_6v0YI_8",
        "lawSource": "content/contracts/qualify-topical-knowledge-cell-products.rml",
        "protocol": "A2A 1.0 via separately hired provider",
        "input": "application/rmn+cbor",
        "output": "application/rmn+cbor"
      }
    }
  },
  "x-semiotic-voxel": {
    "profile": "org.harmonious-union.semiotic-voxel.v1",
    "owner": "red-cup-engineering",
    "kind": "actor",
    "actor": "urn:ame:topical-knowledge-cell-brokerage-service",
    "operations": [
      "qualify-topical-knowledge-cell-products"
    ],
    "capabilities": [
      {
        "capability": "topical-knowledge-cell-brokerage-service",
        "faces": [
          "qualify-topical-knowledge-cell-products"
        ]
      }
    ],
    "package": "@red-cup-engineering/topical-knowledge-cell-brokerage-service"
  }
}
