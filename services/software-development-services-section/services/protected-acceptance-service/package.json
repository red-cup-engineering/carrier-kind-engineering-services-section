{
  "name": "@red-cup-engineering/protected-acceptance-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sovereign die that assays and seals one protected software-acceptance capsule.",
  "exports": {
    ".": "./src/client.mjs",
    "./client": "./src/client.mjs"
  },
  "scripts": {
    "check": "node --check src/acceptance-capsule.mjs && node --check src/protocol.mjs && node --check src/client.mjs && node --check src/law.mjs && node --check bin/execute-a2a-task.mjs && node --check bin/server.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.4",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.0",
    "@red-cup-engineering/a2a-rmn-task-client-service": "1.1.0",
    "@red-cup-engineering/acceptance-oracle-assay-service": "2.0.0",
    "@red-cup-engineering/rmn-semantic-conformance": "6.0.0",
    "@lenticule-science/rwil-rdf-projection-service": "1.0.2",
    "@red-cup-engineering/sandbox-command-execution-service": "1.0.0"
  },
  "x-agentic-metro-enterprise": {
    "node-id": "protected-acceptance-service",
    "actor": "urn:ame:protected-acceptance-service",
    "organizational-kind": "micro-enterprise",
    "owners": [
      "software-development-services-section"
    ],
    "admission": "one canonical RMN request containing bounded source evidence, explicit test vectors, and proposed oracle artifacts",
    "refusal": "unbounded authority, nondeterministic oracle source, infrastructure-only red, failed deterministic oracle assay, stale evidence, or noncanonical carrier",
    "operation-catalog": {
      "prepare-protected-acceptance": {
        "contract": "content/contracts/prepare-protected-acceptance.rml",
        "protocol": "A2A 1.0",
        "legacyCompatibility": false
      }
    }
  },
  "x-semiotic-voxel": {
    "profile": "org.harmonious-union.semiotic-voxel.v1",
    "owner": "red-cup-engineering",
    "kind": "actor",
    "actor": "urn:ame:protected-acceptance-service",
    "operations": [
      "prepare-protected-acceptance"
    ],
    "capabilities": [
      {
        "capability": "protected-acceptance-service",
        "faces": [
          "prepare-protected-acceptance"
        ]
      }
    ],
    "package": "@red-cup-engineering/protected-acceptance-service"
  }
}
