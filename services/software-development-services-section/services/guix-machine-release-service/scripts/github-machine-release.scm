;;; GitHub owns invocation; this program builds only the snapshot's exact inputs.
(use-modules (ice-9 match) (ice-9 popen) (ice-9 rdelim) (ice-9 format)
             (ice-9 ftw) (json) (srfi srfi-1) (srfi srfi-43))
(umask #o077)
(define (run . argv)
  (unless (zero? (apply system* argv)) (error "release step failed" (car argv))))
(define (capture . argv)
  (let* ((p (apply open-pipe* OPEN_READ argv))
         (lines (let loop ((out '())) (let ((line (read-line p)))
                   (if (eof-object? line) (reverse out) (loop (cons line out))))))
         (status (close-pipe p)))
    (unless (zero? status) (error "release step failed" (car argv)))
    (if (null? lines) "" (last lines))))
(define (read-json path) (call-with-input-file path json->scm))
(define (write-json path value)
  (call-with-output-file path (lambda (p) (scm->json value p) (newline p))))
(match (cdr (command-line))
 ((snapshot work mode)
  (let* ((spec (read-json (string-append snapshot "/sources.json")))
         (repositories (assoc-ref spec "repositories"))
         (workspace (string-append work "/workspace"))
         (prepared (string-append work "/prepare.json")))
    (when (member mode '("deploy" "check-failure" "rollback"))
      (let ((sha (getenv "GITHUB_SHA")) (repo (getenv "GITHUB_REPOSITORY"))
            (config (read-json (string-append snapshot "/machine.json"))))
        (unless (and sha (= (string-length sha) 40) repo
                     (equal? sha (capture "git" "-C" snapshot "rev-parse" "HEAD"))
                     (equal? repo (assoc-ref config "repository"))
                     (zero? (system* "git" "-C" snapshot "diff" "--quiet" "HEAD")))
          (error "deployment requires the exact committed GitHub machine snapshot"))))
    (run "mkdir" "-p" work)
    (when (equal? mode "rollback")
      (let* ((config (read-json (string-append snapshot "/machine.json")))
             (previous (canonicalize-path (string-append (assoc-ref config "releaseRoot") "/previous"))))
        (run "guix" "repl" "--" (string-append (dirname (car (command-line))) "/receive.scm")
             (string-append snapshot "/machine.json") previous "--rollback")
        (exit 0)))
    (unless (member mode '("build" "deploy" "check-failure" "resolve")) (error "unsupported release mode" mode))
    (let ((resolved
      (vector-map
       (lambda (index r)
         (let* ((repo (assoc-ref r "repository")) (commit (assoc-ref r "commit"))
                (directory (string-append work "/sources/" (string-map (lambda (c) (if (char=? c #\/) #\_ c)) repo))))
           (unless (and commit (= (string-length commit) 40)) (error "source needs a full commit" repo))
           (unless (file-exists? (string-append directory "/.git"))
             (run "mkdir" "-p" (dirname directory))
             (run "gh" "repo" "clone" repo directory "--" "--filter=blob:none" "--no-checkout"))
           (run "git" "-C" directory "fetch" "--depth=1" "origin" commit)
           (run "git" "-C" directory "checkout" "--detach" commit)
           (acons "directory" directory r))) repositories)))
      (run "rm" "-rf" workspace)
      (write-json prepared (acons "output" workspace
        (acons "repositories" resolved (filter (lambda (p) (not (member (car p) '("repositories" "output")))) spec))))
      (let* ((owner (find (lambda (r) (equal? (assoc-ref r "repository") "red-cup-engineering/computer-services-section")) (vector->list resolved)))
             (service (string-append (assoc-ref owner "directory") "/services/software-development-services-section/services/guix-machine-release-service"))
             (lock (string-append snapshot "/dependencies.lock.yaml")))
        (run "node" (string-append service "/scripts/prepare-sources.mjs") prepared)
        (if (equal? mode "resolve")
          (begin
            (run "npm" "exec" "--yes" "--package=pnpm@11.9.0" "--" "pnpm" "--dir" workspace
                 "install" "--lockfile-only" "--ignore-scripts" "--cache-dir" (string-append work "/registry-cache"))
            (copy-file (string-append workspace "/pnpm-lock.yaml") lock)
            (exit 0))
          (begin
            (unless (file-exists? lock) (error "reviewed dependency lock is missing; resolve and commit it before deployment"))
            (copy-file lock (string-append workspace "/pnpm-lock.yaml"))
            (run "npm" "exec" "--yes" "--package=pnpm@11.9.0" "--" "pnpm" "--dir" workspace
                 "install" "--frozen-lockfile" "--ignore-scripts" "--cache-dir" (string-append work "/registry-cache"))))
        (let* ((assembled (json-string->scm (capture "node" (string-append service "/scripts/assemble.mjs") workspace snapshot (string-append work "/artifacts"))))
               (closure (assoc-ref assembled "closure"))
               (built (json-string->scm (capture "guix" "repl" "--" (string-append service "/scripts/guix-deployment.scm")
                       "build" (string-append snapshot "/channels.scm") (string-append service "/src")
                       (string-append snapshot "/machine.scm") closure (string-append work "/candidate"))))
               (store (assoc-ref built "storePath")))
          (write-json (string-append work "/candidate.json") built)
          (when (getenv "GITHUB_STEP_SUMMARY")
            (call-with-output-file (getenv "GITHUB_STEP_SUMMARY")
              (lambda (p) (format p "Guix candidate: `~a`~%~%NAR SHA256: `~a`~%" store (assoc-ref built "narSha256")))))
          (apply run "guix" "repl" "--" (string-append service "/scripts/receive.scm")
                     (string-append snapshot "/machine.json") store
                     (cond ((equal? mode "check-failure") '("--check-failure"))
                           ((equal? mode "build") '("--stage-only")) (else '()))))))))
 (_ (error "usage: github-machine-release.scm SNAPSHOT WORK build|deploy|check-failure")))
