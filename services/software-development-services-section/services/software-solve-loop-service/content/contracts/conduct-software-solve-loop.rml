#lang rmn/v2
(map ("type" "SoftwareSolveLoopLaw") ("version" 2) ("precondition" "One bounded task supplies explicit context, synthesis, materialization, verification, and optional refinement effects.") ("operation" "Try admitted deterministic resolvers, then bounded synthesis rounds, then only the explicitly supplied refinement effect.") ("postcondition" "Return a typed staged outcome and residues while customer verification remains a distinct judgment; producer identity neither proves nor disproves correctness.") ("refusal" "Refuse ambient providers, implicit escalation, hidden mutation, provider completion substituted for the distinct customer-acceptance judgment, unbound or unreplayable evidence, or fallback."))
