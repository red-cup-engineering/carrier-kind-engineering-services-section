[Unit]
Description=Union private npm-compatible package registry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/emsenn/info
ExecStart=/home/emsenn/.config/nvm/versions/node/v24.13.1/bin/node /home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/software-development-services-section/services/jsnode-services-section/services/jsnode-packaging-services-section/services/npm-registry-services-section/services/npm-registry-service/scripts/serve-registry.mjs --registry /home/emsenn/info/data/package-registry-v2 --host 127.0.0.1 --port 4873
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/home/emsenn/info/data/package-registry-v2 /home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/software-development-services-section/services/jsnode-services-section/services/jsnode-packaging-services-section/services/npm-registry-services-section/services/npm-registry-service

[Install]
WantedBy=default.target
