{
  "name": "@emsenn/meme-topology",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Meme topology as an inductive carrier and morphism derivation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emsenn/meme-topology.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.mts\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node ../../scripts/package-boundary/copy-dmts-to-dts.mjs dist",
    "docs:api": "typedoc --options typedoc.json && node scripts/prepare-api-docs.mjs",
    "docs:dev": "pnpm run docs:api && astro dev --root sites/starlight --host 0.0.0.0",
    "docs:build": "pnpm run docs:api && astro build --root sites/starlight",
    "docs:preview": "astro preview --root sites/starlight --host 0.0.0.0",
    "test": "pnpm run build && tsc -p tsconfig.test.json && node --test \".tmp/test-dist/**/*.test.mjs\"",
    "test:implementation": "pnpm run build && tsc -p tsconfig.test.json && node --test \".tmp/test-dist/**/*implementation.test.mjs\"",
    "test:math": "pnpm run build && tsc -p tsconfig.test.json && node --test \".tmp/test-dist/**/*math.test.mjs\"",
    "test:property": "pnpm run build && tsc -p tsconfig.test.json && node --test \".tmp/test-dist/**/*property.test.mjs\"",
    "bench": "pnpm run build && node scripts/bench.mjs",
    "bench:algebra": "pnpm run build && node scripts/bench.mjs --profile=algebra",
    "bench:topology": "pnpm run build && node scripts/bench.mjs --profile=topology",
    "bench:deep": "pnpm run build && node scripts/bench.mjs --deep",
    "bench:sampled": "pnpm run build && node scripts/bench.mjs --sampled",
    "bench:sampled:algebra": "pnpm run build && node scripts/bench.mjs --profile=algebra --sampled",
    "bench:sampled:topology": "pnpm run build && node scripts/bench.mjs --profile=topology --sampled",
    "bench:record": "pnpm run build && node scripts/bench.mjs --record",
    "bench:record:algebra": "pnpm run build && node scripts/bench.mjs --profile=algebra --record",
    "bench:record:topology": "pnpm run build && node scripts/bench.mjs --profile=topology --record",
    "bench:record:deep": "pnpm run build && node scripts/bench.mjs --record --deep",
    "bench:record:sampled": "pnpm run build && node scripts/bench.mjs --record --sampled",
    "profile": "pnpm run build && node scripts/profile.mjs",
    "profile:algebra": "pnpm run build && node scripts/profile.mjs --profile=algebra",
    "profile:topology": "pnpm run build && node scripts/profile.mjs --profile=topology",
    "profile:deep": "pnpm run build && node scripts/profile.mjs --deep",
    "profile:record": "pnpm run build && node scripts/profile.mjs --record",
    "profile:record:algebra": "pnpm run build && node scripts/profile.mjs --profile=algebra --record",
    "profile:record:topology": "pnpm run build && node scripts/profile.mjs --profile=topology --record",
    "profile:record:deep": "pnpm run build && node scripts/profile.mjs --deep --record",
    "profile:cpu": "pnpm run build && mkdir -p .tmp/profiles && node --cpu-prof --cpu-prof-dir=.tmp/profiles scripts/profile.mjs --profile=topology",
    "profile:heap": "pnpm run build && mkdir -p .tmp/profiles && node --heap-prof --heap-prof-dir=.tmp/profiles scripts/profile.mjs --profile=topology",
    "audit:boundary": "node ../../scripts/package-boundary/audit-package-boundary.mjs .",
    "verify": "pnpm run check && pnpm run lint && pnpm run test && pnpm run audit:boundary",
    "prepack": "pnpm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./dynamics": {
      "types": "./dist/dynamics.d.ts",
      "import": "./dist/dynamics.mjs"
    },
    "./arithmetic": {
      "types": "./dist/arithmetic.d.ts",
      "import": "./dist/arithmetic.mjs"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/meme-algebra": "workspace:*",
    "@emsenn/meme-logic": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.39.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "astro": "^6.4.5",
    "eslint": "^10.4.1",
    "fast-check": "^4.8.0",
    "tinybench": "^6.0.2",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.61.0"
  },
  "sideEffects": false
}
