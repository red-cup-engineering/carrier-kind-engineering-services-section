{
  "name": "@emsenn/jsnode-computer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Node workspace computing: reads package.json manifests into jsnode-topology carriers, discovers all workspace packages, resolves dependency structure.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emsenn/jsnode-computer.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "jsnode-computer": "./dist/cli.mjs"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node ../../scripts/package-boundary/copy-dmts-to-dts.mjs dist",
    "test": "pnpm run build && tsc -p tsconfig.test.json && node --test \".tmp/test-dist/**/*.test.mjs\"",
    "audit:boundary": "node ../../scripts/package-boundary/audit-package-boundary.mjs .",
    "verify": "pnpm run check && pnpm run test && pnpm run audit:boundary",
    "prepack": "pnpm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/javascript-computer": "workspace:*",
    "@emsenn/jsnode": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false
}
