#lang rmn/v2
(map
  ("type" "RecursiveFourCircuitProofThreatAndVectorObligations")
  ("version" 8)
  ("precondition" "The recursive fabric requirements, SAS, M1 HLD, and kernel LLD are fixed by their canonical RMN identities.")
  ("operation" "Maintain the proof ledger, adversarial threat cases, standard profiles, and language-neutral vectors that independently gate every recursive fabric cut.")
  ("postcondition" "No design, implementation, provider, deployment, or cut is admitted unless its allocated theorem obligations and adversarial vectors pass at the proper independent gates.")
  ("refusal" "Refuse proof-by-test claims, standard-by-label claims, producer self-attestation, omitted protected-defect cases, unversioned protocol dependencies, or a passing local unit presented as territory-wide completion.")
  ("theorem-obligations"
    ((map ("id" "THM-001") ("statement" "Normalization is idempotent and two alpha-equivalent circuit sources produce identical deterministic CBOR and ni identity.") ("status" "executable property; Lean theorem required"))
     (map ("id" "THM-002") ("statement" "Every admitted component transfer is monotone in the product FOUR knowledge order.") ("status" "executable exhaustive proof for bounded profile; Lean theorem required"))
     (map ("id" "THM-003") ("statement" "Finite networks of admitted monotone components reach a least fixed point independent of fair evaluation order.") ("status" "mathematical obligation; current evaluator supplies one deterministic order and bounded test"))
     (map ("id" "THM-004") ("statement" "For every admitted composite D, Beh(Synth(D)) equals Compose_D(Beh(C_i)).") ("status" "executable equivalence gate; compositional Lean theorem required"))
     (map ("id" "THM-005") ("statement" "Contextual enterprise, nation, and colony readings preserve placement-neutral component identity and pin behavior while sovereign membranes vary by occurrence; Union descent is not representable as one component interior.") ("status" "executable assembly vectors exist; Lean formalization required"))
     (map ("id" "THM-006") ("statement" "Tensor is exactly the factorable fragment and par exactly the consensus-requiring fragment under declared custody, scarcity, atomicity, and circuit-closure assumptions.") ("status" "constitutional theorem obligation not yet proved"))
     (map ("id" "THM-007") ("statement" "ACI import of finalized external evidence is order-independent and cannot create simultaneous exclusive custody.") ("status" "multi-chain model and proof required"))))
  ("threats"
    ((map ("id" "T-001") ("attack" "child bytes do not match the parent reference") ("control" "recompute ni and refuse component-drift"))
     (map ("id" "T-002") ("attack" "parent acquires or mutates a child interior, or one definition hard-codes an occurrence membrane") ("control" "definition carrier contains only law, component identity, pinout, nets, behavior commitment, and contracted disclosure; assembly alone carries contextual membranes"))
     (map ("id" "T-003") ("attack" "legacy scale or unknown field is smuggled through normalization") ("control" "exact-key rejection and territory scanner"))
     (map ("id" "T-004") ("attack" "tensor work leaks to consensus or par settles without finality") ("control" "mode-specific exact fields, EVM profile, replay and finality tests"))
     (map ("id" "T-005") ("attack" "nonmonotone child oscillates or retracts evidence") ("control" "exhaustive monotonicity assay and append-only correction"))
     (map ("id" "T-006") ("attack" "behavior-table explosion exhausts the assay") ("control" "six-input bounded profile, byte/time/fuel limits, later versioned symbolic proof profile"))
     (map ("id" "T-007") ("attack" "lawful protected holonomy is classified as fraud") ("control" "typed defect classes and blue-gate protected-border vectors"))
     (map ("id" "T-008") ("attack" "one producer certifies its own semantic, protocol, simulation, or adversarial result") ("control" "independent white, black, red, and blue accounts and receipts"))
     (map ("id" "T-009") ("attack" "Article 50 provenance is stripped at one layer") ("control" "visible disclosure, soft binding, C2PA manifest, public verifier, and EVM commitment tested independently"))
     (map ("id" "T-010") ("attack" "a consumer invents a provider die from a role label or absorbs the provider's recursive interior") ("control" "one signed Agent Card interface carries the provider-owned black-box leaf; exact-key and leaf-only gates refuse role synthesis and interior disclosure"))
     (map ("id" "T-011") ("attack" "a caller labels arbitrary bytes as a component carrier") ("control" "an independent proof-profile-specific provider recomputes material identity and mechanically compares complete observed vectors with the exact component behavior"))
     (map ("id" "T-012") ("attack" "a refinement carrier gains undeclared host authority") ("control" "the initial WebAssembly profile refuses every import and exposes only its two exact evidence-bit functions; later profiles require separate bounded threat models"))
     (map ("id" "T-013") ("attack" "a composite board silently owns or substitutes the topology synthesis it later executes") ("control" "an independently smart-accounted signed synthesis die returns the exact family and assembly receipt; the board binds that seam"))
     (map ("id" "T-014") ("attack" "a synthesis, normalizer, conductor, or layout provider attests its own behavior claim or substitutes a different equivalence provider") ("control" "the independent signed equivalence die binds exact request, provider account, circuit, assembly, behavior, components, receipt, and seam; former equivalence operations are removed from general providers"))
     (map ("id" "T-015") ("attack" "a normalizer or circuit participant self-assays a route, collapses typed residues into one score, or classifies lawful protected holonomy as fraud") ("control" "the independent signed typed-residue die binds exact request and provider, preserves four residue carriers, checks the declared border class, and the former general-normalizer trace operation is deleted"))
     (map ("id" "T-016") ("attack" "a normalizer or operation provider issues its own WIT, accepts a zero-bit or two-bit revision, changes effect identity, substitutes evidence, or serves an unsigned assay") ("control" "the independent signed WIT-transition die accepts exactly one stable evidence-bound zero-to-one FOUR cover, binds request and provider account, appends RWIL evidence, and the former normalizer operation is refused"))))
  ("profiles" ("org.emsenn.infomaterial.hierarchical-circuit-equivalence-assay.v1" "org.emsenn.obsmetrology.typed-circuit-residue-assay.v1" "org.emsenn.obsmetrology.wit-transition-assay.v1" "org.emsenn.infomaterial.recursive-observation-circuit-synthesis.v1" "org.emsenn.rmn.hierarchical-circuit.v3" "org.emsenn.rmn.circuit-assembly.v1" "org.emsenn.rmn.sovereign-circuit-interface.v1" "org.emsenn.rmn.hierarchical-circuit-trace.v5" "org.emsenn.infomaterial.carrier-refinement.v1" "org.emsenn.infomaterial.wasm-four-carrier.v1" "org.emsenn.infomaterial.rmn-circuit-board-carrier.v1" "RFC 8949 core deterministic" "RFC 6920 SHA-256 ni" "FOUR explicit evidence bits" "A2A 1.0 RMN-CBOR" "WebAssembly Core 2.0 no-import bounded profile" "ERC-4337 plus ERC-1271 EIP-712 ERC-5267 CAIP-10" "RDF Dataset Canonicalization 1.0 and PROV" "x402 v2" "C2PA 2.4"))
