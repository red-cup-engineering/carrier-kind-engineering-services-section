#lang rmn/v2
(map
  ("type" "RmnCircuitSemanticKernelHighLevelDesign")
  ("version" 7)
  ("precondition" "SAS module M1 is admitted as the semantic kernel for FAB-R001 through FAB-R005 and FAB-R011; FAB-R006 and FAB-R022 require a distinct hierarchical-equivalence judgment, FAB-R023 requires a distinct typed closed-circuit residue judgment, and FAB-R024 requires a distinct evidence-bound WIT-transition judgment.")
  ("operation" "Decompose M1 into canonical profile, structural elaboration, FOUR behavior, assembly, identity, and conformance-vector primitives with complete typed interfaces; preserve equivalence, typed-residue, and WIT-transition as explicit noninterchangeable receipt types with re-executable evidence.")
  ("postcondition" "An EDA implementation can consume the M1 interface without importing the provider interior or inventing local RMN, FOUR, hierarchy, or identity rules.")
  ("refusal" "Refuse an interface defined by current code, an untyped JSON object, a scale field, a child-interior requirement, an unbounded truth table, or a unit without an allocated M1 requirement.")
  ("sas-module" "M1")
  ("units"
    ((map ("id" "M1-U1") ("name" "placement-neutral hierarchical circuit profile") ("requirements" ("FAB-R002" "FAB-R003" "FAB-R004")) ("responsibility" "Normalize and encode only law, ports, component-definition references, nets, and black-box behavior as deterministic typed RMN; reject embedded occurrence identity."))
     (map ("id" "M1-U2") ("name" "FOUR behavior checker") ("requirements" ("FAB-R001" "FAB-R005")) ("responsibility" "Require complete bounded behavior tables and knowledge-order monotonicity."))
     (map ("id" "M1-U3") ("name" "netlist elaborator") ("requirements" ("FAB-R003" "FAB-R007")) ("responsibility" "Resolve contracted reusable child definitions and check pin direction, type, mode, complete routing, and tensor/par legality without copying interiors or occurrence membranes into the parent."))
     (map ("id" "M1-U4") ("name" "least-fixed-point synthesizer") ("requirements" ("FAB-R005" "FAB-R006")) ("responsibility" "Compose child black-box behavior over the wired netlist and compute the finite least knowledge fixed point."))
     (map ("id" "M1-U6") ("name" "sovereign assembly checker") ("requirements" ("FAB-R003" "FAB-R013")) ("responsibility" "Require one exact contextual membrane placement for every recursive occurrence with no gaps, duplicates, or invented addresses."))
     (map ("id" "M1-U8") ("name" "sovereign black-box interface face") ("requirements" ("FAB-R003" "FAB-R010" "FAB-R019")) ("responsibility" "Decode exactly one signed Agent Card interface as a provider-owned placement-neutral leaf plus sovereign membrane; reject interiors and caller-invented role behavior."))))
  ("interfaces"
    ((map ("name" "normalizeHierarchicalCircuit") ("input" "decoded circuit diagnostic value") ("output" "normalized decoded value or typed refusal") ("errors" ("malformed-circuit" "consensus-leak" "unsettled-par" "incomplete-behavior" "nonmonotone-behavior")))
     (map ("name" "encodeHierarchicalCircuit") ("input" "normalized circuit") ("output" "relational RMN ascription suitable for deterministic CBOR and ni identity") ("errors" ("all normalization refusals")))
     (map ("name" "synthesizeCircuitBehavior") ("input" "parent definition and identity-keyed contracted child-definition library") ("output" "canonical finite FOUR transfer behavior") ("errors" ("missing-component" "component-drift" "unknown-pin" "pin-type-mismatch" "unrouted-pin" "nonconvergent-circuit")))
     (map ("name" "verifyCircuitEquivalence") ("input" "parent definition and child-definition library") ("output" "parent ni identity, composed behavior ni identity, equivalent true") ("errors" ("behavior-mismatch" "synthesis errors")))
     (map ("name" "verifyCircuitAssembly") ("input" "verified definition family and sovereign assembly") ("output" "assembly ni identity and every contextual occurrence") ("errors" ("assembly-root-mismatch" "unplaced-circuit" "unknown-placement")))
     (map ("name" "circuitInterfaceFromAgentCard") ("input" "verified standard Agent Card") ("output" "one normalized public leaf definition and sovereign membrane") ("errors" ("absent-or-repeated-interface" "malformed-circuit" "interior-disclosure")))))
  ("information" "The parent owns only its placement-neutral definition and references child component identities. Child definitions are supplied to an assay under an explicit contract and are not embedded in the parent object. A separate assembly owns contextual account, authority, custody, and territory placements. No operational scale label exists in either carrier.")
  ("interaction" "Normalize the definition family; resolve each child by ni identity; validate pinouts; synthesize the least FOUR behavior; enumerate every contextual occurrence; and verify the separate sovereign assembly is exact and total. An equivalence judgment invokes the equivalence primitives and returns an attributable equivalence receipt; a typed-residue judgment invokes the route primitives and returns an attributable residue receipt; a WIT-transition judgment invokes the effect-cover primitive and returns an attributable WIT receipt. Each receipt binds exact inputs, result, and replay material, and producer identity neither proves nor disproves correctness."))
