#lang rmn/v2
(map
  ("type" "WitTransitionAssayLowLevelDesign")
  ("version" 2)
  ("precondition" "FAB-R001, FAB-R009, FAB-R015, FAB-R019, and FAB-R024 define WIT transition assay as the distinct SAS module M11 judgment; proposal and completion are already well-typed immutable RMN effect cells and evidence has one ni identity.")
  ("operation" "Accept one canonical typed request over signed A2A containing exactly proposal cell, completion cell, and evidence identity; require every identity-bearing effect field to remain equal; require completion evidenceRoot to equal the supplied evidence; require exactly one positiveEvidence or negativeEvidence bit to move from false to true with no retraction; construct one typed grounded WIT term; bind exact request, proposal, completion, evidence, outcome, witness, provider account, law, and profile in a deterministic relational RMN receipt; append the receipt through hired RWIL/RDF.")
  ("postcondition" "One org.emsenn.obsmetrology.wit-transition-assay.v1 receipt proves from evidence exactly one witnessed distinction attributable to the signed provider account. Producer identity neither proves nor disproves correctness. The result does not execute the customer operation, decide truth, normalize arbitrary programs, mint a bearer asset, collapse WIT into payment, or accept the parent circuit.")
  ("refusal" "Refuse noncanonical or wrongly typed requests, zero-bit, two-bit, downward, or already-set transitions, changed law, caller, provider, operation, precondition, postcondition, refusal, parent, or measures, evidence substitution, unsigned provider use, provider-account drift, unavailable RWIL, a request to execute or judge the operation, or fallback to the general RMN normalizer.")
  ("position" (map ("sas" "M11") ("implementation" "wit-transition-assay") ("account" "eip155:31337:0x0aadad1c6a71d34f89dad0cb41a75603433a6071") ("law" "ni:///sha-256;7LE0QclMlxeoBXyyJu9ghANQVmxr1nd-ydJq8tb6abc") ("a2a" "http://127.0.0.1:19827/.well-known/agent-card.json")))
  ("interfaces"
    ((map ("name" "assayWitTransition") ("input" "((proposal Effect, completion Effect), Evidence)") ("output" "provider-bound WitTransitionAssayReceipt") ("errors" ("malformed-wit-transition" "operation-not-owned" "unsigned-provider" "rwil-unavailable")))
     (map ("name" "signed circuit interface") ("input" "standard Agent Card discovery with required sovereign circuit extension") ("output" "one leaf pinout owned by the provider smart account") ("errors" ("missing-required-extension" "invalid-signature" "provider-account-drift")))))
  ("vectors" ("positive cover" "negative cover" "true-to-both cover" "false-to-both cover" "zero-bit refusal" "two-bit refusal" "downward refusal" "effect identity drift refusal" "evidence substitution refusal" "signed receipt and account agreement" "RWIL append" "old normalizer refusal")))
