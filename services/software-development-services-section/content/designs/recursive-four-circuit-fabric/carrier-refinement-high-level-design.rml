#lang rmn/v2
(map
  ("type" "CarrierRefinementHighLevelDesign")
  ("version" 1)
  ("precondition" "SAS modules M2, M5, and M7 are admitted with FAB-R015, FAB-R017, and FAB-R020 allocated to independently hireable proof-profile-specific refinement providers and the layout consumer.")
  ("operation" "Separate language-neutral refinement identity, exact material binding, proof-profile execution, result comparison, canonical receipt, and layout admission into independently testable units.")
  ("postcondition" "A layout can admit one carrier only by consuming a canonical independent receipt proving that the exact observed material realizes the exact reachable component under every vector of one versioned profile.")
  ("refusal" "Refuse a caller-authored function label, producer self-attestation, carrier bytes not bound to their observed material root, partial vectors, profile drift, undeclared host authority, a universal language verifier, or layout code that interprets carrier internals.")
  ("units"
    ((map ("id" "M7-U1") ("name" "language-neutral refinement receipt") ("responsibility" "Normalize exact component, behavior, material, observation, proof-profile, vector-set, provider, and result identities as canonical RMN."))
     (map ("id" "M7-U2") ("name" "material binding") ("responsibility" "Recompute the profile carrier identity from supplied bytes and prove equality with one independently observed material root."))
     (map ("id" "M7-U3") ("name" "profile executor") ("responsibility" "Execute only the bounded ABI and host-authority envelope named by the exact proof profile."))
     (map ("id" "M7-U4") ("name" "behavior comparator") ("responsibility" "Compare every observed explicit FOUR output bit with the exact normalized component behavior row."))
     (map ("id" "M7-U5") ("name" "contracted assay face") ("responsibility" "Carry canonical refinement demands and receipts over A2A RMN-CBOR and append provider-owned receipt history through RWIL/RDF."))
     (map ("id" "M2-U9") ("name" "refinement-gated layout") ("responsibility" "Contract the selected independent profile provider for every mount, bind its receipt to the cover and component, and retain only receipt identities in the layout."))))
  ("interaction" "The customer submits an exact component, canonical carrier bytes, mode, and material observation. The profile provider recomputes the material root, validates the carrier ABI and authority envelope, executes every required vector, compares the result with the component, records the receipt, and returns it. Layout admits that mount only if the receipt identities match its independently verified cover and M1 family.")
  ("information" "Carrier bytes are fabrication material, not an alternative semantic representation. Component meaning remains normalized RMN. A refinement receipt is evidence of a relation between those two exact identities; it does not rename either object or create another ontology."))
