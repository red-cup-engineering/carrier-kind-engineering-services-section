#lang rmn/v2
(map
  ("type" "RmnCircuitBoardRefinementLowLevelDesign")
  ("version" 2)
  ("precondition" "Carrier Refinement HLD units M7-U1, M7-U2, M7-U4, and M7-U5 define the bounded recursive-netlist proof profile; the admitted material is one regular file and the admitted selected component is one composite reachable within a complete M1 family and sovereign assembly.")
  ("operation" "Normalize the selected component, full root circuit, child-definition library, and sovereign assembly; require the selected component to contain instances and nets and to be reachable in the verified family; encode that selected component as deterministic canonical typed RMN CBOR; require byte equality with the carrier; recompute its exact regular-file infomaterial root including mode; contract M1 for the exact containing family and assembly; and bind all exact identities in one canonical proof and one language-neutral refinement receipt.")
  ("postcondition" "The org.emsenn.infomaterial.rmn-circuit-board-carrier.v1 receipt proves that the observed file is exactly the selected normalized recursive netlist and that the family containing it has the declared M1 behavior under exact evidence; it carries no executable-leaf, deployment, occurrence-interior, or customer-acceptance claim. Producer identity neither proves nor disproves correctness.")
  ("refusal" "Refuse a leaf, unreachable component, missing child definition, invalid assembly, noncanonical bytes, bytes for another normalized component, material-root drift, unavailable, drifting, unattributed, or unreplayable M1 evidence, customer mutation, function label, or any attempt to treat this profile as an executable language runtime.")
  ("limits" (map ("maximum-carrier-bytes" 4194304) ("root-circuits" 1) ("selected-components" 1) ("material-files" 1)))
  ("evidence" "Tests must accept a canonical composite carrier, refuse changed carrier bytes, refuse a leaf, refuse an unreachable component, refuse absent exact M1 evidence, replay the declared family result, and prove that layout selects this profile for composite boards while selecting a separate executable profile for leaf dies."))
