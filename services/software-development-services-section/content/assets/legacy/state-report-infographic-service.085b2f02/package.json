{
  "name": "@emsenn/state-report-infographic-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Purpose-specific operation of the accepted deterministic state-report infographic software.",
  "bin": {
    "solicit-service": "./src/contract-state-report-infographic.mjs",
    "invoke-service": "./src/contract-state-report-infographic.mjs",
    "accept-result": "./src/contract-state-report-infographic.mjs"
  },
  "scripts": {
    "check": "node --check src/contract-state-report-infographic.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@emsenn/rwil-rdf-services": "file:../../../../../lenticule-science/services/obsmetrological-services-section/services/rwil-rdf-services"
  },
  "x-agentic-metro-enterprise": {
    "node-id": "state-report-infographic-service",
    "actor": "urn:ame:state-report-infographic-service",
    "owner": "software-development-services-section",
    "membrane": { "law": "lib/", "lasting-instances": "content/", "append-only-instances": "data/" },
    "admission": "direct ActivityStreams contracting plus an exact customer-accepted implementation admission",
    "refusal": "untyped packet, caller-selected implementation controls, absent or replayed capability, source-digest drift, or non-customer result decision",
    "operation-catalog": {
      "solicit-service": { "contract": "state-report-infographic", "accepts": "Offer<ServiceSolicitation>", "returns": "Offer<StateReportInfographicOffer>|Reject" },
      "invoke-service": { "contract": "state-report-infographic", "accepts": "Accept<ServiceContract>", "returns": "Accept<ProposedStateReportInfographicProduct>|Reject" },
      "accept-result": { "contract": "state-report-infographic", "accepts": "Accept|Reject<StateReportInfographicCustomerDecision>", "returns": "Accept<CustomerDecisionReceipt>|Reject" }
    }
  }
}
