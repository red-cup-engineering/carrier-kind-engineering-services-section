{
  "name": "@red-cup-engineering/land-contracts-services-section",
  "version": "0.1.0",
  "type": "module",
  "description": "Land contracts: finding property whose owners are likely to sell, in any county with open parcel data and of any kind (infill lots, underbuilt sites, lake and rural land, houses their owners do not live in, forfeited parcels), putting it under assignable purchase agreement, and assigning the agreement to a matched buyer.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "node --check src/*.mjs scripts/*.mjs",
    "call-lists": "node scripts/pull-call-lists.mjs"
  },
  "exports": {
    "./leads": "./src/leads.mjs",
    "./pipeline": "./src/pipeline.mjs",
    "./operations": "./src/operations.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "package.json",
    "src",
    "scripts",
    "content",
    "lib"
  ],
  "dependencies": {
    "@red-cup-engineering/arcgis-rest-services-section": "workspace:*",
    "@red-cup-engineering/computer-code-engineering-services-section": "workspace:*",
    "@red-cup-engineering/computer-system-engine": "workspace:*",
    "@red-cup-engineering/csv-services-section": "workspace:*",
    "@red-cup-engineering/json-schema-services-section": "workspace:*",
    "@red-cup-engineering/organizing": "workspace:*",
    "@red-cup-engineering/ssrs-report-services-section": "workspace:*"
  },
  "sideEffects": false
}
