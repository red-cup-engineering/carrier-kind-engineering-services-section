{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.561.group/@red-cup-engineering/derive-hive-account-ledger-service/schema/derive-hive-account-ledger.input.schema.json",
  "title": "deriveHiveAccountLedgerInput",
  "type": "object",
  "required": [
    "account",
    "rangeStart",
    "rangeEnd",
    "custodyAccount",
    "openingBalances",
    "chainClosingBalances"
  ],
  "properties": {
    "account": {
      "type": "string",
      "minLength": 1
    },
    "rangeStart": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rangeEnd": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "custodyAccount": {
      "type": "string",
      "minLength": 1
    },
    "hiveEngineCustodyAccount": {
      "type": "string"
    },
    "hiveOperations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "hiveEngineEntries": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "hiveEngineFills": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "openingBalances": {
      "type": "object",
      "properties": {
        "hive": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
        },
        "hbd": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
        },
        "vests": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
        },
        "hiveEngine": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "hive",
        "hbd",
        "vests"
      ]
    },
    "chainClosingBalances": {
      "type": "object",
      "properties": {
        "hive": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
        },
        "hbd": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
        },
        "vests": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
        },
        "hiveEngine": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "hive",
        "hbd",
        "vests"
      ]
    }
  }
}
