#lang rmn/v2
(map
  ("type" "SemioticExchangeChainSoftwareArchitectureSpecification")
  ("version" 5)
  ("precondition" "The Change Control Board's approved protocol allocation (lib/emsenn/services/561-group/services/board-of-directors/services/executive-office/data/records/decision-records/protocol-allocation-for-the-orchestration-platform.json) stands: EAVT/Datom is the one source symbol and every other public standard is a channel code of it, never a second ontology. The settlement trace chain profile at ../../../../../../blockchain-services-section/content/profiles/eip155-5615610-settlement-trace-chain.rml is admitted at integration status. The Recursive FOUR/RMN Circuit Fabric architecture (../../../../../../software-development-services-section/content/designs/recursive-four-circuit-fabric/software-architecture-specification.rml) is the sibling architecture this one extends at the chain boundary and does not restate.")
  ("operation" "Extend the approved protocol allocation across the boundaries it left unallocated -- EVM settlement, capability delegation, metered payment, and agent-to-agent coordination -- so that the chain becomes the only durable home, every actuator becomes ephemeral, and the Semiotic Voxel is realizable only as an active arena that is never stored.")
  ("postcondition" "A module lead can design one boundary of the exchange chain against exactly one named public standard, with its durability, identity, authority, and payment laws already fixed, without inventing a second semantic center, without provisioning a permanent host, and without persisting a voxel.")
  ("refusal" "Refuse a durable local store presented as a home, a persisted or replayable Semiotic Voxel, a permanent actuator machine, an identifier used outside its typed role, a boundary allocated two standards, a standard adopted as an ontology rather than a channel code, a production claim on an integration-only chain, and any operation of the chain by this specifying section.")
  ("identification" (map ("system" "Semiotic Exchange Chain") ("revision" "5") ("date" "2026-07-29") ("issuer" "Semiotic Exchange Chain Services Section") ("requirements" "content/designs/semiotic-exchange-chain/requirements-baseline.rml")))
  ("stakeholders"
    ((map ("class" "Leader and acquirer") ("concerns" ("agent drift stopped by a fixed spec" "on-chain data rather than local data" "ephemeral runners rather than permanent machines" "cost collapse")))
     (map ("class" "Sovereign settlements") ("concerns" ("own chain" "own proper-time clock" "interior sovereignty" "refusal" "custody")))
     (map ("class" "Ephemeral actuators and autonomous agents") ("concerns" ("no key custody" "bounded delegated authority" "cold start with no local state" "observable failure")))
     (map ("class" "Federation peers in the semioverse") ("concerns" ("resolvable actor identity" "standard ActivityStreams shapes" "no privileged writer into a peer's pools")))
     (map ("class" "Protocol and chain providers") ("concerns" ("standard conformance" "finality" "replay protection" "version pinning")))
     (map ("class" "Players in an arena") ("concerns" ("the voxel is live while played" "position is causally closed" "the path walked is rigid")))))
  ("viewpoints"
    ((map ("name" "source-symbol") ("concerns" ("meaning" "identity" "provenance" "supersession")) ("models" ("EAVT row" "Datom retract/assert journal" "RMN content address" "channel-code projection")))
     (map ("name" "durability-and-residence") ("concerns" ("what is a home" "what is a cache" "what may be lost")) ("models" ("chain-resident state" "RWIL witness anchor" "evictable local projection")))
     (map ("name" "voxel-liveness") ("concerns" ("active-only existence" "arena closure" "structural rigidity")) ("models" ("polarized prime event structure" "Lorentzian cone to the semantics/syntax cocone" "pebble game")))
     (map ("name" "membrane-and-authority") ("concerns" ("who may act" "at whose cost" "across which boundary")) ("models" ("UCAN delegation chain" "CapTP/OCapN object invocation" "x402 price gradient" "ERC-4337 smart account and paymaster" "redox tally")))
     (map ("name" "federation-and-coordination") ("concerns" ("inter-enterprise messaging" "intra-enterprise dispatch" "agency face")) ("models" ("AP(CE(A2A(RMN)))" "WMAP C2S agency" "A2A agent card")))
     (map ("name" "verification") ("concerns" ("lawfulness" "conformance" "adversarial survival")) ("models" ("mathematical token" "standard conformance result" "execution receipt" "adversarial trace")))))
  ("modules"
    ((map ("id" "SXC-M1") ("name" "Source symbol kernel") ("owner" "Model Services Section / RMN Semantic Conformance") ("responsibility" "Own the one source symbol: the EAVT row, its Datom journal form, and its RMN content address. Project every other named standard as a channel code of that source and refuse any standard offered as a competing ontology. Do not own residence, authority, or payment.") ("requirements" ("SXC-R001" "SXC-R002" "SXC-R003")))
     (map ("id" "SXC-M2") ("name" "Settlement chain seam") ("owner" "Blockchain Services Section") ("responsibility" "Provide the exchange chain's ordering, finality, replay protection, smart accounts, bundling, and paymaster policy against the admitted chain profile; carry the integration-to-production cutover from eip155:5615610 to the reserved eip155:561561 without either being presented as the other. Do not own meaning.") ("requirements" ("SXC-R004" "SXC-R005" "SXC-R006")))
     (map ("id" "SXC-M3") ("name" "RWIL chain anchoring") ("owner" "Knowledge Services Section with Blockchain Services Section") ("responsibility" "Make the Relation-Witness Information Log write through to the settlement chain, so that a witness is settled on-chain and every data/rwil directory becomes an evictable projection of chain state rather than the residence of that state. Own the fold/unfold between chain-anchored journal and local projection.") ("requirements" ("SXC-R007" "SXC-R008")))
     (map ("id" "SXC-M4") ("name" "Semiotic Voxel arena") ("owner" "Capability Services Section") ("responsibility" "Realize the arena as an active-only structure: the player-opponent board whose position is causally closed under each move, whose rigidity is discharged by a qualified pebble-game judgment over that exact cone, and which exists only while played. Emit boundary transactions; never emit a stored voxel. Own no durable state of its own.") ("requirements" ("SXC-R009" "SXC-R010" "SXC-R011")))
     (map ("id" "SXC-M5") ("name" "WMAP agency face") ("owner" "Web Services Section / ActivityPub Services Section") ("responsibility" "Provide the Web Modeled Agency Protocol face -- AP(CE(A2A(RMN))) between sovereign enterprises and the WMAP client-to-server social API for agency -- carrying settlement-triggered publication out of the chain and admitting inbound activity only through the receiving enterprise's own admission. A sender never writes a peer's pools.") ("requirements" ("SXC-R012" "SXC-R013" "SXC-R014")))
     (map ("id" "SXC-M6") ("name" "Capability and payment membrane") ("owner" "Cryptographic Services Section with Resource Brokerage Service Section") ("responsibility" "Own the redox boundary: a standards-suite UCAN delegation from the current controller principal to an ephemeral pairwise actor over the did:pkh EnterpriseAccount resource, x402 as the price gradient on boundary crossing, and the pairing rule by which unmatched commitments become one settled tally. Separately verify through ERC-1271 at an explicit finalized block that the UCAN issuer currently controls the resource for the exact invocation context; controller rotation requires a fresh observation and invalidates any prior admission receipt. Never pretend the contract account signed with a private key it cannot possess. Refuse ambient authority and durable custody held by an actuator.") ("requirements" ("SXC-R015" "SXC-R016" "SXC-R017")))
     (map ("id" "SXC-M7") ("name" "Ephemeral actuator fabric") ("owner" "GCloud Services Section") ("responsibility" "Run every actuator as a cold-start, stateless, disposable runner that holds only a pairwise invocation key and its bounded delegation in volatile memory, never durable/root keys, funds, or local durable state. Its sole purpose is to agitate the chain and its loss costs nothing but the in-flight call. Own the elimination of permanent hosts, pidfiles, local databases, and host-resident cron.") ("requirements" ("SXC-R018" "SXC-R019")))
     (map ("id" "SXC-M8") ("name" "A2A coordination face") ("owner" "Web Services Section / A2A Services Section") ("responsibility" "Provide the version-pinned A2A operation face, signed Agent Cards, exact RMN parts, and correlation law. Internal dispatch may carry A2A directly; federation carries the same operation inside CloudEvents and ActivityPub through SXC-M5. A2A never bypasses the receiving enterprise's admission.") ("requirements" ("SXC-R020")))))
  ("budgets"
    ((map ("name" "residence") ("allocation" "Chain-resident state is the only home; every local store is an evictable projection. Zero tolerated durable local state whose loss is unrecoverable from the chain."))
     (map ("name" "voxel-liveness") ("allocation" "Zero persisted voxels. An arena that can be restored from storage rather than replayed from its boundary transactions is a defect, not an optimization."))
     (map ("name" "actuator-custody") ("allocation" "Zero durable/root keys and zero funds held by any actuator. A runner may hold one pairwise invocation key and bounded delegation only in volatile memory for that invocation; all cost is borne by a paymaster under policy."))
     (map ("name" "identifier") ("allocation" "Identifiers are plural and role-typed: an RMN content address names the semantic subject; did:pkh:eip155 names a durable smart-account jural/economic locus; did:key names an ephemeral pairwise actor, device, or runner. None may stand in for another. A bare CAIP-10 string, permanent human did:key, did:pkh-as-human, or content address used as a signing principal is refused."))
     (map ("name" "boundary-allocation") ("allocation" "Exactly one public standard per boundary. Zero boundaries carrying two competing standards, and zero standards adopted as ontologies."))
     (map ("name" "verification") ("allocation" "Every claimed move carries both hands: a re-executable mathematical lawfulness token and a version-pinned public-standard conformance result, followed by the exact execution receipt and adversarial trace appropriate to the effect. Producer identity neither proves nor disproves the claim."))))
  ("decisions"
    ((map ("decision" "Extend the approved protocol allocation rather than open a second one.") ("alternatives" ("a fresh allocation for the chain" "per-module boundary choices" "no allocation")) ("rationale" "The Change Control Board already ruled one standard per boundary over an EAVT source symbol; the chain, capability, and payment boundaries were simply never allocated. Opening a second allocation would create the competing center the first one forbids."))
     (map ("decision" "The chain is the only durable home; local data is cache.") ("alternatives" ("local-first with chain as backup" "dual-write" "chain as index over local files")) ("rationale" "Local residence is what lets an actuator become a machine, and a machine is what makes the actuator permanent. Demoting local stores to evictable projections removes the lattice site an ephemeral runner has not earned."))
     (map ("decision" "The Semiotic Voxel exists only actively and is never persisted.") ("alternatives" ("snapshot the arena" "event-source the arena into a store" "cache positions for resume")) ("rationale" "The voxel is the cone over the semantics/syntax cocone -- it is constituted by being played, not by being recorded. A stored voxel is a photograph of an arena presented as the arena, and admitting one would make every downstream liveness property unprovable."))
     (map ("decision" "Identity is a typed plurality: RMN names the semantic subject, did:pkh names the durable EnterpriseAccount settlement locus, and cryptosuite-appropriate DIDs name the principals exercising bounded capabilities.") ("alternatives" ("one DID for every role" "did:key as permanent human or enterprise identity" "did:pkh contract as if it held a private signing key" "did:web anchored at a permanent host" "bare CAIP-10 strings")) ("rationale" "Meaning, jural residence, and acting agency are different coordinates. RMN semantic identity survives any key or account rotation. The did:pkh locus identifies the EnterpriseAccount resource and its chain-native settlement law without pretending the account is a human, device, or private-key principal. A pairwise did:key principal gives UCAN a self-certifying P-256, Ed25519, passkey, or HSM-backed actor with no permanent resolver, and the did:key specification recommends that method for short-lived sessions rather than long-lived high-value identity. UCAN 1.0 requires a token to be signed with a key associated with its issuer DID and declares private algorithms off-spec, so the current controller's standards-suite DID issues the delegation to the ephemeral actor over the did:pkh resource. A separate finalized ERC-1271 observation proves that issuer currently controls the EnterpriseAccount. The human or enterprise subject remains an RMN term related to all coordinates, not collapsed into any of them."))
     (map ("decision" "Actuators hold no durable/root keys or funds; a pairwise invocation key exists only for one bounded delegation and cost is borne by a paymaster.") ("alternatives" ("actuator-held EOA" "shared hot wallet" "ambient service credentials" "permanent did:key actor")) ("rationale" "ERC-4337 smart accounts with an ERC-7677 paymaster and a short-lived UCAN delegation to a pairwise did:key make a runner disposable. EnterpriseAccount policy remains outside the runner and is validated through ERC-1271; losing a runner leaks only the narrow authority until its short expiry and strands no funds."))
     (map ("decision" "Each sovereign settlement may name its own chain and its own proper-time clock.") ("alternatives" ("one Union chain" "a global clock" "a central registry of settlements")) ("rationale" "Settlements with no cross-settlement transaction are spacelike-separated and have no forced order; imposing one chain would manufacture a largest interior and the central third hand the constitution forbids. Chains form a forest, not a trunk."))
     (map ("decision" "Structural rigidity of a traversal is discharged by the pebble game, not by trust.") ("alternatives" ("assume the path holds" "post-hoc failure detection" "a static dependency graph")) ("rationale" "Pebbles track which constraints are placed and which remain mobile, making the difference between a load-bearing route and a floppy one decidable before the traversal rather than after it fails."))
     (map ("decision" "This section specifies and does not operate.") ("alternatives" ("build the chain here" "host the actuators here" "own the federation endpoint here")) ("rationale" "Operation belongs to the modules allocated above. Keeping this section placement-neutral prevents it from becoming another competing implementation; correctness comes from the move's executable mathematical and standards evidence, not from excluding its author."))))
  ("known-inconsistencies"
    ((map ("id" "INC-001") ("statement" "The admitted chain profile carries productionEligible false and status integration; eip155:5615610 orders integration-only commitments while eip155:561561 stands reserved and unstood. No module may present current chain settlement as production authority until that cutover is admitted."))
     (map ("id" "INC-002") ("statement" "Development accounts remain seated at eip155:31337 in at least the metered-inference-tollbooth and the RMN conformance service (content/evm/accounts/eip155-31337.json in each), contradicting the admitted trace chain profile. The sibling fabric architecture already carries this as its own INC-002; it is now resolvable against a live chain and is the first cut wave below."))
     (map ("id" "INC-003") ("statement" "The plural identifier law this architecture adopts is not yet ratified. The only seated ruling remains the-firms-did-method (did:web at emsenn.net, decided 2026-07-16, never amended), whose permanent .well-known resolver contradicts the residence budget. Existing capcell records use did:pkh as if it were a general controller identity and must be retyped as durable jural/economic loci, while ephemeral actors need pairwise did:key principals and RMN terms remain the semantic subjects. The change control ruling must be replaced, not shimmed."))
     (map ("id" "INC-007") ("statement" "The finance path hardcodes FINANCE_SETTLEMENT as a bare CAIP-10 string pinned to eip155:31337. A settlement locus must be projected as did:pkh on the admitted chain and related to, never substituted for, the RMN semantic subject and current pairwise actor."))
     (map ("id" "INC-008") ("statement" "ActivityPub federation still requires an HTTPS actor document with inbox and outbox. Neither did:pkh nor did:key removes that protocol surface or becomes the ActivityPub actor by equivalence. SXC-M5 must project the actor document ephemerally from RMN subject relations, current admitted actor keys, and settlement loci without making the HTTPS projection authoritative."))
     (map ("id" "INC-004") ("statement" "RWIL presently writes to local data/rwil directories across dozens of nodes with no chain anchor, so local state is today the residence rather than the projection. SXC-M3 is unrealized and the residence budget is therefore unmet everywhere until it lands."))
     (map ("id" "INC-005") ("statement" "WMAP exists as research notes and a C2S social API plan only, never realized as code. The settlement-triggered-activity-publication-cell exists as the chain-to-ActivityPub direction; the agency face and the inbound admission path do not."))
     (map ("id" "INC-006") ("statement" "Existing A2A dependencies include prerelease SDK use; SXC-M8 must pin a production-supported profile and exact external artifact identity before any boundary depends on it."))
     (map ("id" "INC-009") ("statement" "Animating now verifies official @ucanto/core@10.4.6 Delegation/Invocation proof DAGs and emits canonical RMN UcanInvocationVerificationReceipt terms, while its former RSA carrier has been retyped as an ActivityPubRsaCapabilityEnvelope. The selected ucanto artifact nevertheless encodes wire version 0.9.1, not a token whose own version field says 1.0. Until the change-control profile states whether R015 means the UCAN 1.0 specification family or requires a literal 1.0 wire version, receipts MUST expose ucanVersion 0.9.1 and MUST NOT claim literal wire-version 1.0 conformance."))))
  ("cut-graph"
    ("plural RMN-subject / did:pkh-locus / did:key-actor law replaces the-firms-did-method"
     "eip155:31337 accounts and the finance settlement binding cut to the admitted trace chain profile"
     "RWIL chain anchoring, local rwil demoted to projection"
     "capability and payment membrane, actuators stripped of keys and funds"
     "ephemeral actuator fabric, permanent hosts deleted wave by wave"
     "WMAP agency face and inbound admission"
     "Semiotic Voxel arena realized active-only"
     "integration-to-production chain cutover")))
