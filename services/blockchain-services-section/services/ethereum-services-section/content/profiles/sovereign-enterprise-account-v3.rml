#lang rmn/v2
(map
  ("type" "SovereignEnterpriseAccountProfile")
  ("version" 3)
  ("precondition" "typed RMN core v3 effect, canonical ERC-4337 EntryPoint v0.8, and settlement-owned policy authority")
