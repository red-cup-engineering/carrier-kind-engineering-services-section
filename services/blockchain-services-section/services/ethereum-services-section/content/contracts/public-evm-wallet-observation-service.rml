#lang rmn/v2
(map
  ("type" "PublicEvmWalletObservationLaw")
  ("version" 2)
  ("provider" "urn:ame:ethereum-services-section")
  ("precondition" "A sovereign customer supplies either one public CAIP-10 account for a supported protocol scope or a bounded finite set of public EVM CAIP-10 accounts with explicit credential-free chain and discovery sources, plus a nonempty intended use, then accepts the provider's exact normalized source-observation digest and unpriced terms.")
  ("operation" "The provider reads public EVM and protocol indexes, treats index metadata only as untrusted discovery, verifies discovered code, proxy slots, balances, and NFT ownership at explicit chain snapshot blocks, and witnesses one complete or explicitly partial observation without credentials, signing, transaction assembly, broadcast, approval, or asset movement.")
  ("postcondition" "The provider and customer retain their own witnessed records; the response binds the exact public accounts, source and transport disclosures, snapshot blocks, verification completeness, contract code and proxy evidence, normalized protocol positions where requested, interpretation limits, typed resource vector, and service receipt.")
  ("refusal" "Refuse secrets or signer material, unsupported chains or scopes, non-CAIP accounts, credential-bearing or mismatched sources, changed observation or terms, customer mutation, transaction authority, all-source failure, or a capability broader than public reads and provider-local evidence.")
  ("protocol" "ActivityStreams-2.0")
  ("evidence" "WITNESS-JOURNAL-RDF"))
