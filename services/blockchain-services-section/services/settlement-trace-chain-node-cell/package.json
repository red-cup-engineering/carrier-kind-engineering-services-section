{
  "name": "@red-cup-engineering/settlement-trace-chain-node-cell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A2A status capability cell for the live Settlement Trace Chain (chain ID enforced in lib/status.mjs).",
  "repository": {
    "type": "git",
    "url": "https://github.com/emsenn/settlement-trace-chain-node-cell.git"
  },
  "bin": {
    "serve-settlement-trace-chain-a2a": "./bin/server.mjs"
  },
  "exports": {
    ".": "./lib/status.mjs",
    "./protocol": "./lib/protocol.mjs"
  },
  "scripts": {
    "check": "node --check lib/law.mjs && node --check lib/status.mjs && node --check lib/protocol.mjs && node --check bin/execute-a2a-task.mjs && node --check bin/server.mjs",
    "legacy:anvil:check": "node --check legacy/anvil/bin/run-chain.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.4",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.0",
    "@red-cup-engineering/rmn-semantic-conformance": "6.0.1"
  },
  "license": "UNLICENSED"
}
