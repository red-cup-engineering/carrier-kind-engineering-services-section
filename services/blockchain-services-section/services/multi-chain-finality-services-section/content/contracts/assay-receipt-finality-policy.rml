#lang rmn/v2
(map
  ("type" "ReceiptFinalityPolicyAssayLaw")
  ("version" 1)
  ("provider" "urn:ame:multi-chain-finality-services-section")
  ("precondition" "A customer supplies one EVM CAIP-2 receipt identity as chain ID, block hash, transaction hash, and log index; one exact per-chain receipt-finality policy; one provider-authored offer; and one attenuated single-use invocation capability. The observation RPC is a public endpoint without embedded credentials.")
  ("operation" "Observe the transaction receipt independently; require successful execution, the exact canonical block hash, and the exact log index; observe either the EVM finalized block or an exact positive confirmation threshold; classify the settling regime and boundary kind; and compare the receipt block with that boundary without mutating the chain or customer.")
  ("postcondition" "Return one provider-authored receipt-finality-policy assay carrying the canonical receipt key, observed block number, observed-through boundary, boundary kind, settling regime, exact policy identity, positive evidence, and no negative evidence. A confirmation threshold is explicitly Scott-continuous evidence and is never represented as protocol finality. Append the provider act through its contracted RWIL/RDF boundary.")
  ("refusal" "Refuse a non-CAIP chain, malformed receipt identity, absent or failed receipt, changed block hash, absent log, unrecognized or insufficient finality boundary, credential-bearing RPC endpoint, changed request, changed offer, overbroad capability, customer mutation, chain mutation, or unavailable provider-owned witness boundary."))
