[Unit]
Description=Bare Cedar Fog Clockkeeper signed A2A provider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/emsenn/info/lib/emsenn/services/561-group/services/board-of-directors/services/executive-office/services/working-services-section/services/clockkeeper-service
Environment=PORT=8807
Environment=HOST=127.0.0.1
Environment=BASE_URL=http://127.0.0.1:8807
Environment=CLOCKKEEPER_ACTOR=urn:ame:clockkeeper-service
Environment=WITNESS_JOURNAL_RDF_AGENT=http://127.0.0.1:19764/.well-known/agent-card.json
Environment=A2A_BEARER_TOKEN_FILE=/home/emsenn/.local/share/emsenn/a2a/clockkeeper-cloud-compute-services-section.token
Environment=A2A_BEARER_USER=urn:ame:cloud-compute-services-section
Environment=AGENT_CARD_SIGNING_KEY=/home/emsenn/info/lib/emsenn/services/561-group/services/board-of-directors/services/executive-office/services/working-services-section/services/clockkeeper-service/data/agent-card-signing/ed25519-private.pem
Environment=AGENT_CARD_JWKS=/home/emsenn/info/lib/emsenn/services/561-group/services/board-of-directors/services/executive-office/services/working-services-section/services/clockkeeper-service/content/agent-card-signing/jwks.json
Environment=AGENT_CARD_SIGNING_KID=clockkeeper-service-2026-07-21
ExecStart=/home/emsenn/.config/nvm/versions/node/v24.13.1/bin/node bin/serve-a2a.mjs
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
