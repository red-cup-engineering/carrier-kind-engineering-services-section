  },
  "exports": {
    "./leads": "./src/leads.mjs",
    "./pricing": "./src/pricing.mjs",
    "./report": "./src/report.mjs",
    "./operations": "./src/operations.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "package.json",
    "src",
    "scripts",
    "content",
    "lib"
  ],
  "dependencies": {
    "@red-cup-engineering/computer-code-engineering-services-section": "workspace:*",
    "@red-cup-engineering/computer-system-engine": "workspace:*",
    "@red-cup-engineering/csv-services-section": "workspace:*",
    "@red-cup-engineering/json-schema-services-section": "workspace:*",
    "@red-cup-engineering/organizing": "workspace:*",
    "@red-cup-engineering/propublica-nonprofit-explorer-services-section": "workspace:*",
    "@red-cup-engineering/usaspending-services-section": "workspace:*",
    "@red-cup-engineering/computer-data-services-section": "workspace:*"
  },
  "sideEffects": false
}
