# Per-machine git defaults applied to every wrapper invocation via
# GIT_CONFIG_GLOBAL. Edit per machine; scripts/git-services hardcodes none of this.
[user]
	name = emsenn
	email = morgan.sennhauser@gmail.com
[core]
	editor = true
	fsmonitor = false
	hooksPath = /dev/null
[gc]
	auto = 0
[credential "https://github.com"]
	helper = !/usr/bin/gh auth git-credential
[pager]
	status = false
	diff = false
	log = false
[fetch]
	recurseSubmodules = false
[push]
	default = simple
