#!/bin/sh
# Managed git for shared machines.
#
# Why this exists: many agents running git at once against one tree killed
# this machine's disk. So: every write serializes through one lock, reads
# pass straight through, and the two shapes that let one agent destroy
# another's in-flight work (ambient staging, unscoped commits) are refused.
#
# Everything machine-specific lives in etc/machine.conf and
# etc/managed.gitconfig next to this script. Edit those, not this file.
set -eu

self=$(readlink -f "$0")
script_dir=${self%/*}
etc_dir=${script_dir%/*}/etc
conf=${MANAGED_GIT_CONF:-$etc_dir/machine.conf}
if [ ! -f "$conf" ]; then
  echo "managed git: missing machine config $conf" >&2
  exit 78
fi
. "$conf"
# Machine-specific identity travels to the tools this wrapper runs, so shared
# software carries no colony constant of its own.
[ -n "${colony_actor:-}" ] && export COLONY_ACTOR="$colony_actor"
managed_gitconfig=$etc_dir/${managed_gitconfig_name:-managed.gitconfig}

physical_pwd=$(pwd -P)
case "$physical_pwd/" in
  "$repo_root/" | "$repo_root"/*/) ;;
  *)
    echo "managed git: denied: $physical_pwd is outside $repo_root (policy: $conf)" >&2
    exit 126
    ;;
esac
case "${1-}" in
  -C|--git-dir|--work-tree|--exec-path|--config-env|-c|--bare|--namespace|--super-prefix)
    echo "managed git: denied: repository overrides are not allowed; cd into the repository instead (policy: $conf)" >&2
    exit 126
    ;;
esac

command_name=${1-}

word_in_list() {
  needle=$1
  shift
  for word in "$@"; do
    [ "$word" = "$needle" ] && return 0
  done
  return 1
}

# Ambient staging sweeps other agents' worktree changes into your index.
if [ "$command_name" = add ] && [ "${forbid_ambient_add:-true}" = true ]; then
  separator_seen=false
  named_path_seen=false
  for argument in "$@"; do
    if [ "$separator_seen" = true ]; then
      case "$argument" in
        .|\*)
          echo "managed git: denied: 'git add $argument' stages ambient work; add named paths (policy: $conf)" >&2
          exit 126
          ;;
        *) named_path_seen=true ;;
      esac
      continue
    fi
    if [ "$argument" = -- ]; then
      separator_seen=true
      continue
    fi
    case "$argument" in
      .|\*)
        echo "managed git: denied: 'git add $argument' stages everything, including other agents' in-flight work; add named paths (policy: $conf)" >&2
        exit 126
        ;;
    esac
  done
  for argument in "$@"; do
    case "$argument" in
      -A|--all)
        if [ "$named_path_seen" != true ]; then
          echo "managed git: denied: 'git add $argument' requires '--' followed by named paths (policy: $conf)" >&2
          exit 126
        fi
        ;;
    esac
  done
fi

# An unscoped commit absorbs whatever another process staged since you did.
# Completing a merge, cherry-pick, or revert is exempt: git itself refuses
# path-limited commits in those states.
if [ "$command_name" = commit ] && [ "${require_scoped_commit:-true}" = true ]; then
  state_dir=$(/usr/bin/git -C "$physical_pwd" rev-parse --absolute-git-dir 2>/dev/null || printf '%s' "$physical_pwd/.git")
  if [ ! -e "$state_dir/MERGE_HEAD" ] && [ ! -e "$state_dir/CHERRY_PICK_HEAD" ] && [ ! -e "$state_dir/REVERT_HEAD" ]; then
    scoped=false
    for argument in "$@"; do
      [ "$argument" = "--" ] && scoped=true
      case "$argument" in --pathspec-from-file|--pathspec-from-file=*) scoped=true ;; esac
    done
    if [ "$scoped" = false ]; then
      echo "managed git: denied: commit named paths ('git commit -m msg -- path...' or --pathspec-from-file) so a concurrent agent's staging is not swept in (policy: $conf)" >&2
      exit 126
    fi
  fi
fi

acquire_write_lane() {
  lock_parent=${lock_file%/*}
  mkdir -p "$lock_parent"
  # Keep this descriptor open across exec so the admitted write owns the
  # lane for its full lifetime.
  exec 9>"$lock_file"
  flock -w "${lock_wait_seconds:-300}" 9
}

reclaim_witnessed_orphan_index_lock() {
  # Outside any repository (e.g. init) there is no index lock to reclaim.
  index_lock=$(/usr/bin/git -C "$physical_pwd" rev-parse --git-path index.lock 2>/dev/null) || return 0
  [ -e "$index_lock" ] || return 0
  # Without fuser the live-holder half of the orphanhood evidence is
  # unobtainable; age alone must not authorize deleting a possibly-live lock.
  if ! command -v fuser >/dev/null 2>&1; then
    echo "managed git: deferred: cannot witness lock liveness (fuser unavailable) for $index_lock" >&2
    return 75
  fi
  if fuser -s "$index_lock"; then
    echo "managed git: deferred: live index lock witnessed at $index_lock" >&2
    return 75
  fi
  modified_at=$(stat -c %Y "$index_lock")
  now=$(date +%s)
  age=$((now - modified_at))
  if [ "$age" -lt "${stale_index_lock_seconds:-300}" ]; then
    echo "managed git: deferred: unwitnessed index lock is only ${age}s old at $index_lock" >&2
    return 75
  fi
  # Re-check immediately before removal, while the write lane is exclusively
  # held: no live descriptor plus bounded age is the evidence of orphanhood.
  if fuser -s "$index_lock"; then
    echo "managed git: deferred: live index lock witnessed at $index_lock" >&2
    return 75
  fi
  rm -f -- "$index_lock"
  echo "managed git: reclaimed witnessed orphan index lock age=${age}s path=$index_lock" >&2
}

if word_in_list "$command_name" $write_commands; then
  acquire_write_lane
  reclaim_witnessed_orphan_index_lock
  exec_git() { exec /usr/bin/env -i \
    HOME="$home_dir" \
    PATH=/usr/bin:/bin \
    GH_CONFIG_DIR="$home_dir/.config/gh" \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_CONFIG_GLOBAL="$managed_gitconfig" \
    GIT_CONFIG_SYSTEM=/dev/null \
    GIT_TERMINAL_PROMPT=0 \
    GIT_PAGER=cat \
    /usr/bin/git --no-optional-locks -C "$physical_pwd" "$@"; }
  exec_git "$@"
fi

if ! word_in_list "$command_name" $read_commands; then
  echo "managed git: denied: '$command_name' is in neither read_commands nor write_commands (policy: $conf)" >&2
  exit 126
fi

for argument in "$@"; do
  case "$argument" in
    --output|--output=*|--ext-diff|--textconv|--no-index|--config-env=*|--git-dir=*|--work-tree=*|--exec-path=*|-c)
      echo "managed git: denied: unsafe read option $argument (policy: $conf)" >&2
      exit 126
      ;;
  esac
done

run_git() {
  # Reads never take the write lane: with --no-optional-locks they need no
  # index lock, and a long history scan must not starve an admitted write.
  exec /usr/bin/env -i \
    HOME="$home_dir" \
    PATH=/usr/bin:/bin \
    GH_CONFIG_DIR="$home_dir/.config/gh" \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_CONFIG_GLOBAL="$managed_gitconfig" \
    GIT_CONFIG_SYSTEM=/dev/null \
    GIT_TERMINAL_PROMPT=0 \
    GIT_PAGER=cat \
    /usr/bin/git --no-optional-locks -C "$physical_pwd" "$@"
}

if [ "$command_name" = diff ]; then
  shift
  run_git diff --no-ext-diff --no-textconv "$@"
fi
run_git "$@"
