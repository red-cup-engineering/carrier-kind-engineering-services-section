#lang rmn/v2
(map
  ("type" "SemioticExchangeChainRequirementsBaseline")
  ("version" 1)
  ("precondition" "EAVT/Datom is the one source symbol; RMN is its canonical typed term and content address; public standards are boundary channel codes rather than competing semantic centers; the settlement trace chain remains integration-only until its production cutover is admitted.")
  ("operation" "Compose mathematical lawfulness tokens with their named public-standard claims so that sovereign actors can discover, purchase, execute, witness, and replay typed moves through disposable zero-custody actuators while the active arena remains unpersisted.")
  ("postcondition" "Every Semiotic Exchange Chain module has an exact requirement whose satisfaction is re-executable from canonical carriers, standard protocol evidence, chain events, and the mathematical token governing the move.")
  ("refusal" "Refuse a second ontology, an untyped carrier, a merely preserved but unverified authority or payment claim, browser-authored topology, locally resident authority, a persisted voxel, a production claim on the integration chain, and producer identity used either as proof or as automatic disqualification.")
  ("requirements"
    ((map ("id" "SXC-R001") ("text" "Every durable semantic assertion MUST unfold to EAVT rows and its amendment history MUST be an append-only Datom retract/assert journal; no channel codec may become another source of truth."))
     (map ("id" "SXC-R002") ("text" "Every cell, demand, offer, result, support claim, authority claim, and settlement-evidence term MUST have one normalized typed RMN representation, deterministic RFC 8949 CBOR bytes, SHA-256 digest, and RFC 6920 ni identity."))
     (map ("id" "SXC-R003") ("text" "Every public-standard projection MUST preserve the exact RMN identity and MUST either round-trip to the same canonical bytes or carry an explicit content-addressed reference to them."))
     (map ("id" "SXC-R004") ("text" "Every settlement operation MUST name an admitted CAIP-2 chain profile and MUST refuse to present eip155:5615610 integration evidence as eip155:561561 production authority."))
     (map ("id" "SXC-R005") ("text" "The settlement seam MUST derive ordering, replay protection, controller roles, law equality, and result finality from SemioticExchange contract execution and its strict block-number/log-index event order."))
     (map ("id" "SXC-R006") ("text" "Every contract actuation MUST execute through a policy-bound ERC-4337 smart account and its admitted paymaster policy; an actuator-held operational EOA is forbidden."))
     (map ("id" "SXC-R007") ("text" "Every admitted witness journal append MUST bind its canonical RMN identity to a settlement-chain witness from which the journal can be recovered without a resident writer."))
     (map ("id" "SXC-R008") ("text" "Every local witness journal, index, snapshot, or materialized view MUST be evictable and mechanically reconstructible from chain-anchored canonical history; loss of a local projection MUST lose no authoritative information."))
     (map ("id" "SXC-R009") ("text" "A Semiotic Voxel MUST exist only as the active reconstruction of a causally closed position and its current invocation; no voxel snapshot or browser-authored topology may be admitted."))
     (map ("id" "SXC-R010") ("text" "A traversal requiring rigidity MUST carry a qualified judgment from the named mathematical model over the exact causal cone; a grid-shaped surrogate result MUST NOT be represented as an atom/contact judgment without an explicit lossless type bridge."))
     (map ("id" "SXC-R011") ("text" "An arena transition MUST emit only canonical boundary transactions and receipts sufficient for later reconstruction; it MUST NOT emit, store, or restore the live arena itself."))
     (map ("id" "SXC-R012") ("text" "Federated RMN operations MUST use the existing ActivityPub(ActivityStreams Activity carrying CloudEvents 1.0 data carrying an A2A message carrying exactly one canonical RMN part) projection, abbreviated AP(CE(A2A(RMN)))."))
     (map ("id" "SXC-R013") ("text" "An inbound federated operation MUST pass the receiving sovereign enterprise's ActivityPub addressing and signature policy, CloudEvents profile checks, A2A role and Agent Card checks, exact RMN byte and ni checks, and operation-specific admission before it may request a chain append."))
     (map ("id" "SXC-R014") ("text" "The WMAP client-to-server face MUST expose only the receiving enterprise's derived restricted arena and admitted agency operations; neither a client nor a federation peer may write topology, pools, or another enterprise's interior state."))
     (map ("id" "SXC-R015") ("text" "Every effectful invocation MUST carry a UCAN 1.0 Delegation signed by the current controller's standards-supported DID to an ephemeral pairwise did:key actor over the durable EnterpriseAccount did:pkh resource, plus a proof-linked Invocation by that actor. Admission MUST verify proof CIDs, exact with/can/nb attenuation, integer nbf/exp, current revocation/status, and a separate ERC-1271 receipt at an explicit finalized block proving that the UCAN issuer currently controls the did:pkh resource for this exact delegation and invocation context. A controller or policy-signer rotation MUST require a fresh binding observation and MUST invalidate the prior receipt for any later admission. The principal and resource DIDs MUST NOT be treated as equivalent, and an off-spec signature algorithm or custom signed capability envelope MUST NOT be labeled conformant UCAN."))
     (map ("id" "SXC-R016") ("text" "Every paid boundary crossing MUST bind one verified x402 challenge, payment, and successful settlement receipt to the exact invocation, network, asset, amount, payer, and payee; preserving an x402-shaped payload is not payment verification."))
     (map ("id" "SXC-R017") ("text" "CapTP or OCapN references MAY carry live object invocation authority only through their canonical verifier and MUST remain distinct from UCAN delegation, x402 payment, and EVM settlement evidence even when all four qualify one move."))
     (map ("id" "SXC-R018") ("text" "Every actuator MUST cold-start from an exact work order and canonical network evidence, perform one bounded transition, emit its receipt, and terminate without requiring a host-resident database, pidfile, cron, or durable queue."))
     (map ("id" "SXC-R019") ("text" "An actuator MUST hold neither durable/root keys nor funds; it MAY hold one pairwise P-256 or Ed25519 did:key private key only in volatile memory for the life of its invocation, together with invocation-bounded authority and an ERC-4337/ERC-7677 sponsorship accepted under policy. Its loss MUST strand no durable authority or value."))
     (map ("id" "SXC-R020") ("text" "Every agent operation MUST use a version-pinned A2A profile and an exact SDK artifact identity (package name, version, source, and integrity), use a signed Agent Card, carry exactly one canonical RMN operation part, preserve correlation through its CloudEvent and ActivityPub projections, and settle world-changing effects only through the receiving operation's admitted chain append.")))))
