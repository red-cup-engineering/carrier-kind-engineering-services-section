{
  "name": "@red-cup-engineering/relation-term-reduction-and-typing",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Reduces and type-checks Relation Model Notation terms — the CHL one-step reduction and Takahashi development (step/dev/evaluate) and the bidirectional type checker (hasTy/checkTy/inferTy) — and carries the portable RMN term catalog (measuring, connecting, counting, descending, pairing, projecting, reading, settling) built in that calculus. Ships relating's own pre-canon notation lineage (lib/notating) as its Tm/Ty grammar dependency; reconciling it with the section's canonical @red-cup-engineering/relation-model-notation grammar is separate future grammar-canon work, not done here.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/**/*.test.mjs\"",
    "verify": "npm run check && npm run build && npm test"
  },
  "main": "./dist/src/evaluating/index.mjs",
  "types": "./dist/src/evaluating/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/src/evaluating/index.d.mts",
      "import": "./dist/src/evaluating/index.mjs"
    },
    "./notation": {
      "types": "./dist/lib/notating/index.d.mts",
      "import": "./dist/lib/notating/index.mjs"
    },
    "./projecting": {
      "types": "./dist/src/evaluating/projecting/index.d.mts",
      "import": "./dist/src/evaluating/projecting/index.mjs"
    },
    "./descending": {
      "types": "./dist/src/evaluating/descending/index.d.mts",
      "import": "./dist/src/evaluating/descending/index.mjs"
    },
    "./reading": {
      "types": "./dist/src/evaluating/reading/index.d.mts",
      "import": "./dist/src/evaluating/reading/index.mjs"
    },
    "./measuring": {
      "types": "./dist/src/evaluating/measuring/index.d.mts",
      "import": "./dist/src/evaluating/measuring/index.mjs"
    },
    "./counting": {
      "types": "./dist/src/evaluating/counting/index.d.mts",
      "import": "./dist/src/evaluating/counting/index.mjs"
    },
    "./pairing": {
      "types": "./dist/src/evaluating/pairing/index.d.mts",
      "import": "./dist/src/evaluating/pairing/index.mjs"
    },
    "./connecting": {
      "types": "./dist/src/evaluating/connecting/index.d.mts",
      "import": "./dist/src/evaluating/connecting/index.mjs"
    },
    "./settling": {
      "types": "./dist/src/evaluating/settling/index.d.mts",
      "import": "./dist/src/evaluating/settling/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "package.json"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@lenticule-science/articulating": "0.1.1",
    "@red-cup-engineering/json-file-codec-service": "0.1.2"
  }
}
