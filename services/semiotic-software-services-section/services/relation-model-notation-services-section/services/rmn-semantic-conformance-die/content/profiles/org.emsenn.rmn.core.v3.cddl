; Pure placement-independent RMN die profile.
; org.emsenn.rmn.core.v3
; Canonical carrier: RFC 8949 core-deterministic CBOR only.
; Every text value is NFC. Maps use the length-first deterministic ordering.
; Floating point, indefinite length, CBOR tags, and non-text map keys are absent.

ni-uri = tstr .regexp "^ni:///sha-256;[A-Za-z0-9_-]{43}$"
caip-10 = tstr

rmn-type =
  ["unit"] /
  ["mark"] /
  ["four"] /
  ["effect"] /
  ["base", tstr] /
  ["arrow", rmn-type, rmn-type] /
  ["product", rmn-type, rmn-type] /
  ["sum", rmn-type, rmn-type] /
  ["list", rmn-type] /
  ["relation", rmn-type, rmn-type] /
  ["grounded", rmn-type, rmn-type] /
  ["wit", rmn-type]

four = {
  "positiveEvidence": bool,
  "negativeEvidence": bool
}

measure = {
  "dimension": tstr,
  "quantity": tstr .regexp "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
  "unit": tstr
}

effect-cell = {
  "law": ni-uri,
  "caller": caip-10,
  "provider": caip-10,
  "precondition": ni-uri,
  "operation": ni-uri,
  "postcondition": ni-uri,
  "refusal": ni-uri,
  "evidenceRoot": ni-uri,
  "outcome": four,
  "measures": [* measure],
  "parent": ni-uri / nil
}

rmn-term =
  ["var", uint] /
  ["lam", rmn-term] /
  ["app", rmn-term, rmn-term] /
  ["pair", rmn-term, rmn-term] /
  ["left", rmn-term, rmn-type] /
  ["right", rmn-type, rmn-term] /
  ["nil", rmn-type] /
  ["cons", rmn-term, rmn-term] /
  ["fst", rmn-term] /
  ["snd", rmn-term] /
  ["star"] /
  ["constant", rmn-type, ni-uri] /
  ["mark", tstr] /
  ["predicate", tstr, rmn-type, rmn-type] /
  ["ground", rmn-term, rmn-term, rmn-term] /
  ["four", bool, bool] /
  ["witness", rmn-term, rmn-term, rmn-term, ni-uri] /
  ["effect", effect-cell]
