{
  "name": "@red-cup-engineering/rmn-semantic-conformance-die",
  "version": "6.0.1",
  "description": "Placement-independent deterministic RML/RMN parsing, typing, normalization, RFC 8949 CBOR, RFC 6920 identity, FOUR, WIT, and finite circuit residues.",
  "type": "module",
  "license": "MIT",
  "files": [
    "LICENSE",
    "README.md",
    "src/",
    "types/",
    "content/profiles/",
    "content/vectors/"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./src/rmn-core.mjs"
    },
    "./canonical-cbor": "./src/canonical-cbor.mjs",
    "./conformance": "./src/conformance.mjs",
    "./four": "./src/four.mjs",
    "./hierarchical-circuit": {
      "types": "./types/hierarchical-circuit.d.mts",
      "import": "./src/hierarchical-circuit.mjs"
    },
    "./circuit-residue": "./src/circuit-residue.mjs",
    "./carrier-refinement": "./src/carrier-refinement.mjs",
    "./relational-value": "./src/relational-value.mjs",
    "./src/rmn-core.mjs": "./src/rmn-core.mjs",
    "./src/relational-value.mjs": "./src/relational-value.mjs"
  },
  "scripts": {
    "check": "node --check src/*.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test && npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  }
}
