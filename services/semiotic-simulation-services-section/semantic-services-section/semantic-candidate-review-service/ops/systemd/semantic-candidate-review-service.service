[Unit]
Description=Evidence-bound semantic candidate review A2A provider
After=network-online.target witness-journal-rdf-projection-service.service inference-work-lot-service.service
Wants=network-online.target witness-journal-rdf-projection-service.service inference-work-lot-service.service

[Service]
Type=simple
WorkingDirectory=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/semantic-candidate-review-service
Environment=HOST=127.0.0.1
Environment=PORT=19840
Environment=BASE_URL=http://127.0.0.1:19840
Environment=WITNESS_JOURNAL_RDF_AGENT=http://127.0.0.1:19764/.well-known/agent-card.json
Environment=INFERENCE_WORK_LOT_AGENT_CARD_URL=http://127.0.0.1:8796/.well-known/agent-card.json
Environment=AGENT_CARD_SIGNING_KEY=data/agent-card-signing/ed25519-private.pem
Environment=AGENT_CARD_JWKS=content/agent-card-signing/jwks.json
Environment=AGENT_CARD_SIGNING_KID=semantic-candidate-review-service-ed25519
ExecStart=/home/emsenn/.config/nvm/versions/node/v24.13.1/bin/node bin/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
