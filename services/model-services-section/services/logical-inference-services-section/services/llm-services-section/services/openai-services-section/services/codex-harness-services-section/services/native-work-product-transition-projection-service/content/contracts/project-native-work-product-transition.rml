#lang rmn/v2
(map
  ("type" "CapabilityLaw")
  ("version" 1)
  ("provider" "urn:ame:native-work-product-transition-projection-service")
  ("operation" "project-native-work-product-transition")
  ("precondition" "At the model/llm/openai/codex locus, receive one exact provider-addressed canonical RMN operation carrying a native inference work product as text.")
