[Unit]
Description=RMN semantic conformance A2A service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/services/rmn-semantic-conformance
Environment=PORT=8786
Environment=HOST=127.0.0.1
Environment=BASE_URL=http://127.0.0.1:8786
Environment=AGENT_CARD_SIGNING_KEY=%h/services/rmn-semantic-conformance/data/agent-card-signing/ed25519-private.pem
Environment=AGENT_CARD_JWKS=%h/services/rmn-semantic-conformance/content/agent-card-signing/jwks.json
Environment=AGENT_CARD_SIGNING_KID=rmn-semantic-conformance-ed25519
ExecStart=/usr/bin/node %h/services/rmn-semantic-conformance/bin/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
