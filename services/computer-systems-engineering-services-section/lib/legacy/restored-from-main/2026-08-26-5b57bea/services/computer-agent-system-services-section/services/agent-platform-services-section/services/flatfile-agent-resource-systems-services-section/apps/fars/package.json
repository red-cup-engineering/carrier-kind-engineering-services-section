{
  "name": "@red-cup-engineering/fars",
  "version": "0.1.0",
  "type": "module",
  "description": "FARS \u2014 the flat-file agent resource system, Node realization: a witnessed, four-valued predication substrate over a directory of flat files, composed from the Union\u2019s relation-model-notation and witness-journal services.",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "fars": "./src/cli/fars.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./cli": {
      "import": "./src/cli/verbs.mjs"
    },
    "./provider": {
      "types": "./types/provider.d.mts",
      "import": "./src/provider/provider.mjs"
    },
    "./compositor": {
      "types": "./types/compositor.d.mts",
      "import": "./src/provider/compositor.mjs"
    },
    "./renderer": {
      "types": "./types/renderer.d.mts",
      "import": "./src/render/registry.mjs"
    },
    "./adapters/activity-pulse": {
      "types": "./types/adapters.d.mts",
      "import": "./src/adapters/activity-pulse.mjs"
    },
    "./adapters/host-health": {
      "types": "./types/adapters.d.mts",
      "import": "./src/adapters/host-health.mjs"
    },
    "./adapters/linux-processes": {
      "types": "./types/adapters.d.mts",
      "import": "./src/adapters/linux-processes.mjs"
    },
    "./adapters/markdown-directory": {
      "types": "./types/adapters.d.mts",
      "import": "./src/adapters/markdown-directory.mjs"
    },
    "./adapters/systemd-inventory": {
      "types": "./types/adapters.d.mts",
      "import": "./src/adapters/systemd-inventory.mjs"
    }
  },
  "scripts": {
    "check": "find src test -type f -name '*.mjs' -exec sh -c 'for file do node --check \"$file\" || exit; done' sh {} +",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "@red-cup-engineering/canonicalize-semiotic-json-service": "^0.0.1",
    "@red-cup-engineering/ni-services-section": "^0.1.1",
    "@red-cup-engineering/path-walking-service": "^1.1.0",
    "@red-cup-engineering/relation-model-notation-runtime": "^8.0.0",
    "@red-cup-engineering/witness-journal-entry-service": "^0.1.6",
    "@red-cup-engineering/witness-journal-log-service": "^0.1.5"
  }
}
