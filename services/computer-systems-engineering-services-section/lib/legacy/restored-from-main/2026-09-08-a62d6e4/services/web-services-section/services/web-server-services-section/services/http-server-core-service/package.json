{
  "name": "@red-cup-engineering/http-server-core-service",
  "version": "0.2.0",
  "type": "module",
  "description": "Shared HTTP application engine with one request dispatcher, Fetch-native applications, and Node HTTP transport and lifecycle.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "test": "node --test test/*.test.mts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.mts",
      "import": "./dist/pipeline.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/http-server-application-contract-service": "0.2.0",
    "@red-cup-engineering/web-server-services-section": "0.1.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.0"
  },
  "sideEffects": false
}
