{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:561:schema:work-resource-reservation-request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "action",
    "reservationId",
    "providerIdentity",
    "accountIdentity",
    "windowIdentity",
    "evaluatedAt"
  ],
  "properties": {
    "type": {
      "const": "WorkResourceReservationRequest"
    },
    "action": {
      "enum": [
        "reserve",
        "attempt",
        "release",
        "settle"
      ]
    },
    "reservationId": {
      "type": "string",
      "minLength": 1
    },
    "providerIdentity": {
      "type": "string",
      "minLength": 1
    },
    "accountIdentity": {
      "type": "string",
      "minLength": 1
    },
    "windowIdentity": {
      "type": "string",
      "minLength": 1
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "resource",
          "unit",
          "amount"
        ],
        "additionalProperties": false,
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "asset": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "object",
            "required": [
              "numerator",
              "denominator"
            ],
            "additionalProperties": false,
            "properties": {
              "numerator": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "denominator": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            }
          }
        }
      }
    },
    "measuredResources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resource",
          "unit",
          "amount"
        ],
        "additionalProperties": false,
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "asset": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "object",
            "required": [
              "numerator",
              "denominator"
            ],
            "additionalProperties": false,
            "properties": {
              "numerator": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "denominator": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "reserve"
          }
        }
      },
      "then": {
        "required": [
          "resources"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "settle"
          }
        }
      },
      "then": {
        "required": [
          "measuredResources"
        ]
      }
    }
  ]
}
