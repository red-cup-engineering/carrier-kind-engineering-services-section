{
  "name": "@red-cup-engineering/decide-work-placement-service",
  "version": "0.6.2",
  "description": "Decides one provider-neutral work placement from exact demand, finite resource and quota, offer, policy, and observation evidence without performing effects.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": {
    ".": "./scripts/decide-work-placement.mjs",
    "./resource-reservations": "./src/resource-reservations.mjs"
  },
  "bin": {
    "decide-work-placement": "scripts/decide-work-placement.mjs"
  },
  "files": [
    "scripts",
    "README.md",
    "package.json",
    "src",
    "schemas"
  ],
  "dependencies": {
    "@lenticule-science/metrologic": "0.3.0",
    "@red-cup-engineering/computer-data-engine": "0.11.2"
  },
  "devDependencies": {
    "@red-cup-engineering/gcloud-runtime-authorities-service": "0.3.0"
  },
  "scripts": {
    "check": "node --check scripts/decide-work-placement.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=24.2.0"
  }
}
