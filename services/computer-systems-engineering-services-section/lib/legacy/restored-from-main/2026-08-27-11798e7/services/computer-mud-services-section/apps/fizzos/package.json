{
  "name": "@red-cup-engineering/fizzos",
  "version": "0.2.1",
  "description": "A deterministic, event-sourced kernel for inhabitable multi-user worlds.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@lenticule-science/metrologic": "0.1.0"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./four": "./src/four.mjs",
    "./world": "./src/world.mjs",
    "./game": "./src/game.mjs",
    "./engine": "./src/engine.mjs",
    "./capabilities": "./src/capabilities.mjs",
    "./persistence": "./src/persistence.mjs",
    "./concurrency": "./src/concurrency.mjs",
    "./mud-server": "./src/mud-server.mjs",
    "./world-clock": "./src/world-clock.mjs",
    "./fields": "./src/fields.mjs",
    "./ecology": "./src/ecology.mjs",
    "./market": "./src/market.mjs",
    "./crafting": "./src/crafting.mjs",
    "./skills": "./src/skills.mjs",
    "./social": "./src/social.mjs",
    "./reputation": "./src/reputation.mjs",
    "./npc": "./src/npc.mjs",
    "./progression": "./src/progression.mjs",
    "./interiority": "./src/interiority.mjs",
    "./predication": "./src/predication.mjs",
    "./lisp": "./src/lisp.mjs",
    "./instancing": "./src/instancing.mjs",
    "./federation": "./src/federation.mjs",
    "./http": "./src/http.mjs",
    "./client": "./src/client.mjs",
    "./components": "./src/components.mjs",
    "./interaction": "./src/interaction.mjs",
    "./operations": "./src/operations.mjs",
    "./communicating": "./src/communicating.mjs",
    "./knowing": "./src/knowing.mjs",
    "./playing": "./src/playing.mjs",
    "./things": "./src/things.mjs",
    "./soul": "./src/soul.mjs",
    "./examples/garden": "./examples/garden.mjs",
    "./examples/teraum": "./examples/teraum.mjs",
    "./faculties": "./src/faculties.mjs",
    "./faculty-cover": "./src/faculty-cover.mjs",
    "./inhabiting": "./src/inhabiting.mjs",
    "./runtime-ecology": "./src/runtime-ecology.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "fizzos": "./scripts/fizzos.mjs",
    "fizzos-serve": "./scripts/fizzos-serve.mjs",
    "fizzos-world": "./scripts/fizzos-world.mjs",
    "fizzos-tell": "./scripts/fizzos-tell.mjs",
    "fizzos-look": "./scripts/fizzos-look.mjs",
    "fizzos-tick": "./scripts/fizzos-tick.mjs"
  },
  "files": [
    "README.md",
    "content/",
    "src/",
    "examples/",
    "scripts/",
    "test/"
  ],
  "scripts": {
    "check": "node --check src/*.mjs scripts/*.mjs examples/*.mjs test/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "verify:capabilities": "node scripts/verify-capabilities.mjs",
    "verify": "npm run check && npm test && npm run verify:capabilities && npm pack --dry-run"
  },
  "sideEffects": false
}
