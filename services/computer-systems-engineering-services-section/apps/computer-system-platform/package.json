{
  "name": "@red-cup-engineering/computer-system-platform",
  "version": "0.5.3",
  "type": "module",
  "description": "The computer-system platform: hosts applications on the computer-system engine and lets them communicate with it (capabilities, operations, wire). Downstream of computer-system-engine.",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json",
    "./capability-lifecycle": "./src/capability-lifecycle.mjs",
    "./wire": "./src/wire.mjs",
    "./obligation-driver": "./src/obligation-driver.mjs",
    "./klein-capacity-flow": "./src/klein-capacity-flow.mjs"
  },
  "files": [
    "src/*.mjs",
    "scripts",
    "test/capability-lifecycle.test.mjs",
    "specifications/conditional-capability-lifecycle.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "oci:observe": "node scripts/launch-oracle-instance.mjs --observe-only",
    "test:oci": "node --test test/oci-always-free-admission.test.mjs",
    "test:klein-capacity-flow": "node --test test/klein-capacity-flow.test.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@red-cup-engineering/computer-code-engineering-services-section": "workspace:*",
    "@red-cup-engineering/computer-data-engineering-services-section": "workspace:*",
    "@red-cup-engineering/computer-system-engine": "workspace:*",
    "@red-cup-engineering/computer-web-server": "workspace:*",
    "@red-cup-engineering/json-schema-services-section": "workspace:*",
    "@red-cup-engineering/mcp-engineering-services-section": "workspace:*",
    "@red-cup-engineering/node-process-services-section": "workspace:*"
  },
  "sideEffects": false,
  "receivingTests": [
    "test/capability-lifecycle.test.mjs"
  ]
}
