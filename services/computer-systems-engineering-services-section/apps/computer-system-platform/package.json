    "@red-cup-engineering/mcp-engineering-services-section": "workspace:*",
    "@red-cup-engineering/node-process-services-section": "workspace:*",
    "@red-cup-engineering/cloudflare-services-section": "workspace:*",
    "@red-cup-engineering/execute-javascript-node-command-service": "workspace:*",
