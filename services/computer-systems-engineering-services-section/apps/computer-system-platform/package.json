{
  "name": "@red-cup-engineering/computer-system-platform",
  "version": "0.5.3",
  "type": "module",
  "description": "The computer-system platform: hosts applications on the computer-system engine and lets them communicate with it (capabilities, operations, wire). Downstream of computer-system-engine.",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json",
