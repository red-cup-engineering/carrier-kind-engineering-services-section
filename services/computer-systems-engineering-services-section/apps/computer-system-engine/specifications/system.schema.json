{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.561.group/computer/system.schema.json",
  "title": "Computer System",
  "description": "A concurrent-game-system composition over one relational field. Local process, cloud deployment, MCP server, MetroPlat UX, and federation node are projections of this same System.",
  "type": "object",
  "required": ["version", "id", "game", "protocols", "operations"],
  "additionalProperties": false,
  "properties": {"version": {"const": 1}, "id": {"type": "string", "minLength": 1}, "game": {"$ref": "game.schema.json"}, "protocols": {"type": "array", "minItems": 1, "items": {"$ref": "protocol.schema.json"}}, "operations": {"type": "array", "items": {"$ref": "operation.schema.json"}}}
}
