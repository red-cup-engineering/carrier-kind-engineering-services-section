{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.561.group/computer/relational-field.schema.json",
  "title": "Relational Field",
  "description": "The one replicated semantic carrier. It is a content-addressed set of typed statements with an explicit declaration catalog. Merge is set union; semantic conflict is retained for a declared settlement operation.",
  "type": "object",
  "required": ["version", "catalogIdentity", "statements"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "catalogIdentity": {"type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]+$"},
    "statements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "additionalProperties": false,
        "properties": {"id": {"type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]+$"}, "statement": {"$ref": "statement.schema.json"}}
      }
    }
  }
}
