      ]
    },
    {
      "const": "active",
      "x-coordinates": [
        "absent",
        "present"
      ]
    },
    {
      "const": "stable",
      "x-coordinates": [
        "present",
        "present"
      ]
    }
  ],
  "x-codegen": {
    "exportName": "chargeValueNameSchema",
    "typeName": "ChargeValueName",
    "runtimeName": "chargeValueNameType"
