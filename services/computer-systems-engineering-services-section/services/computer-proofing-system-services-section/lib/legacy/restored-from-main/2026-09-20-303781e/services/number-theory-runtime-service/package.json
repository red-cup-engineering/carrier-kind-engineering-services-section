{
  "name": "@lenticule-science/number-theory-services-section",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Discrete number-theoretic systems: Collatz orbits, number-theoretic keratin/barrier receipts, and sequence-recurrence readings.",
  "keywords": [
    "number-theory",
    "collatz",
    "computer-data",
    "561-group"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emsenn/bare-cedar-fog.git",
    "directory": "lib/emsenn/services/561-group/services/engineering-services-section/services/computer-engineering-services-section/services/computer-systems-engineering-services-section/services/computer-proofing-system-services-section/services/number-theory-runtime-service"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./collatz": {
      "types": "./dist/collatz.d.mts",
      "import": "./dist/collatz.mjs"
    },
    "./number-theory": {
      "types": "./dist/number-theory.d.mts",
      "import": "./dist/number-theory.mjs"
    },
    "./sequence-recurrence": {
      "types": "./dist/sequence-recurrence.d.mts",
      "import": "./dist/sequence-recurrence.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "dependencies": {
    "@lenticule-science/articulating": "0.4.2",
    "@red-cup-engineering/agentic-enterprise-computer-platform-engineering-services-section": "0.3.0",
    "@red-cup-engineering/computer-data-engine": "0.9.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
