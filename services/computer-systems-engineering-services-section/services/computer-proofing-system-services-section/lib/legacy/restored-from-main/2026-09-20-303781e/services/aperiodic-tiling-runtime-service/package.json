{
  "name": "@lenticule-science/aperiodic-tilings-services-section",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Aperiodic tiling autocorrelation, Jeandel-Rao AP cohomology witnesses, and tile charge/cover structure receipts, over @lenticule-science/articulating's exact-number analysis and @lenticule-science/graph-theory-services-section's exact coloring.",
  "keywords": [
    "aperiodic-tilings",
    "jeandel-rao",
    "computer-data",
    "561-group"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emsenn/bare-cedar-fog.git",
    "directory": "lib/emsenn/services/561-group/services/engineering-services-section/services/computer-engineering-services-section/services/computer-systems-engineering-services-section/services/computer-proofing-system-services-section/services/aperiodic-tiling-runtime-service"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./aperiodic-autocorrelation": {
      "types": "./dist/aperiodic-autocorrelation.d.mts",
      "import": "./dist/aperiodic-autocorrelation.mjs"
    },
    "./jeandel-rao-witness": {
      "types": "./dist/jeandel-rao-witness.d.mts",
      "import": "./dist/jeandel-rao-witness.mjs"
    },
    "./tile": {
      "types": "./dist/tile.d.mts",
      "import": "./dist/tile.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "dependencies": {
    "@lenticule-science/articulating": "0.4.2",
    "@lenticule-science/graph-theory-services-section": "0.1.0",
    "@red-cup-engineering/agentic-enterprise-computer-platform-engineering-services-section": "0.3.0",
    "@red-cup-engineering/computer-data-engine": "0.9.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
