{
  "name": "@lenticule-science/algebra-services-section",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Exact rational-number and linear algebra: finite integer matrices, Smith normal form, rank, nullity, determinant, and characteristic polynomial receipts over @lenticule-science/articulating's exact-number analysis.",
  "keywords": [
    "algebra",
    "linear-algebra",
    "rational-arithmetic",
    "computer-data",
    "561-group"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emsenn/bare-cedar-fog.git",
    "directory": "lib/emsenn/services/561-group/services/engineering-services-section/services/computer-engineering-services-section/services/computer-systems-engineering-services-section/services/computer-proofing-system-services-section/services/linear-algebra-runtime-service"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./linear-algebra": {
      "types": "./dist/linear-algebra.d.mts",
      "import": "./dist/linear-algebra.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "dependencies": {
    "@lenticule-science/articulating": "0.4.2"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
