{
  "name": "@lenticule-science/graph-theory-services-section",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Graph incidence, exact graph coloring, discrete-set-number graphs, lenticule port-graphs, and exact spectral (Pisot/Mahler/resultant) graph readings, over @lenticule-science/articulating's exact-number analysis. Cannibalized 2026-09-11 from @red-cup-engineering/feltos's math/graphs/{coloring,discrete-set-number-graph,port-graph,spectral}.mts, which carried no MUD/game-specific behavior.",
  "keywords": [
    "graph-theory",
    "graph-coloring",
    "spectral-graph-theory",
    "computer-data",
    "561-group"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emsenn/bare-cedar-fog.git",
    "directory": "lib/emsenn/services/561-group/services/engineering-services-section/services/computer-engineering-services-section/services/computer-systems-engineering-services-section/services/computer-proofing-system-services-section/services/graph-runtime-service"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./coloring": {
      "types": "./dist/coloring.d.mts",
      "import": "./dist/coloring.mjs"
    },
    "./discrete-set-number-graph": {
      "types": "./dist/discrete-set-number-graph.d.mts",
      "import": "./dist/discrete-set-number-graph.mjs"
    },
    "./port-graph": {
      "types": "./dist/port-graph.d.mts",
      "import": "./dist/port-graph.mjs"
    },
    "./spectral": {
      "types": "./dist/spectral.d.mts",
      "import": "./dist/spectral.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "dependencies": {
    "@lenticule-science/articulating": "0.4.2",
    "@red-cup-engineering/agentic-enterprise-computer-platform-engineering-services-section": "0.3.0",
    "@red-cup-engineering/computer-data-engine": "0.9.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
