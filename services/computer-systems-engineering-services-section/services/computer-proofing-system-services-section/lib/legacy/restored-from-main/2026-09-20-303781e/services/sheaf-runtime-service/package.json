{
  "name": "@lenticule-science/sheaf-mathematics-services-section",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "Finite executable shadows of Obsmetrologia's order-theoretic twist-product (RelMath.Order.TwistProductResiduation) and d-frame-valued sheaf (Obsmetrologia.DFrame.dframe_valued_sheaf) laws, generic over any caller-supplied four-valued (bottom/positive-only/negative-only/top) charge or claim vocabulary.",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./order/four-twist-product": {
      "types": "./dist/order/four-twist-product.d.mts",
      "import": "./dist/order/four-twist-product.mjs"
    },
    "./topology/d-frame": {
      "types": "./dist/topology/d-frame.d.mts",
      "import": "./dist/topology/d-frame.mjs"
    },
    "./four-valued-names": {
      "types": "./dist/four-valued-names.d.mts",
      "import": "./dist/four-valued-names.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "devDependencies": {
    "@lenticule-science/articulating": "0.5.1",
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
