import Lean
import Obsmetrologia
open Lean Elab Command

/-!
Identification-key census.

An identification is *spent* where `Quot.sound` or `Quotient.sound` is applied.
A house spend (inside an `Obsmetrologia.` constant) is keyed by the relation or
setoid it identifies along: the head constant of the `r` argument of
`Quot.sound` or the `s` argument of `Quotient.sound`. A spend made inside a
Lean-core constant is keyed `core:<constant>` — so `funext`, which core proves by
`Quot.sound`, is one key. A theorem inherits every key in the transitive closure
of the constants it uses, core and house alike. The number of distinct keys a
theorem inherits is the number of independent identifications it rests on.

Reading through an identification (`Quot.mk`, `Quot.lift`, `Quotient.lift`,
`Quot.ind`) spends nothing and is not a key.

Output, tab-separated:
  `#theorems\t<n>`
  `#keys\t<n>`
  `#key\t<key>\t<theorems inheriting it>`   (one per key, most inherited first)
  `#hist\t<distinct keys>\t<theorems>`       (one per bucket)
  `<theorem>\t<distinct keys>\t<comma-joined keys>`   (one per house theorem)
-/

def isHouse (n : Name) : Bool := n.toString.startsWith "Obsmetrologia."

/-- The string-valued dot components of a name, ignoring anonymous and numeric
segments (`Obsmetrologia.Foo.bar` -> `["Obsmetrologia", "Foo", "bar"]`). -/
partial def nameStrComponents : Name → List String
  | .anonymous => []
  | .str p s => nameStrComponents p ++ [s]
  | .num p _ => nameStrComponents p

/-- Lean-elaborator-generated declaration names -- recursors, injectivity/
no-confusion lemmas, equation-compiler helpers, sizeOf plumbing, well-founded
match/proof helpers, etc. -- that must never be counted as house theorems.
True when any dot-separated component begins with `_` (`_proof_1`, `_eq_1`,
`_unfold`, ...), or the last component is one of the fixed auto-generated
names, or begins with `match_`/`proof_`, or is `eq_` followed by one or more
digits (`eq_1`, `eq_2`, ...). A `mk.sizeOf_spec`/`mk.injEq`/`mk.inj`/
`mk.noConfusion` name is already caught by the last-component rule, since
`sizeOf_spec`/`injEq`/`inj`/`noConfusion` is its own last component. See
AGENTS.md defect note (2026-09-21): every census program in this directory
had been counting these as house theorems, inflating every "theorems" total
and (worst, in the certificate-shape census) dominating the top lists with
`Algebra.*.mk.sizeOf_spec` entries. -/
def isAutoGenerated (n : Name) : Bool :=
  let cs := nameStrComponents n
  if cs.any (·.startsWith "_") then true
  else
    match cs.getLast? with
    | none => false
    | some last =>
      [
        "sizeOf_spec", "injEq", "inj", "noConfusion", "noConfusionType",
        "casesOn", "recOn", "rec", "brecOn", "binductionOn",
        "below", "ibelow", "toCtorIdx", "ofNat_toCtorIdx", "ctorIdx", "ctorElim"
      ].contains last
      || last.startsWith "match_"
      || last.startsWith "proof_"
      || (last.startsWith "eq_" && last.length > 3 && (last.drop 3).all Char.isDigit)

def isSpend (c : Name) : Bool := c == ``Quot.sound || c == ``Quotient.sound

/-- The keys of every maximal `Quot.sound`/`Quotient.sound` application in an
expression: the head constant of the relation/setoid argument, or an anonymous
marker naming the owning constant when that argument is not headed by a constant. -/
partial def spendKeysOfExpr (owner : Name) (e : Expr) (acc : Array String) : Array String :=
  match e with
  | .app .. =>
    let fn := e.getAppFn
    let args := e.getAppArgs
    let acc := match fn with
      | .const c _ =>
        if isSpend c then
          if h : 1 < args.size then
            match args[1].getAppFn with
            | .const rc _ => acc.push rc.toString
            | _ => acc.push s!"<anon:{owner}>"
          else acc.push s!"<partial:{owner}>"
        else acc
      | _ => acc
    let acc := match fn with
      | .const _ _ => acc
      | _ => spendKeysOfExpr owner fn acc
    args.foldl (fun acc a => spendKeysOfExpr owner a acc) acc
  | .lam _ t b _ => spendKeysOfExpr owner b (spendKeysOfExpr owner t acc)
  | .forallE _ t b _ => spendKeysOfExpr owner b (spendKeysOfExpr owner t acc)
  | .letE _ t v b _ => spendKeysOfExpr owner b (spendKeysOfExpr owner v (spendKeysOfExpr owner t acc))
  | .mdata _ b => spendKeysOfExpr owner b acc
  | .proj _ _ b => spendKeysOfExpr owner b acc
  | _ => acc

/-- The keys a constant inherits: its own spends (keyed by relation if house,
by constant if core) plus every key of every constant it uses, memoized. -/
partial def keysOf (env : Environment) (cache : IO.Ref (Std.HashMap Name (Array String)))
    (n : Name) : IO (Array String) := do
  if let some s := (← cache.get).get? n then return s
  cache.modify (·.insert n #[])  -- cycle guard
  let some ci := env.find? n | return #[]
  let used := ci.getUsedConstantsAsSet
  let mut acc : Array String := #[]
  if used.toList.any isSpend then
    if isHouse n then
      let ks := match ci with
        | .thmInfo t => spendKeysOfExpr n t.value #[]
        | .defnInfo d => spendKeysOfExpr n d.value #[]
        | _ => #[]
      let ks := if ks.isEmpty then #[s!"<unkeyed:{n}>"] else ks
      for k in ks do if !acc.contains k then acc := acc.push k
    else
      acc := acc.push s!"core:{n}"
  for u in used.toList do
    if isSpend u then continue
    for k in (← keysOf env cache u) do
      if !acc.contains k then acc := acc.push k
  cache.modify (·.insert n acc)
  return acc

#eval show CommandElabM Unit from do
  let env ← getEnv
  let cache ← IO.mkRef ({} : Std.HashMap Name (Array String))
  let mut keyCount : Std.HashMap String Nat := {}
  let mut hist : Std.HashMap Nat Nat := {}
  let mut rows : Array String := #[]
  let mut excluded := 0
  for (n, ci) in env.constants.toList do
    if isHouse n && !n.isInternal then
      if let .thmInfo _ := ci then
        if isAutoGenerated n then
          excluded := excluded + 1
        else
          let ks ← keysOf env cache n
          hist := hist.insert ks.size ((hist.getD ks.size 0) + 1)
          for k in ks do keyCount := keyCount.insert k ((keyCount.getD k 0) + 1)
          rows := rows.push s!"{n}\t{ks.size}\t{String.intercalate "," ks.toList}"
  IO.println s!"#excluded-auto-generated\t{excluded}"
  IO.println s!"#theorems\t{rows.size}"
  IO.println s!"#keys\t{keyCount.size}"
  for (k, c) in (keyCount.toArray.qsort (fun a b => a.2 > b.2 || (a.2 == b.2 && a.1 < b.1))) do
    IO.println s!"#key\t{k}\t{c}"
  for (k, c) in (hist.toArray.qsort (fun a b => a.1 < b.1)) do
    IO.println s!"#hist\t{k}\t{c}"
  for r in rows.qsort (· < ·) do IO.println r
