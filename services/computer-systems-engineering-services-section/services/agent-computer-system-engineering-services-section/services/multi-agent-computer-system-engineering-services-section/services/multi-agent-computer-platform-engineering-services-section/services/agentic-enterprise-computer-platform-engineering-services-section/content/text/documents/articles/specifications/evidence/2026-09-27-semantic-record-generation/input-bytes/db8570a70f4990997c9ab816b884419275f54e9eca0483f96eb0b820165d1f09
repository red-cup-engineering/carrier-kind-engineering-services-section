      throw new TypeError(`SEAVT row field "${key}" must be an SEN JSON array`);
    try {
      if (inferTy([], row[key]) === null || !isClosed(row[key])) throw Error();
    } catch {
      throw new TypeError(
        `SEAVT row field "${key}" must be a closed, inferable SEN term`,
      );
