{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:561-group:churn:prospect-qualification-and-sales-compensation:2",
  "type": "object",
  "required": ["offering","candidate","qualification","scenario","roles","salesAssignment","provenanceRefs"],
  "properties": {
    "offering":{"type":"string","minLength":1},"candidate":{"type":"string","minLength":1},
    "qualification":{
      "type":"object",
      "required":["asOf","expiresAt","state","conditions"],
      "properties":{
        "asOf":{"type":"string","format":"date-time"},
        "expiresAt":{"type":"string","format":"date-time"},
        "state":{"enum":["pending","accepted","rejected"]},
        "conditions":{
          "type":"array","minItems":1,
          "items":{
            "type":"object",
            "required":["name","required","state","source","observedAt"],
            "properties":{
              "name":{"type":"string","minLength":1},
              "required":{"type":"boolean"},
              "state":{"enum":["met","unmet","unknown"]},
              "source":{"type":"string","minLength":1},
              "observedAt":{"type":"string","format":"date-time"}
            }
          }
        }
      },
      "allOf":[
        {
          "if":{"properties":{"state":{"const":"accepted"}},"required":["state"]},
          "then":{
            "not":{
              "properties":{
                "conditions":{
                  "contains":{
                    "type":"object",
                    "required":["required","state"],
                    "properties":{
                      "required":{"const":true},
                      "state":{"not":{"const":"met"}}
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "scenario":{"type":"object","required":["pricingStatus","netUpfrontCapexCents","requiredRetainedSurplusCents","cases"],"properties":{"pricingStatus":{"enum":["priced","unpriced"]},"netUpfrontCapexCents":{"type":["integer","null"],"minimum":0},"requiredRetainedSurplusCents":{"type":["integer","null"],"minimum":0},"cases":{"type":"object","properties":{"low":{"$ref":"#/$defs/case"},"base":{"$ref":"#/$defs/case"},"high":{"$ref":"#/$defs/case"}},"additionalProperties":false}},"allOf":[{"if":{"properties":{"pricingStatus":{"const":"priced"}},"required":["pricingStatus"]},"then":{"properties":{"netUpfrontCapexCents":{"type":"integer","minimum":0},"requiredRetainedSurplusCents":{"type":"integer","minimum":0},"cases":{"required":["base"],"properties":{"low":{"$ref":"#/$defs/pricedCase"},"base":{"$ref":"#/$defs/pricedCase"},"high":{"$ref":"#/$defs/pricedCase"}}}}},"else":{"properties":{"cases":{"minProperties":1,"properties":{"low":{"$ref":"#/$defs/unpricedCase"},"base":{"$ref":"#/$defs/unpricedCase"},"high":{"$ref":"#/$defs/unpricedCase"}}}}}}]},
    "roles":{"type":"object","required":["propertyOrHostDecisionMaker","audience","customerBuyer","installer","restocker","artistOrIpOwner","thirdPartyLogistics","salesRepresentative"],"additionalProperties":{"type":["string","null"]}},
    "salesAssignment":{"type":"object","required":["payoutRules"],"properties":{"payoutRules":{"type":"array","items":{"type":"object","required":["trigger","compensation","attributionScope","attributionWindow","acceptanceEvidenceRequirements","observedEvidenceRefs","refundCancellationTerminationTreatment","status"],"properties":{"trigger":{"enum":["upfront-research-fee","qualified-appointment","signed-site-agreement","installed-or-activated-placement","realized-collected-sales"]},"compensation":{"oneOf":[{"type":"object","required":["kind","fixedAmountCents"],"properties":{"kind":{"const":"fixed"},"fixedAmountCents":{"type":"integer","minimum":0}},"additionalProperties":false},{"type":"object","required":["kind","shareBasisPoints","base"],"properties":{"kind":{"const":"share"},"shareBasisPoints":{"type":"integer","minimum":0,"maximum":10000},"base":{"type":"string","minLength":1}},"additionalProperties":false}]},"capCents":{"type":["integer","null"],"minimum":0},"attributionScope":{"type":"string","minLength":1},"attributionWindow":{"type":"string","minLength":1},"acceptanceEvidenceRequirements":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"observedEvidenceRefs":{"type":"array","items":{"type":"string","minLength":1}},"refundCancellationTerminationTreatment":{"type":"string","minLength":1},"status":{"enum":["pending","payable","void"]}},"allOf":[{"if":{"properties":{"status":{"const":"payable"}},"required":["status"]},"then":{"properties":{"observedEvidenceRefs":{"minItems":1}}}}]}}}},
    "provenanceRefs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
  },
  "$defs":{"case":{"type":"object","required":["assumptionClass","salesPerMonth","revenueCents","operatingCostCents","monthlyOperatingContributionCents","horizonMonths","horizonOperatingContributionCents","volumeKnown","rentKnown","maxAcquisitionAllowanceCents","economicallyViable"],"properties":{"assumptionClass":{"enum":["seller-estimate","quote","measurement","history","hypothesis"]},"salesPerMonth":{"type":["integer","null"],"minimum":0},"revenueCents":{"type":["integer","null"],"minimum":0},"operatingCostCents":{"type":["integer","null"],"minimum":0},"monthlyOperatingContributionCents":{"type":["integer","null"]},"horizonMonths":{"type":"integer","minimum":1},"horizonOperatingContributionCents":{"type":["integer","null"]},"volumeKnown":{"type":"boolean"},"rentKnown":{"type":"boolean"},"maxAcquisitionAllowanceCents":{"type":["integer","null"],"minimum":0},"economicallyViable":{"type":["boolean","null"]}}},"pricedCase":{"allOf":[{"$ref":"#/$defs/case"},{"properties":{"salesPerMonth":{"type":"integer","minimum":0},"revenueCents":{"type":"integer","minimum":0},"operatingCostCents":{"type":"integer","minimum":0},"monthlyOperatingContributionCents":{"type":"integer"},"horizonOperatingContributionCents":{"type":"integer"},"volumeKnown":{"const":true},"rentKnown":{"const":true},"maxAcquisitionAllowanceCents":{"type":"integer","minimum":0},"economicallyViable":{"type":"boolean"}}}]},"unpricedCase":{"allOf":[{"$ref":"#/$defs/case"},{"properties":{"maxAcquisitionAllowanceCents":{"const":null},"economicallyViable":{"const":null}}}]}}
}
