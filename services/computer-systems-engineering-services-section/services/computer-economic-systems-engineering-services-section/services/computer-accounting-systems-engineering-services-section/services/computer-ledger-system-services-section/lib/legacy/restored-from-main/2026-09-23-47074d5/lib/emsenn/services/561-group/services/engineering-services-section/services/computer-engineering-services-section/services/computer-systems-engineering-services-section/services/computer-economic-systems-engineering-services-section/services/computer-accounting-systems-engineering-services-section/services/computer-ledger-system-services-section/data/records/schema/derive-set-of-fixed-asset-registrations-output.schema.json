{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:red-cup-engineering:schema:derive-set-of-fixed-asset-registrations-output:1",
  "title": "FixedAssetRegistrationSet",
  "type": "object",
  "required": ["type", "version", "registrationCount", "registrations", "skipped"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "FixedAssetRegistrationSet" },
    "version": { "const": 1 },
    "registrationCount": { "type": "integer", "minimum": 0 },
    "registrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["purchaseId", "assetId", "account", "treatment", "directive"],
        "additionalProperties": false,
        "properties": {
          "purchaseId": { "type": "string" },
          "assetId": { "type": "string" },
          "account": { "type": "string" },
          "treatment": { "enum": ["capitalize", "expense"] },
          "directive": { "type": "string", "description": "The rendered Beancount open+note (capitalize) or note-only (expense) directive text." }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["purchaseId", "reason"],
        "additionalProperties": false,
        "properties": {
          "purchaseId": { "type": "string" },
          "reason": { "enum": ["owned-by-other-party", "missing-asset-id"] }
        }
      }
    }
  }
}
