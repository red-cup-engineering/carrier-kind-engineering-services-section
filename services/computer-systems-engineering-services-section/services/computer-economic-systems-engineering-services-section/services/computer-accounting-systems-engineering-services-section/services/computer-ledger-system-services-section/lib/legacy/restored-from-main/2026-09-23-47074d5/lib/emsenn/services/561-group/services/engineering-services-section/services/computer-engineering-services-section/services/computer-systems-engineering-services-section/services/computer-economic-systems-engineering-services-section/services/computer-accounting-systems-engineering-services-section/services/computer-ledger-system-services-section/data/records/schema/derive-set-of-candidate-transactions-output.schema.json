{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:red-cup-engineering:schema:derive-set-of-candidate-transactions-output:1",
  "title": "CandidateTransactionSet",
  "type": "object",
  "required": ["type", "version", "transactionCount", "transactions", "accountsToOpen", "skipped"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "CandidateTransactionSet" },
    "version": { "const": 1 },
    "transactionCount": { "type": "integer", "minimum": 0 },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "narration", "sourceId", "account", "commodity", "delta", "counterAccount", "counterAmount", "directive"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "One day before the mismatch row's assertionDate." },
          "narration": { "type": "string" },
          "sourceId": { "type": "string" },
          "account": { "type": "string" },
          "commodity": { "type": "string" },
          "delta": { "type": "string", "description": "Exact signed decimal difference asserted minus posted." },
          "counterAccount": { "enum": ["Income:Investment:Unrealized-Gains", "Expenses:Investment:Unrealized-Losses"] },
          "counterAmount": { "type": "string", "description": "The exact negation of delta." },
          "directive": { "type": "string", "description": "The rendered Beancount transaction directive text." }
        }
      }
    },
    "accountsToOpen": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["account", "date", "directive"],
        "additionalProperties": false,
        "properties": {
          "account": { "type": "string" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "directive": { "type": "string" }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["account", "commodity", "sourceId", "reason"],
        "additionalProperties": false,
        "properties": {
          "account": { "type": "string" },
          "commodity": { "type": "string" },
          "sourceId": { "type": "string" },
          "reason": { "const": "zero-delta" }
        }
      }
    }
  }
}
