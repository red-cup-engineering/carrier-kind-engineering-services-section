{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.561.group/@red-cup-engineering/venue-fill-booking-service/schema/derive-set-of-fill-transactions.output.schema.json",
  "title": "venueFillTransactionSet",
  "type": "object",
  "required": ["type", "version", "transactionCount", "transactions", "accountsToOpen", "refusals"],
  "properties": {
    "type": { "const": "VenueFillTransactionSet" },
    "version": { "const": 1 },
    "transactionCount": { "type": "integer", "minimum": 0 },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "narration", "fillId", "side", "baseCommodity", "quoteCommodity", "baseQuantity", "quoteAmount", "directive"],
        "properties": {
          "date": { "type": "string" },
          "narration": { "type": "string" },
          "fillId": { "type": "string" },
          "side": { "enum": ["buy", "sell"] },
          "baseCommodity": { "type": "string" },
          "quoteCommodity": { "type": "string" },
          "baseQuantity": { "type": "string" },
          "quoteAmount": { "type": "string" },
          "costBasisConsumed": { "type": "string", "description": "sell only: exact FIFO cost basis consumed." },
          "realized": { "type": "string", "description": "sell only: quoteAmount minus costBasisConsumed." },
          "realizedAccount": { "type": "string", "description": "sell only: the gain or loss account posted." },
          "consumedLots": { "type": "array", "description": "sell only: which buy fillIds the FIFO lot(s) came from." },
          "directive": { "type": "string", "description": "the rendered Beancount transaction text." }
        }
      }
    },
    "accountsToOpen": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["account", "date", "directive"],
        "properties": { "account": { "type": "string" }, "date": { "type": "string" }, "directive": { "type": "string" } }
      }
    },
    "refusals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fillId", "reason"],
        "properties": { "fillId": { "type": "string" }, "reason": { "type": "string" } }
      }
    }
  }
}
