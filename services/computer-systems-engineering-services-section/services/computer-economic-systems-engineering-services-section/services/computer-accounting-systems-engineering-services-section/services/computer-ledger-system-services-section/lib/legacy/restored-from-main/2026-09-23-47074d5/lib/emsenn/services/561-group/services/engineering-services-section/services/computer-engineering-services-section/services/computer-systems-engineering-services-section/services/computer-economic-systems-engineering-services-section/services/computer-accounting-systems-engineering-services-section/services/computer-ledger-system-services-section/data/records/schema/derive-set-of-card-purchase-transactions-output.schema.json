{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:red-cup-engineering:schema:derive-set-of-card-purchase-transactions-output:1",
  "title": "CardPurchaseTransactionSet",
  "type": "object",
  "required": ["type", "version", "transactionCount", "transactions", "accountsToOpen", "pending", "outsideBoundary"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "CardPurchaseTransactionSet" },
    "version": { "const": 1 },
    "transactionCount": { "type": "integer", "minimum": 0 },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "narration", "purchaseId", "sourceId", "owner", "paidBy", "debitAccount", "debitAmount", "creditAccount", "creditAmount", "currency", "directive"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "narration": { "type": "string" },
          "purchaseId": { "type": "string" },
          "sourceId": { "type": "string" },
          "owner": { "type": "string" },
          "paidBy": { "type": "string" },
          "debitAccount": { "type": "string" },
          "debitAmount": { "type": "string", "description": "Exact plain decimal string." },
          "creditAccount": { "type": "string" },
          "creditAmount": { "type": "string", "description": "The exact negation of debitAmount." },
          "currency": { "type": "string" },
          "directive": { "type": "string", "description": "The rendered Beancount transaction directive text." }
        }
      }
    },
    "accountsToOpen": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["account", "date", "directive"],
        "additionalProperties": false,
        "properties": {
          "account": { "type": "string" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "directive": { "type": "string" }
        }
      }
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["purchaseId", "orderDate", "owner", "reason"],
        "additionalProperties": false,
        "properties": {
          "purchaseId": { "type": "string" },
          "orderDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "owner": { "type": "string" },
          "reason": { "const": "amount-missing" }
        }
      }
    },
    "outsideBoundary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["purchaseId", "owner", "paidBy", "reason"],
        "additionalProperties": false,
        "properties": {
          "purchaseId": { "type": "string" },
          "owner": { "type": "string" },
          "paidBy": { "type": "string" },
          "reason": { "const": "owned-and-paid-by-other-parties" }
        }
      }
    }
  }
}
