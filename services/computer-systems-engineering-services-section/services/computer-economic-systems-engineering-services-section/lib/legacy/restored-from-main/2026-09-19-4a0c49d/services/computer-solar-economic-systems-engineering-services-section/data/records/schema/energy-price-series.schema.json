{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "energy-price-series.schema.json",
  "title": "EnergyPriceSeries",
  "description": "One dated, place-by-place series of the price of delivered energy (the Soft Dyson program's benchmark primitive): one row per place per commodity (KWH from a declared utility tariff, PROPANE_GAL and DIESEL_GAL from the EIA's weekly retail-price series), produced by observe-set-of-energy-prices.",
  "type": "object",
  "required": ["type", "version", "asOf", "rows"],
  "properties": {
    "type": { "const": "EnergyPriceSeries" },
    "version": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/EnergyPriceRow" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "EnergyPriceRow": {
      "type": "object",
      "required": ["place", "commodity", "usdPerUnit", "unit", "source", "asOf", "method"],
      "properties": {
        "place": { "type": "string", "minLength": 1 },
        "commodity": { "enum": ["KWH", "PROPANE_GAL", "DIESEL_GAL"] },
        "usdPerUnit": { "type": ["string", "null"] },
        "unit": { "enum": ["USD/kWh", "USD/gal"] },
        "source": { "type": ["string", "null"] },
        "asOf": { "type": "string", "format": "date" },
        "method": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "if": { "properties": { "usdPerUnit": { "type": "null" } } },
      "then": { "required": ["reason"] }
    }
  }
}
