{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "derive-value-chain-shares-service/result",
  "title": "ValueChainShareSet",
  "description": "The output derive-value-chain-shares.mjs writes: each position's exact share of the retail price (producer's position first), the exact multiplier against the previous position, and the evidence label of every priced input row.",
  "type": "object",
  "required": ["type", "version", "positionCount", "retailPositionName", "retailUnitPrice", "retailUnit", "positions"],
  "properties": {
    "type": { "const": "ValueChainShareSet" },
    "version": { "const": 1 },
    "positionCount": { "type": "integer", "minimum": 2 },
    "retailPositionName": { "type": "string", "minLength": 1 },
    "retailUnitPrice": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
    "retailUnit": { "type": "string", "minLength": 1 },
    "positions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["name", "contested", "prices"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "contested": { "type": "boolean" },
          "prices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": ["unitPrice", "unit", "share", "multiplierFromPrevious", "evidenceLabel"],
              "properties": {
                "unitPrice": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
                "unit": { "type": "string", "minLength": 1 },
                "share": {
                  "type": "object",
                  "required": ["numerator", "denominator"],
                  "properties": {
                    "numerator": { "type": "string", "pattern": "^-?[0-9]+$" },
                    "denominator": { "type": "string", "pattern": "^[0-9]+$" }
                  },
                  "additionalProperties": false
                },
                "multiplierFromPrevious": {
                  "oneOf": [
                    { "type": "null" },
                    {
                      "type": "object",
                      "required": ["numerator", "denominator"],
                      "properties": {
                        "numerator": { "type": "string", "pattern": "^-?[0-9]+$" },
                        "denominator": { "type": "string", "pattern": "^[0-9]+$" }
                      },
                      "additionalProperties": false
                    }
                  ]
                },
                "evidenceLabel": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
