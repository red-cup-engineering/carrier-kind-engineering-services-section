    "scripts",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@red-cup-engineering/javascript-node-services-section": "0.3.0"
  },
  "devDependencies": {},
  "scripts": {
    "check": "node --check scripts/observe-irradiance.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=24.2.0"
  }
}
