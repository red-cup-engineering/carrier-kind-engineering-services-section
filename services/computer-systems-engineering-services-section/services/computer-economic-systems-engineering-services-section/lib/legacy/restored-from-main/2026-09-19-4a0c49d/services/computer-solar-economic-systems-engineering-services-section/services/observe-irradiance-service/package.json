{
  "name": "@red-cup-engineering/observe-irradiance-service",
  "version": "0.1.0",
  "description": "Fetches one public irradiance dataset's daily GHI for a place and date range and returns it\nas irradiance-observation rows, or a refusal datum.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": "./scripts/observe-irradiance.mjs",
  "bin": {
    "observe-irradiance": "scripts/observe-irradiance.mjs"
  },
