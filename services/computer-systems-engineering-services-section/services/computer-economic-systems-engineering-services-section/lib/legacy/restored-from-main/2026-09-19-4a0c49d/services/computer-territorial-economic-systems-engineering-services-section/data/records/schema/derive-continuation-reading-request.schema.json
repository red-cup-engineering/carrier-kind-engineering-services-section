{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "derive-continuation-reading-service/request",
  "title": "ContinuationReadingRequest",
  "description": "The input derive-continuation-reading.mjs reads: a held position, its candidate continuations each carrying the evidence rows found for it (a lossless four-valued charge and its citation), and the search terms run when none was found.",
  "type": "object",
  "required": ["type", "version", "position", "candidates", "searched"],
  "properties": {
    "type": { "const": "ContinuationReadingRequest" },
    "version": { "const": 1 },
    "position": {
      "type": "object",
      "required": ["text", "holds"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "holds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nextStep", "recordPath", "evidenceRows"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "nextStep": { "type": "string", "minLength": 1 },
          "recordPath": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "null" }
            ]
          },
          "evidenceRows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rowId", "charge", "citation"],
              "properties": {
                "rowId": { "type": "string", "minLength": 1 },
                "charge": {
                  "type": "object",
                  "required": ["support", "refutation"],
                  "properties": {
                    "support": { "type": "boolean" },
                    "refutation": { "type": "boolean" }
                  },
                  "additionalProperties": false,
                  "not": {
                    "properties": { "support": { "const": false }, "refutation": { "const": false } },
                    "required": ["support", "refutation"]
                  }
                },
                "citation": {
                  "type": "object",
                  "required": ["sourceUrl", "sourceTitle", "accessedOn"],
                  "properties": {
                    "sourceUrl": { "type": "string", "minLength": 1 },
                    "sourceTitle": { "type": "string", "minLength": 1 },
                    "accessedOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "searched": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
