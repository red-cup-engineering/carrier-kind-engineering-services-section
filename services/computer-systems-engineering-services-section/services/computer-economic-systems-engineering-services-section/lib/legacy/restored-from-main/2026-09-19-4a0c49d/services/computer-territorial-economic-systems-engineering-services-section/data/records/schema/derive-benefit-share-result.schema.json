{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "derive-benefit-share-service/result",
  "title": "BenefitShareReading",
  "description": "The output derive-benefit-share.mjs writes: what a benefit-sharing agreement returns to the territory per unit and in total for the request's unitsSold, computed by the record's share.kind, whether the record's floor (if any) is met against the producer's position price, an overall meetsAgreement boolean, the evidence label of every figure used, and every figure the reading could not resolve or represent.",
  "type": "object",
  "required": ["type", "version", "shareKind", "shareValue", "perUnit", "total", "basis", "floor", "meetsAgreement", "evidenceLabels", "notFound"],
  "properties": {
    "type": { "const": "BenefitShareReading" },
    "version": { "const": 1 },
    "shareKind": { "enum": ["royalty", "net-sales", "milestone", "multiple-of-market", "none"] },
    "shareValue": { "type": ["string", "null"], "description": "The record's own share.value, echoed unchanged." },
    "perUnit": { "$ref": "#/$defs/FractionOrNull" },
    "total": { "$ref": "#/$defs/FractionOrNull" },
    "basis": { "type": "string", "minLength": 1, "description": "What perUnit was computed from, in plain words, or the literal string \"unknown\" when a required base was not named." },
    "floor": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["amount", "unit", "per", "producerPositionUnitPrice", "producerPositionUnit", "met"],
          "properties": {
            "amount": { "type": "string", "minLength": 1 },
            "unit": { "type": "string", "minLength": 1 },
            "per": { "type": "string", "minLength": 1 },
            "producerPositionUnitPrice": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
            "producerPositionUnit": { "type": "string", "minLength": 1 },
            "met": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    },
    "meetsAgreement": { "type": "boolean" },
    "evidenceLabels": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "notFound": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false,
  "$defs": {
    "Fraction": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "string", "pattern": "^-?[0-9]+$" },
        "denominator": { "type": "string", "pattern": "^[0-9]+$" }
      },
      "additionalProperties": false
    },
    "FractionOrNull": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/Fraction" }
      ]
    }
  }
}
