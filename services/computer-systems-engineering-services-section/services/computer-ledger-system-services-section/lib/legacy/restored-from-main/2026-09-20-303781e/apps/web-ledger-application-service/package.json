{
  "name": "@red-cup-engineering/web-ledger-application-service",
  "version": "0.4.0",
  "description": "Server-first typed ledger presentation with TUFTE forms, tables, drilldowns, reconciliation status, and provenance.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "package.json"
  ],
  "sideEffects": false,
  "scripts": {
    "check": "node --check src/index.mjs && node --check src/web-ledger-application.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/farolfi": "0.5.0",
    "@red-cup-engineering/web-tufte-gui-services-section": "0.11.0"
  }
}
