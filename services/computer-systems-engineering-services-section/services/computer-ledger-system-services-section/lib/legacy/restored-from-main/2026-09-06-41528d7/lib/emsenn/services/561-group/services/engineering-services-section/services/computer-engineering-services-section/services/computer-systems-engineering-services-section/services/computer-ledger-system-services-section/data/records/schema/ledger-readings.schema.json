{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:red-cup-engineering:schema:ledger-readings:1",
  "title": "LedgerReadings",
  "type": "object",
  "required": ["kind", "readings"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "ledger-readings" },
    "readings": {
      "type": "object",
      "required": ["balanceSheet", "incomeStatement", "reconcile", "stats", "accounts"],
      "additionalProperties": false,
      "properties": {
        "balanceSheet": { "$ref": "./ledger-report.schema.json" },
        "incomeStatement": { "$ref": "./ledger-report.schema.json" },
        "reconcile": { "$ref": "./ledger-report.schema.json" },
        "stats": { "$ref": "./ledger-report.schema.json" },
        "accounts": { "$ref": "./ledger-report.schema.json" }
      }
    }
  }
}
