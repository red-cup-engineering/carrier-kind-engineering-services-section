{
  "id": "2026-10-10-ledger-carrier-census",
  "kind": "ledger-carrier-census",
  "recorded-on": "2026-10-10",
  "serves": [
    "requirement:one-log-for-ledgers-channels-messages-and-transactions"
  ],
  "owner": {
    "carrier": "seavt-witness-journal",
    "at": "red-cup-engineering/computer-data-services-section:services/computer-content-engineering-services-section/services/computer-serialized-content-engineering-services-section/services/json-services-section/services/jsonl-services-section/services/eavt-services-section/services/semiotic-eavt-services-section",
    "layout": "<settlement-root>/data/journals/YYYY/MM/DD/<date>-admit-<objectKind>.jsonl.witnesses",
    "record": "witness: origin (seat), claim (FOUR charge semantic-record.unknown|held|denied|contested), address (EAVT key, E/A/V as SEN terms), time, causes; id is the content address",
    "roots": "each machine's MetroPlat settlement root; roots federate by exchange",
    "projections": [
      "Beancount book of record (bookkeeper derivers only)",
      "farolfi readings",
      "per-seller x402 cash books",
      "allowance books"
    ]
  },
  "one-log": {
    "carrier": "seavt-witness-journal",
    "read": "@red-cup-engineering/semiotic-eavt-services-section/query-journal-day#queryJournalDay({roots, date, feeds?})",
    "read_change": "red-cup-engineering/computer-data-services-section#58",
    "write": "@red-cup-engineering/semiotic-eavt-services-section/record-semantic-record#createSettlementStore",
    "store_causes": "createSettlementStore forwards causes and origin (computer-data-services-section#58)"
  },
  "clearing": {
    "at": "agent-organization-engine lib/organizing (organizing package)",
    "law": [
      "enterprise/crossings.mjs: provider release half + requester admission half through the split tally; settled when they agree, claim when one is held, dispute when they disagree; each lane in FOUR; unwitnessed amounts unknown",
      "accounting/consolidation.mjs: eliminates intra-group credit lines and services",
      "nettingOf: nets tallies"
    ],
    "price": "cost inside a legal entity (provider's witnessed cost, else the offer); the offer at a border",
    "common_register": false
  },
  "posting-interface": {
    "write": "createSettlementStore({settlementRoot, objectKind: '561-group.<venue|mechanism>.<kind>.v1', actor: <micro-enterprise>})",
    "money_record": "561-group-services-section/data/records/schema/monetary-event-observation.schema.json: atomic integer-string amount with unit and decimals (or an exact fraction), economic event time beside observed time, sourceRefs, boundary",
    "halves": "each party books its own half; clearing halves go through the organizing crossings/tally path",
    "chain": "decision -> order intent -> fill -> settlement as one chain of witnessed records, each citing its predecessor in causes",
    "forbidden": [
      "posting directly to a Beancount book",
      "real-money movement",
      "credentials or keys in a record"
    ],
    "agreed_by": [
      "orchestrator 2026-10-10"
    ]
  },
  "fold-order": [
    {
      "step": 1,
      "what": "inference allowance ledger and account capacity",
      "how": "#172 pattern (admit SQLite once, journal after)",
      "owner": "SQL retirement 2 on computer-services-section; bare-cedar-fog copy retires with its owner"
    },
    {
      "step": 2,
      "what": "x402: seller cash, purchase receipts, paid-data endpoint",
      "how": "recordSellerSettlements / heldSellerSettlements; openReceiptJournal beside X402_RECEIPT_PATH (legacy JSONL admitted once)",
      "owner": "ledger session, in the owning x402 repository",
      "status": "seller cash done (web#39, ops#94); exact-purchase receipts wait on an x402-services-section registry release"
    },
    {
      "step": 3,
      "what": "pool and tips sidecar books",
      "how": "settlement witnesses; sidecars rendered as projections",
      "owner": "ledger session"
    },
    {
      "step": 4,
      "what": "raw JSONL price and credit books",
      "how": "openLedgerJournal",
      "owner": "ledger session"
    },
    {
      "step": 5,
      "what": "semantic-record-journal-service callers",
      "how": "import codemod onto createSemanticRecordJournal",
      "owner": "ledger session"
    },
    {
      "step": 6,
      "what": "witness-journal document and RDF-agent writers",
      "how": "onto the journal",
      "owner": "ledger session"
    },
    {
      "step": 7,
      "what": "channels and messages (ActivityPub custody, intake, inbox, agent events)",
      "how": "one feed each",
      "owner": "ActivityPub after the SQL session hands over the journal shape"
    },
    {
      "step": 8,
      "what": "market-game decision chain",
      "how": "decision -> order intent -> fill -> settlement witnesses",
      "owner": "with the markets session",
      "status": "Kalshi desk adapter open (kalshi#47); store forwards causes in computer-data-services-section#58"
    }
  ],
