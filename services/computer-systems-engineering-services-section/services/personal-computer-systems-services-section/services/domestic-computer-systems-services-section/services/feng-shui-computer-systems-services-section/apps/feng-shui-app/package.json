{
  "name": "@red-cup-engineering/feng-shui-app",
  "version": "0.1.0",
  "description": "Local-first desk-review computer system for the 561 Group Feng Shui program.",
  "type": "module",
  "engines": {
    "node": ">=24.2.0"
  },
  "exports": {
    ".": "./apps/feng-shui-browser-app.mjs",
    "./scene": "./src/desk-scene.mjs",
    "./advice": "./src/retrieve-desk-advice.mjs"
  },
  "files": [
    "src",
    "apps",
    "public"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
