[Unit]
Description=ap.561.group ActivityPub actor: crucible (Palaverse game actor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/emsenn/info/lib/emsenn/services/561-group/services/561-group-services-section/services/561-group-computer-services-section/services/computer-machine-services-section/services/persistent-computer-machine-services-section/services/bare-cedar-fog-services-section/data/runtime/share/561-group/releases/activitypub-services-section/current
Environment=HOST=127.0.0.1
Environment=PORT=8102
Environment=ACTIVITYPUB_ORIGIN=https://ap.561.group
Environment=ACTIVITYPUB_IDENTIFIER=crucible
Environment="ACTIVITYPUB_ACTOR_NAME=Crucible"
Environment="ACTIVITYPUB_ACTOR_SUMMARY=A daily-seeded settling puzzle. Every morning: today's tangle seed, posted here first. Real obstruction-theory math (@red-cup-engineering/metrologic) sets every move's cost -- not a designer spreadsheet. Play at https://crucible.561.group/"
Environment=ACTIVITYPUB_KEYS_PATH=/home/emsenn/info/lib/emsenn/services/561-group/services/561-group-services-section/services/561-group-computer-services-section/services/computer-machine-services-section/services/persistent-computer-machine-services-section/services/bare-cedar-fog-services-section/data/runtime/share/emsenn/activitypub-crucible/keys.json
Environment=ACTIVITYPUB_STATE_DIR=/home/emsenn/info/lib/emsenn/services/561-group/services/561-group-services-section/services/561-group-computer-services-section/services/computer-machine-services-section/services/persistent-computer-machine-services-section/services/bare-cedar-fog-services-section/data/runtime/share/emsenn/activitypub-crucible
Environment=ACTIVITYPUB_OUTBOX_PATH=/home/emsenn/info/lib/emsenn/services/561-group/services/561-group-services-section/services/561-group-computer-services-section/services/computer-machine-services-section/services/persistent-computer-machine-services-section/services/bare-cedar-fog-services-section/data/runtime/share/emsenn/activitypub-561-games/crucible-outbox.json
ExecStart=/home/emsenn/.local/bin/node src/local-server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
