[Unit]
Description=ap.561.group ActivityPub actor: ruinfold (Palaverse game actor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/emsenn/info/lib/emsenn/services/561-group/services/561-group-services-section/services/561-group-computer-services-section/services/computer-machine-services-section/services/persistent-computer-machine-services-section/services/bare-cedar-fog-services-section/data/runtime/share/561-group/releases/activitypub-services-section/current
Environment=HOST=127.0.0.1
Environment=PORT=8103
Environment=ACTIVITYPUB_ORIGIN=https://ap.561.group
Environment=ACTIVITYPUB_IDENTIFIER=ruinfold
Environment="ACTIVITYPUB_ACTOR_NAME=Ruinfold Daily"
Environment="ACTIVITYPUB_ACTOR_SUMMARY=A seeded-daily roguelike. Everyone descends the same keep in a 24-hour UTC window. Today's floor count and seed, posted here each morning; results each night. Play at https://ruinfold.561.group/"
Environment=ACTIVITYPUB_KEYS_PATH=/home/emsenn/info/lib/emsenn/services/561-group/services/561-group-services-section/services/561-group-computer-services-section/services/computer-machine-services-section/services/persistent-computer-machine-services-section/services/bare-cedar-fog-services-section/data/runtime/share/emsenn/activitypub-ruinfold/keys.json
Environment=ACTIVITYPUB_SQLITE_PATH=/home/emsenn/info/lib/emsenn/services/561-group/services/561-group-services-section/services/561-group-computer-services-section/services/computer-machine-services-section/services/persistent-computer-machine-services-section/services/bare-cedar-fog-services-section/data/runtime/share/emsenn/activitypub-ruinfold/state.sqlite
Environment=ACTIVITYPUB_OUTBOX_PATH=/home/emsenn/info/lib/emsenn/services/561-group/services/561-group-services-section/services/561-group-computer-services-section/services/computer-machine-services-section/services/persistent-computer-machine-services-section/services/bare-cedar-fog-services-section/data/runtime/share/emsenn/activitypub-561-games/ruinfold-outbox.json
ExecStart=/home/emsenn/.local/bin/node src/local-server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
