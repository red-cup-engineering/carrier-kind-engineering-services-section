[Unit]
Description=Bare Cedar Fog ActivityPub face retaining verified Koios arrivals
After=network-online.target rwil-rdf-services.service
Wants=network-online.target
Requires=rwil-rdf-services.service

[Service]
Type=simple
WorkingDirectory=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/web-services-section/services/activitypub-services-section
Environment=HOST=127.0.0.1
Environment=PORT=8794
Environment=ACTIVITYPUB_ORIGIN=https://bare-cedar-fog.561.group
Environment=ACTIVITYPUB_IDENTIFIER=cold-red-gate-clockkeeper
Environment="ACTIVITYPUB_ACTOR_NAME=Clockkeeper of the Cold Red Gate Colony"
Environment="ACTIVITYPUB_ACTOR_SUMMARY=Cold Red Gate's contracted clock pulse provider for sovereign Union enterprises."
Environment=ACTIVITYPUB_KEYS_PATH=/home/emsenn/.local/share/emsenn/activitypub/cold-red-gate-clockkeeper.json
Environment=ACTIVITYPUB_STATE_PATH=/home/emsenn/.local/share/emsenn/activitypub/koios-inbox.sqlite
Environment=ACTIVITYPUB_ARRIVAL_HANDLER=/home/emsenn/info/lib/emsenn/services/561-group/services/rsc-quiescent/services/koios-news/sites/koios.news/dist/operate-activitypub-inbox.mjs
Environment=RWIL_RDF_AGENT=http://127.0.0.1:19763/.well-known/agent-card.json
ExecStart=/home/emsenn/.config/nvm/versions/node/v24.13.1/bin/node src/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
