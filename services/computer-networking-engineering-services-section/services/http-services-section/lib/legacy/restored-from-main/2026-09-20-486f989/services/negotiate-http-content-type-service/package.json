{
  "name": "@red-cup-engineering/negotiate-http-content-type-service",
  "version": "0.1.1",
  "type": "module",
  "description": "Select an offered HTTP content type from Accept preferences.",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/negotiate-http-content-type.d.mts",
      "import": "./dist/negotiate-http-content-type.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mts",
    "prepack": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "sideEffects": false
}
