{
  "name": "@red-cup-engineering/code-http-byte-range-service",
  "version": "0.1.1",
  "type": "module",
  "description": "Parse and form HTTP byte ranges and multipart byte-range bodies.",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/code-http-byte-range.d.mts",
      "import": "./dist/code-http-byte-range.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mts",
    "prepack": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@red-cup-engineering/code-http-header-value-service": "0.1.1"
  },
  "sideEffects": false
}
