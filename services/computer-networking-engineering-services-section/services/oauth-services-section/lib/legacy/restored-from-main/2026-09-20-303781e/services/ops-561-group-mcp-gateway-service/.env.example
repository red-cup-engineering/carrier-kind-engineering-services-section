HOST=127.0.0.1
PORT=18807
PUBLIC_BASE_URL=https://ops.561.group
UPSTREAM_MCP_URL=http://127.0.0.1:18811
OPS_MCP_STATE_DIR=/home/operator/.local/state/561-group/ops-561-group-mcp-gateway
# OPS_DATA_DIR is OPTIONAL: unset, the control-plane rooms (/world, /records) are not mounted at
# all. Set, it must contain world.eavt and a records/ directory of *.json files.
OPS_DATA_DIR=/home/operator/.local/state/561-group/ops-561-group-mcp-gateway/data
OPS_MCP_ALLOWED_EMAIL=operator@example.invalid
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# ActivityPub is OPTIONAL and disabled unless every required value below is present. The actor key
# file must already exist; this service does not generate it. SQLite defaults to
# $OPS_MCP_STATE_DIR/activitypub.sqlite.
# ACTIVITYPUB_ORIGIN=https://ops.561.group
# ACTIVITYPUB_IDENTIFIER=ops
# ACTIVITYPUB_ACTOR_NAME=561 Group Operations
# ACTIVITYPUB_ACTOR_SUMMARY=The public federation actor for 561 Group operations
# ACTIVITYPUB_KEYS_PATH=/home/operator/.config/561-group/ops-activitypub-keys.json
# ACTIVITYPUB_SQLITE_PATH=/home/operator/.local/state/561-group/ops-561-group-mcp-gateway/activitypub.sqlite

# The variables below are read by scripts/serve-ops-mcp-stdio.mjs, the stdio<->remote-MCP bridge a
# harness runs as a CLIENT of this deployment — not by the server process above. Mint the client
# with scripts/admit-principal.mjs on the deployment host; never commit the secret.
# OPS_MCP_ORIGIN=https://ops.561.group
# OPS_MCP_CLIENT_ID=replace-with-an-admitted-client-id
# OPS_MCP_CLIENT_SECRET=replace-with-that-client-s-secret
