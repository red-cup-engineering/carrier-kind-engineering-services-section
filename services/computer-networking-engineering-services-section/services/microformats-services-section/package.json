{
  "name": "@red-cup-engineering/microformats-services-section",
  "version": "0.1.0",
  "type": "module",
  "description": "microformats2: parsing HTML into microformats2 JSON (held to the shared microformats test suite) and emitting microformats2 markup from data.",
  "engines": { "node": ">=22" },
  "exports": {
    ".": "./src/index.mjs",
    "./parse": "./src/parse.mjs",
    "./emit": "./src/emit.mjs",
    "./package.json": "./package.json"
  },
  "scripts": { "check": "node --check src/*.mjs", "test": "node --test test/*.test.mjs" },
  "dependencies": { "parse5": "7.3.0" },
  "files": ["README.md", "package.json", "src"],
  "sideEffects": false,
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/computer-engineering-services-section.git",
    "directory": "services/computer-networking-engineering-services-section/services/microformats-services-section"
  }
}
