{
  "name": "@red-cup-engineering/schema-org-services-section",
  "version": "0.1.0",
  "type": "module",
  "description": "schema.org structured data: JSON-LD nodes, Open Graph and Twitter Card metadata, composition from settled knowledge, and validation against the schema.org vocabulary.",
  "engines": { "node": ">=22" },
  "exports": {
    ".": "./src/index.mjs",
    "./jsonld": "./src/jsonld.mjs",
    "./meta": "./src/meta.mjs",
    "./compose": "./src/compose.mjs",
    "./vocabulary": "./src/vocabulary.mjs",
    "./extract": "./src/extract.mjs",
    "./package.json": "./package.json"
  },
  "scripts": { "check": "node --check src/*.mjs", "test": "node --test test/*.test.mjs", "build:vocabulary": "node scripts/build-vocabulary.mjs" },
  "dependencies": { "parse5": "7.3.0" },
  "files": ["README.md", "package.json", "src", "data", "scripts"],
  "sideEffects": false,
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/computer-engineering-services-section.git",
    "directory": "services/computer-networking-engineering-services-section/services/schema-org-services-section"
  }
}
