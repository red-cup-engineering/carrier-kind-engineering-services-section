{
  "name": "@red-cup-engineering/a2a-rmn-task-client-service",
  "version": "0.10.0",
  "private": false,
  "type": "module",
  "description": "One Capability Cell that hires an exact A2A provider and verifies a RMN task exchange.",
  "repository": {
    "type": "git",
    "url": "https://github.com/emsenn/a2a-rmn-hire-and-verify-cell.git"
  },
  "exports": {
    ".": {
      "types": "./types/client.d.mts",
      "import": "./src/send-rmn-task.mjs"
    },
    "./src/send-rmn-task.mjs": "./src/send-rmn-task.mjs"
  },
  "files": [
    "src/",
    "types/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "send-rmn-a2a-task": "./src/send-rmn-task.mjs"
  },
  "scripts": {
    "test": "node --test test/circuit-interface.test.mjs test/outbound-custody.test.mjs test/outbound-task-root.test.mjs"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.1.0",
    "@red-cup-engineering/a2a-agent-card-discovery-service": "0.8.0",
    "@red-cup-engineering/a2a-rmn-part-service": "0.5.0"
  },
  "devDependencies": {
    "@red-cup-engineering/a2a-contracted-agent-service": "0.12.0"
  }
}
