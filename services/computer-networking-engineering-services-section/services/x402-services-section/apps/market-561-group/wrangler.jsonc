{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "market-561-group",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "routes": [
    {
      "pattern": "market.561.group",
      "custom_domain": true
    }
  ],
  // Every settlement-affecting value is deployment-supplied, never a source
  // constant. X402_PAY_TO is a `wrangler secret put` value, not a var (x402
  // payto decision, 2026-08-31). The facilitator is Coinbase's CDP, so every
  // settlement indexes the offer in the x402 Bazaar; CDP_API_KEY_ID and
  // CDP_API_KEY_SECRET are `wrangler secret put` values.
  // Enabled sign-in also requires the instance custodian to supply MARKET_ACCESS_GRANTS.
  // This source change does not install authority; receiving must verify the actual binding.
  "vars": {
    "MARKET_RUNTIME": "edge",
    "X402_NETWORK": "eip155:8453",
    "X402_FACILITATOR": "https://api.cdp.coinbase.com/platform/v2/x402",
    "X402_FACILITATOR_PROVIDER": "cdp",
    // The Node face (serve-market.mjs) running on bare-cedar-fog, reached
    // through cold-red-gate's numeric-port origin (Caddy :8087, socks5-
    // tunneled to the repository machine over the tailnet, same shape as
    // paid-ephemeris-gateway's PRECISION_ORIGIN at :8086). Every offer this
    // edge face cannot compute (runtime:"node") proxies through here instead
    // of 404ing; the origin runs its own complete market and settles its own
    // payments. A hostname, not the bare IP: a Worker's fetch() refuses a
    // literal IP address (Cloudflare error 1003), so node-market.561.group
    // (DNS-only A record, unproxied, -> 45.76.19.133) names the same origin.
    "NODE_MARKET_ORIGIN": "http://node-market.561.group:8087"
  },
  // Workers AI, for the offers whose compute runs a model (translation):
  // the inference engine's runner calls it through env.AI on this face.
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "SHOP_GOODS",
      "bucket_name": "shop-561-group-goods"
    },
    {
      "binding": "KOIOS_INTELLIGENCE_BRIEFINGS",
      "bucket_name": "koios-intelligence-briefings"
    },
    {
      "binding": "MARKET_SETTLEMENTS",
      "bucket_name": "market-561-group-settlements"
    },
    {
      "binding": "CDRAMA_TRANSLATIONS",
      "bucket_name": "market-561-group-cdrama-translations"
    }
  ]
}
