[Unit]
Description=market.561.group node face: the house pure-function catalog batch and every node-only offer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/561-group/releases/cold-red-gate.561.group/current/lib/emsenn/services/561-group/services/engineering-services-section/services/computer-engineering-services-section/services/computer-networking-engineering-services-section/services/x402-services-section/apps/market-561-group
ExecStart=/bin/sh -c 'exec node scripts/serve-market.mjs'
EnvironmentFile=%h/.config/red-cup-engineering/market-561-group/rails.env
Environment=NODE_ENV=production
Environment=MARKET_RUNTIME=node
Environment=HOST=127.0.0.1
Environment=PORT=18927
Environment=X402_NETWORK=eip155:8453
# One market, one facilitator: the edge face's (wrangler.jsonc), so every settlement indexes the
# offer in the x402 Bazaar. CDP_API_KEY_ID and CDP_API_KEY_SECRET are rails.env values.
Environment=X402_FACILITATOR=https://api.cdp.coinbase.com/platform/v2/x402
Environment=X402_FACILITATOR_PROVIDER=cdp
Environment=MARKET_ORIGIN=https://market.561.group
Environment=MARKET_DATA_ROOT=%h/.local/share/561-group/market-561-group
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
