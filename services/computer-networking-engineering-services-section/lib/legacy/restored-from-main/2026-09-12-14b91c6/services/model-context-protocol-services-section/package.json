{
  "name": "@red-cup-engineering/model-context-protocol-services-section",
  "version": "0.8.0",
  "type": "module",
  "description": "Forms transport-neutral Model Context Protocol tool servers from native JSON Schema catalogs, and declares the one client-side endpoint type (McpClientEndpoint) every agent runtime's MCP configuration projects from.",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/model-context-protocol.d.mts",
      "import": "./dist/model-context-protocol.mjs"
    },
    "./stdio": {
      "types": "./dist/stdio.d.mts",
      "import": "./dist/stdio.mjs"
    },
    "./client-endpoint": {
      "types": "./dist/client-endpoint.d.mts",
      "import": "./dist/client-endpoint.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mts",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@red-cup-engineering/computer-data-engine": "0.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "sideEffects": false
}
