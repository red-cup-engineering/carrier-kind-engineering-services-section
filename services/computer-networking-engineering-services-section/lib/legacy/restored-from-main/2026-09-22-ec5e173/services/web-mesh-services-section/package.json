{
  "name": "@red-cup-engineering/mesh-networking-service",
  "version": "0.0.4",
  "type": "module",
  "description": "Peer-to-peer mesh networking over HTTP: Kademlia peer discovery, gossip and anti-entropy replication, content-addressed storage, DTN bundles, and a Nostr relay. Moved out of the HTTP section since it is a networking topology concern, not an HTTP-serving one.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "node --check src/*.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "files": [
    "package.json",
    "src",
    "test",
    "README.md"
  ],
  "exports": {
    "./address": "./src/address.mjs",
    "./antientropy": "./src/antientropy.mjs",
    "./content": "./src/content.mjs",
    "./discovery": "./src/discovery.mjs",
    "./dtn": "./src/dtn.mjs",
    "./gossip": "./src/gossip.mjs",
    "./nostr": "./src/nostr.mjs",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/http-services-section": "0.6.0",
    "@red-cup-engineering/computer-data-engine": "0.11.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1"
  },
  "sideEffects": false
}
