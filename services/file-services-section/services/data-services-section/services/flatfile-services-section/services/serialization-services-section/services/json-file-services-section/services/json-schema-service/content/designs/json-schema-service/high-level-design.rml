  ("architecture" "content/designs/json-schema-service/software-architecture-specification.rml")
  ("unit" "services/json-schema-service")
  ("components"
    ((map ("id" "draft-profile") ("responsibility" "Fix Draft 2020-12 and enumerate the supported keyword vocabulary."))
