#lang rmn/v2
(map
  ("type" "JsonSchemaServiceRequirementsBaseline")
  ("version" 1)
  ("source" "emsenn/requirement/json-schema-creation-validation-resolution")
  ("dialect" "https://json-schema.org/draft/2020-12/schema")
  ("supported-vocabulary" ("$schema" "$id" "$ref" "$defs" "$comment" "$comment-absences" "title" "description" "default" "examples" "deprecated" "readOnly" "writeOnly" "type" "enum" "const" "required" "properties" "additionalProperties" "propertyNames" "minProperties" "maxProperties" "items" "minItems" "maxItems" "uniqueItems" "contains" "minLength" "maxLength" "pattern" "format" "minimum" "maximum" "exclusiveMinimum" "exclusiveMaximum" "multipleOf" "allOf" "anyOf" "oneOf" "not" "if" "then" "else"))
  ("precondition" "A caller supplies JSON values plus an explicit bounded schema corpus. The JSON file codec has already admitted carrier bytes; this service does not acquire a file, package, or network resource.")
  ("operation" "Create a canonical declared JSON Schema, resolve only explicit bounded identifiers and JSON Pointers, and return a validation verdict with diagnostics.")
  ("postcondition" "Success returns a deterministic schema or a bounded judgment. Refusal leaves every caller resource unchanged and never adds ambient authority.")
  ("refusal" "Refuse dialect drift, unsupported vocabulary, malformed JSON, unresolved or cyclic references, nonlocal resolution, identity conflation, claimed monotone completion, legacy deletion, global identifier rewrite, and chain-settlement claims.")
  ("requirements"
    ((map ("id" "JSS-R001") ("kind" "stakeholder") ("text" "The combined JSON Schema capability cell MUST be owned by json-file-services-section and expose creation, bounded resolution, and validation as one schema-semantic boundary rather than a second codec or an independently authoritative authoring cell."))
     (map ("id" "JSS-R002") ("kind" "derived") ("text" "Every admitted schema MUST declare and use exactly JSON Schema Draft 2020-12 and recognize only its recorded supported vocabulary, refusing every unsupported keyword rather than silently ignoring, translating, or accepting it."))
     (map ("id" "JSS-R003") ("kind" "derived") ("text" "Schema creation MUST be deterministic and pure: equivalent JSON-shaped creation inputs produce canonical key-sorted JSON bytes without filesystem, network, clock, random, package-registry, or mutation effects."))
     (map ("id" "JSS-R004") ("kind" "derived") ("text" "Reference resolution MUST use only an explicit finite corpus of $id-addressed documents and RFC 6901 JSON Pointers, refusing missing, ambiguous, cyclic, noncanonical, network, filesystem, package, or ambient references."))
     (map ("id" "JSS-R005") ("kind" "stakeholder") ("text" "Validation MUST return an explicit valid or invalid verdict with bounded diagnostics as a non-monotone judgment and is never claimed as a decidable projection read, monotone closure, or proof-path classification."))
     (map ("id" "JSS-R006") ("kind" "derived") ("text" "The service MUST preserve EAVT identity, schema $id identity, filepath identity, canonical JSON digest identity, and RMN ni identity as distinct named coordinates, refusing any request or result that conflates, substitutes, or globally rewrites them."))
     (map ("id" "JSS-R007") ("kind" "derived") ("text" "A recovery census MUST classify each discovered schema artifact by role and generation and give every legacy artifact exactly one disposition of retain-as-evidence, retain-as-compatibility-input, supersede-with-explicit-migration, or out-of-scope. Physical retirement is admitted only after explicit consumer migration and executable-address closure; Git history preserves the retired implementation as evidence."))
     (map ("id" "JSS-R008") ("kind" "stakeholder") ("text" "The cell MUST make no claim of chain settlement, custody, global $id administration, or authority to delete or mutate schemas, references, files, EAVT facts, digests, or RMN instances.")))))
