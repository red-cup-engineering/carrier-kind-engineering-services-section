#lang rmn/v2
(map
  ("type" "JsonSchemaServiceLowLevelDesign")
  ("version" 1)
  ("high-level-design" "content/designs/json-schema-service/high-level-design.rml")
  ("unit" "services/json-schema-service/src/index.mts")
  ("algorithm"
    ("Require the declared Draft 2020-12 dialect and recursively reject a keyword outside the fixed supported vocabulary."
     "Canonicalize creation input through the JSON codec's finite key-sorted JSON form without mutating it."
     "Index the supplied finite corpus by explicit $id; reject duplicate or noncanonical identifiers."
     "Resolve a $ref only to that index and an RFC 6901 fragment; detect cycles and reject absent or external targets."
     "Evaluate the supported vocabulary and emit a valid or invalid verdict with bounded instance and schema locations."
     "Inspect schema authoring invariants without filesystem effects; node-local writers supply only their explicit finite pool identifier set and retain seating and retraction authority."
     "Unfold schemas to exact pointer-cell EAVT assertions and fold, parse, serialize, merge, cohere, and project those assertions deterministically while keeping assertion identity coordinate-explicit."
     "Carry EAVT, $id, filepath, digest, and RMN ni as separately labelled fields; never derive one by rewriting another."
     "Classify census entries by role and generation; record a disposition before retired implementation files and their executable addresses are removed, and perform no global rewrite, custody, or chain action."))
  ("refusal-order" ("invalid-request" "dialect-drift" "unsupported-keyword" "invalid-json" "identity-conflation" "invalid-corpus" "unresolved-reference" "cyclic-reference" "external-reference" "forbidden-authority")))
