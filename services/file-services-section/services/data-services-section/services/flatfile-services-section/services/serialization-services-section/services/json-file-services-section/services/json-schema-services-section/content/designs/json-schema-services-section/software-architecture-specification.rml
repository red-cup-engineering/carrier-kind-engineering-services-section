  ("type" "JsonSchemaServiceSoftwareArchitectureSpecification")
  ("version" 1)
  ("identification" (map ("system" "JSON Schema creation, resolution, and validation service") ("revision" "1") ("date" "2026-07-29") ("issuer" "JSON File Services Section") ("requirements" "content/designs/json-schema-service/requirements-baseline.rml")))
  ("operation" "Keep one pure schema-semantic cell below JSON serialization: creation selects canonical schema bytes; resolver and validator share exactly one fixed dialect and bounded corpus.")
  ("modules"
