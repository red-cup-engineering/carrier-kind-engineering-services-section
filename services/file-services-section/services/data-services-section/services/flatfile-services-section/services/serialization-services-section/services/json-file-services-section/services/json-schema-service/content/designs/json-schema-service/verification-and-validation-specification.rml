#lang rmn/v2
(map
  ("type" "JsonSchemaServiceVerificationAndValidationSpecification")
  ("version" 1)
  ("requirements" "content/designs/json-schema-service/requirements-baseline.rml")
  ("cases"
    ((map ("id" "JSS-C001") ("verifies" "JSS-R001") ("kind" "inspection") ("measure" "The parent owns exactly the codec and combined schema-semantic service; node-local writers import its inspection and reader faces while retaining only filesystem authority, and the old reading package addresses are absent."))
     (map ("id" "JSS-C002") ("verifies" "JSS-R002") ("kind" "test") ("measure" "Only declared Draft 2020-12 and every enumerated supported keyword admit; each unsupported keyword refuses."))
     (map ("id" "JSS-C003") ("verifies" "JSS-R003") ("kind" "test") ("measure" "Permuted equivalent inputs produce byte-identical canonical JSON with no observable effect or mutation."))
     (map ("id" "JSS-C004") ("verifies" "JSS-R004") ("kind" "test") ("measure" "Local $id and pointer resolution succeeds; missing, duplicate, cyclic, network, filesystem, package, and ambient references refuse."))
     (map ("id" "JSS-C005") ("verifies" "JSS-R005") ("kind" "test") ("measure" "Valid and invalid inputs return distinct verdicts and bounded diagnostics; no projector read or monotonicity claim is exposed."))
     (map ("id" "JSS-C006") ("verifies" "JSS-R006") ("kind" "test") ("measure" "EAVT, $id, filepath, digest, and RMN ni remain labelled-distinct; substitution and global rewrite requests refuse."))
     (map ("id" "JSS-C007") ("verifies" "JSS-R007") ("kind" "test") ("measure" "Every supplied artifact receives a role and generation; every legacy artifact receives exactly one allowed disposition, while superseded implementations have no surviving consumer or executable address."))
     (map ("id" "JSS-C008") ("verifies" "JSS-R008") ("kind" "inspection") ("measure" "The capability has no settlement, custody, deletion, global identifier, or mutation operation."))))
  ("coverage" "Every JSS-R001 through JSS-R008 requirement has exactly one registered case and one trace entry; specification-law enforces exact ordered coverage."))
