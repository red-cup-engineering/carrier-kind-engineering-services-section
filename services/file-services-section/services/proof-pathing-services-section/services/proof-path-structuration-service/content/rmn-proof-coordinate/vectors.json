{
  "profile": "org.harmonious-union.rmn-proof-coordinate.v1",
  "description": "Language-neutral admission vectors for bounded RMN proof-coordinate settlement. Hashes and paths are deliberately absent: implementations derive transport and projections from the settled coordinate.",
  "cases": [
    {
      "id": "RMN-V001",
      "kind": "settlement",
      "input": {
        "resourceType": "semiotic-atom",
        "root": "category",
        "target": "room",
        "witnesses": [
          { "domain": "paracosm", "generator": "specialization", "codomain": "room" },
          { "domain": "category", "generator": "specialization", "codomain": "paracosm" }
        ]
      },
      "expect": { "ok": true, "stepGenerators": ["specialization", "specialization"], "witnessCount": 2 }
    },
    {
      "id": "RMN-V002",
      "kind": "settlement",
      "input": {
        "resourceType": "relation-projection",
        "root": "root",
        "target": "target",
        "witnesses": [
          { "domain": "middle", "generator": "object-projection", "codomain": "target" },
          { "domain": "root", "generator": "converse", "codomain": "middle" }
        ]
      },
      "expect": { "ok": true, "stepGenerators": ["converse", "object-projection"], "witnessCount": 2 }
    },
    {
      "id": "RMN-R001",
      "kind": "settlement",
      "input": { "resourceType": "", "root": "root", "target": "target", "witnesses": [] },
      "expect": { "ok": false, "reason": "invalid-resource-type" }
    },
    {
      "id": "RMN-R002",
      "kind": "settlement",
      "input": { "resourceType": "semiotic-atom", "root": "root", "target": "target", "witnesses": [] },
      "expect": { "ok": false, "reason": "unearned-coordinate" }
    },
    {
      "id": "RMN-R003",
      "kind": "settlement",
      "input": {
        "resourceType": "semiotic-atom",
        "root": "root",
        "target": "target",
        "witnesses": [{ "domain": "root", "generator": "not-a-generator", "codomain": "target" }]
      },
      "expect": { "ok": false, "reason": "invalid-witness" }
    }
  ]
}
