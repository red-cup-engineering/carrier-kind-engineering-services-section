(map
  ("type" "ProofPathAddressingHighLevelDesign")
  ("version" 1)
  ("architecture" "content/designs/proof-path-addressing/software-architecture-specification.rml")
  ("unit" "services/proof-path-structuration-service")
  ("components"
    ((map ("id" "term-codec") ("responsibility" "Admit finite JSON terms; derive stable keys and reversible POSIX segments."))
