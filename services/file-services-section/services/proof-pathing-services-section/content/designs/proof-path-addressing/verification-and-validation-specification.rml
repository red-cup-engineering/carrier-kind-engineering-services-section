#lang rmn/v2
(map
  ("type" "ProofPathAddressingVerificationAndValidationSpecification")
  ("version" 1)
  ("requirements" "content/designs/proof-path-addressing/requirements-baseline.rml")
  ("cases"
    ((map ("id" "PPA-C001") ("verifies" "PPA-R001") ("kind" "test") ("measure" "Success and refusal preserve strict reference identity of the supplied atom; zero or two evidence carriers refuse."))
     (map ("id" "PPA-C002") ("verifies" "PPA-R002") ("kind" "test") ("measure" "Object key order has one term key; undefined, non-finite, cyclic, and non-plain values refuse."))
     (map ("id" "PPA-C003") ("verifies" "PPA-R003") ("kind" "test") ("measure" "A witnessed specialization chain returns the exact relative AST shape and safe segments."))
     (map ("id" "PPA-C004") ("verifies" "PPA-R004") ("kind" "test") ("measure" "All four generator kinds can be checked and a changed generator is rejected."))
     (map ("id" "PPA-C005") ("verifies" "PPA-R005") ("kind" "test") ("measure" "Permuted evidence with competing equal-length routes renders byte-identically."))
     (map ("id" "PPA-C006") ("verifies" "PPA-R006") ("kind" "test") ("measure" "Canonical paths round-trip; absolute, traversal, malformed, bad escape, and noncanonical paths refuse."))
     (map ("id" "PPA-C007") ("verifies" "PPA-R007") ("kind" "test") ("measure" "An unreachable atom returns unearned-path with no AST or rendered path."))
     (map ("id" "PPA-C008") ("verifies" "PPA-R008") ("kind" "inspection") ("measure" "The package has no runtime dependencies or filesystem/source-analysis imports and exposes only pure operations."))
     (map ("id" "PPA-C009") ("verifies" "PPA-R009") ("kind" "executable check") ("measure" "The section law requires the exact five formal-frontier markers and the architecture carries PPA-INC-001."))))
  ("coverage" "Every PPA-R001 through PPA-R009 requirement has exactly one registered case; the executable law checks exact coverage. Formal theorem completion is intentionally outside this V&V scope."))
